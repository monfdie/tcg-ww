<% if (mode === 'remove-confirm') { %>
<section class="bet-card bet-confirmation"><h2>Confirm point removal</h2><%- include('betting-person', { person: selected }) %><dl class="bet-summary"><dt>Available balance</dt><dd><%= removal.balance %> ◆</dd><dt>Remove</dt><dd>−<%= removal.amount %> ◆</dd><dt>Balance after</dt><dd><strong><%= removal.balance - removal.amount %> ◆</strong></dd><dt>Reason</dt><dd><%= removal.reason %></dd></dl><form method="post" action="/bets/admin/remove"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="token" value="<%= removal.token %>"><label class="bet-check"><input type="checkbox" name="confirmed" value="1" required> Confirm player and amount</label><div class="bet-actions"><button class="bet-danger">Remove points</button><a href="/bets/admin/points?player=<%= selected._id %>">Cancel</a></div></form></section>
<% } %>
<% if (mode === 'delete-confirm') { %>
<section class="bet-card bet-confirmation"><h2>Delete from history?</h2><h3><%= deletion.title %></h3><p><%= deletion.detail %></p><p class="bet-muted">This removes the entry from history. Balances, payouts and transaction records are preserved.</p><form method="post" action="<%= deletion.action %>"><input type="hidden" name="csrf" value="<%= csrf %>"><label class="bet-check"><input type="checkbox" name="confirmed" value="1" required> Confirm deletion</label><div class="bet-actions"><button class="bet-danger">Delete from history</button><a href="<%= deletion.back %>">Cancel</a></div></form></section>
<% } %>
<% if (mode === 'participants' && isAdmin) { const summary = stats[String(event._id)] || { count: 0, amount: 0, sides: [0,0] }; %>
<div class="bet-heading"><h2><%= event.title %> · All bets</h2><a class="bet-button" href="/bets/event/<%= event._id %>">Manage event</a></div><div class="bet-card"><div class="bet-actions"><strong><%= summary.count %> bets · <%= summary.amount %> ◆ total</strong><% for (let i=0;i<2;i++) { %><span><%= event.sides[i] %>: <strong><%= summary.sides[i] %> ◆</strong> (<%= summary.amount ? (summary.sides[i] / summary.amount * 100).toFixed(1) : '0' %>%)</span><% } %></div><p class="bet-muted">Admin only. Includes bets removed from personal history.</p></div>
<div class="bet-table-wrap"><table><thead><tr><th>Player</th><th>Date · UTC+3</th><th>Pick</th><th>Stake</th><th>Odds</th><th>Status</th><th>Payout</th></tr></thead><tbody><% for (const bet of bets) { %><tr><td><%- include('betting-person', { person: bet.user }) %><% if (bet.historyDeleted) { %><small>Removed from personal history</small><% } %></td><td><%= dateText(bet.createdAt) %></td><td><%= event.sides[bet.side] %></td><td><%= bet.amount %> ◆</td><td>×<%= oddsText(bet.odds) %></td><td><%= labels[bet.status] %></td><td><%= bet.status === 'pending' ? '—' : bet.payout %></td></tr><% } %><% if (!bets.length) { %><tr><td colspan="7">No bets</td></tr><% } %></tbody></table></div>
<nav class="bet-nav"><% if (page > 1) { %><a href="?page=<%= page-1 %>">← Previous</a><% } %><% if (more) { %><a href="?page=<%= page+1 %>">Next →</a><% } %></nav><% } %>
