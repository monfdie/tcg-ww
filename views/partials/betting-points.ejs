<div class="bet-grid bet-points-layout">
<section class="bet-card"><h2>Find player</h2>
<form class="bet-form" method="get" action="/bets/admin/points"><label>Nickname or Discord ID<input type="search" name="q" value="<%= query %>" maxlength="100" placeholder="Enter a nickname" required></label><button>Search</button></form>
<% if (query) { %><p class="bet-muted">Up to 20 matches. Refine your search if needed.</p><div class="bet-player-results"><% for (const player of players) { %><a class="bet-player-result" href="/bets/admin/points?q=<%= encodeURIComponent(query) %>&player=<%= player._id %>" <%- selected && String(selected._id) === String(player._id) ? 'aria-current="true"' : '' %>><%- include('betting-person', { person: player }) %><span><strong><%= player.balance.toLocaleString('en-US') %> ◆</strong><br><small>Select →</small></span></a><% } %><% if (!players.length) { %><p>No players found.</p><% } %></div><% } %>
</section>
<form class="bet-card bet-form" method="post" action="/bets/admin/settings"><h2>Point settings</h2><input type="hidden" name="csrf" value="<%= csrf %>"><label>Starting balance<input type="number" name="starting" min="0" step="1" value="<%= settings.starting %>" required></label><label>Weekly bonus<input type="number" name="weekly" min="0" step="1" value="<%= settings.weekly %>" required></label><button>Save settings</button></form>
</div>
<% if (selected) { %><section class="bet-card"><h2>Selected player</h2><div class="bet-actions"><%- include('betting-person', { person: selected }) %><span>Available: <strong><%= selected.balance %> ◆</strong> · In bets: <%= selected.pending %> ◆</span></div></section><div class="bet-grid">
<% for (const [action,name] of [['grant','Add points'],['remove','Remove points']]) { %><form class="bet-card bet-form" method="post" action="/bets/admin/<%= action === 'remove' ? 'remove/preview' : action %>"><h2><%= name %></h2><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="request" value="<%= uuid() %>"><input type="hidden" name="discordId" value="<%= selected.discordId %>"><label>Amount<input type="number" name="amount" min="1" step="1" <%- action === 'remove' ? 'max="' + selected.balance + '"' : '' %> required></label><label>Reason<textarea name="reason" minlength="3" maxlength="500" required></textarea></label><button <%= action === 'remove' && selected.balance < 1 ? 'disabled' : '' %>><%= action === 'remove' ? 'Review deduction' : name %></button></form><% } %></div><% } else { %><p class="bet-muted">Select a player to add or remove points.</p><% } %>