<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title || 'GITCG' %></title>
    
    <link rel="icon" type="image/png" href="/logo.png">

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Segoe+UI&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <meta name="referrer" content="no-referrer">
</head>
<body>

<div class="app-container">
    
    <% if (!locals.hideSidebar) { %>
    <aside class="sidebar">
        <div class="sidebar-brand">GITCG</div>
        
        <div class="sidebar-links">
            <a href="/" class="<%= locals.path === '/' ? 'active' : '' %>">HOME</a>
            <a href="/create" class="<%= locals.path === '/create' ? 'active' : '' %>">Create Game</a>
            <a href="/tournaments" class="<%= locals.path === '/tournaments' ? 'active' : '' %>">Tournaments</a>
            
            <a href="/leaderboard" class="<%= locals.path === '/leaderboard' ? 'active' : '' %>">Leaderboard</a>
            
            <a href="/history" class="<%= locals.path === '/history' ? 'active' : '' %>">History</a>
            <a href="/profile" class="<%= locals.path === '/profile' ? 'active' : '' %>">Profile</a>
            
            <% if (locals.isAdmin) { %>
                <div style="margin: 15px 15px 5px 15px; border-top: 1px solid #2a3454;"></div>
                
                <a href="/admin/dashboard" class="<%= locals.path && locals.path.startsWith('/admin') ? 'active' : '' %>" style="color: #4facfe; border-color: rgba(79, 172, 254, 0.3);">
                    ADMIN PANEL
                </a>
                
                <a href="/promo.html" style="color: #b28dff; border-color: rgba(178, 141, 255, 0.3);">
                    PROMO MAKER
                </a>

                <a href="/bracket.html" style="color: #d4af37; border-color: rgba(212, 175, 55, 0.3);">
                    BRACKET MAKER
                </a>
            <% } %>
        </div>
        
        <div class="sidebar-user">
            <% if (locals.user) { %>
                <div class="user-profile">
                    <% if (locals.user.avatar) { %>
                        <img src="https://cdn.discordapp.com/avatars/<%= locals.user.discordId %>/<%= locals.user.avatar %>.png" alt="Avatar">
                    <% } else { %>
                        <img src="https://cdn.discordapp.com/embed/avatars/0.png" alt="Avatar">
                    <% } %>
                    <div class="user-info">
                        <span class="user-name"><%= locals.user.username %></span>
                        <a href="/logout" class="logout-link">Logout</a>
                    </div>
                </div>
            <% } else { %>
                <a href="/auth/discord" class="login-btn">Discord Login</a>
            <% } %>
        </div>
    </aside>
    <% } %>

    <main class="main-content">
        <div class="page-container">
