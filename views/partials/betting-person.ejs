<span class="bet-person"><img alt="" loading="lazy" src="<%= person && person.avatar ? 'https://cdn.discordapp.com/avatars/' + encodeURIComponent(person.discordId) + '/' + encodeURIComponent(person.avatar) + '.png' : 'https://cdn.discordapp.com/embed/avatars/0.png' %>"><span><strong><%= person ? person.username : 'Deleted player' %></strong><br><small><%= person ? person.discordId : '' %></small></span></span>