<script src="/socket.io/socket.io.js"></script>
<script src="/draft-rules.js"></script>

<script>
    const socket = io({ transports: ['websocket'] });
    const currentRoom = '<%= roomId %>';
    const myUserId = sessionStorage.getItem('draft_user_id') || Math.random().toString(36).substring(2);
    sessionStorage.setItem('draft_user_id', myUserId);
    
    let myRole = '', currentDraftType = 'gitcg', isGameStarted = false;
    let charsData = {}, selectedCharId = null, isDraftFinishedLocal = false;
    
    // ... (инициализация переменных и сокеты остаются прежними) ...

    function updateUI(state) {
        isGameStarted = state.gameStarted;
        isDraftFinishedLocal = state.draftFinished;
        const isMyTurn = (myRole === state.currentTeam);

        // ... (логика таймеров и кнопок остается прежней) ...

        // ЛОГИКА ОБНОВЛЕНИЯ ЛЕСЕНКИ
        document.querySelectorAll('.ladder-step').forEach((el, idx) => {
            el.classList.remove('step-active', 'step-done');
            const stepNum = idx + 1;
            if (stepNum < state.stepIndex) {
                el.classList.add('step-done');
            } else if (stepNum === state.stepIndex && !state.draftFinished) {
                el.classList.add('step-active');
                // Автоматический скролл к текущему шагу
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });

        document.getElementById('blue-name-display').innerText = state.blueName;
        document.getElementById('red-name-display').innerText = state.redName;
        // ... (остальное обновление UI: аватары, статусы, слоты) ...
    }

    function renderRows() {
        const container = document.getElementById('char-pool-container');
        container.innerHTML = '';
        
        // Создаем контейнер лесенки
        const ladder = document.createElement('div'); 
        ladder.className = 'ladder-container'; 
        container.appendChild(ladder);

        // ГЕНЕРАЦИЯ ШАГОВ ЛЕСЕНКИ
        const schema = DRAFT_RULES[currentDraftType];
        if (schema) {
            schema.forEach((step, idx) => {
                const item = document.createElement('div');
                const isBlue = step.team === 'blue';
                item.className = `ladder-step ${isBlue ? 'step-left' : 'step-right'} step-${step.type}`;
                if (step.immunity) item.classList.add('step-immunity');
                
                item.id = `ladder-step-${idx + 1}`;
                // Форматируем текст: "BAN BLUE", "PICK RED" и т.д.
                item.innerText = `${step.type.toUpperCase()} ${isBlue ? 'BLUE' : 'RED'}`;
                ladder.appendChild(item);
            });
        }

        ['cryo','hydro','pyro','electro','anemo','geo','dendro'].forEach(elem => {
            // ... (отрисовка персонажей остается прежней) ...
        });
    }

    // ... (остальные функции: createChar, confirmSelection и т.д.) ...
</script>

