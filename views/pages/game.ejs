<%- include('../partials/header') %>
<link rel="stylesheet" href="/draft-notices.css">

<style>
    body, html { background: linear-gradient(rgba(10, 12, 20, 0.85), rgba(10, 12, 20, 0.85)), url('/bg.jpg') !important; background-size: cover !important; background-position: center !important; background-repeat: no-repeat !important; background-attachment: fixed !important; min-height: 100vh; }
    .page-container, #game-screen, .char-pool { background: transparent !important; }
    .page-container { padding: 0 !important; max-width: 100% !important; height: 100%; display: flex; flex-direction: column; }
    .player-header { height: auto !important; min-height: 70px; }
    .player-info-wrapper { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
    .player-avatar { width: 54px; height: 54px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 12px rgba(0,0,0,0.6); display: none; }
    
    .seat-btn { border: none; padding: 6px 12px; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 10px; margin-top: 5px; text-transform: uppercase; transition: 0.2s; font-family: 'Segoe UI', sans-serif; letter-spacing: 1px; }
    .join-seat { background: #4facfe; color: #000; box-shadow: 0 0 10px rgba(79,172,254,0.3); }
    .join-seat:hover { background: #fff; box-shadow: 0 0 15px #4facfe; }
    .red-side .join-seat { background: #ff6b6b; box-shadow: 0 0 10px rgba(255,107,107,0.3); }
    .red-side .join-seat:hover { background: #fff; box-shadow: 0 0 15px #ff6b6b; }
    .leave-seat { background: transparent; border: 1px solid #ff6b6b; color: #ff6b6b; }
    .leave-seat:hover { background: rgba(255, 107, 107, 0.2); }

    /* Опасити изменена на 0.35, чтобы боксы всегда были отчетливо видны */
    #char-pool-container .char-option.disabled { pointer-events: none !important; opacity: 0.35; filter: grayscale(100%); }
    #char-pool-container .char-option.immunity-highlight { border: 3px solid #d4af37 !important; box-shadow: 0 0 15px rgba(212, 175, 55, 0.8) !important; opacity: 1 !important; filter: none !important; }

    .turn-timer { transition: opacity 0.3s ease; }
    .game-header { position: relative; align-items: center; }
    .home-logo-link { z-index: 100; text-decoration: none; display: flex; align-items: center; }
    .home-logo-link img { height: 38px; transition: 0.2s; filter: drop-shadow(0 0 5px rgba(255,255,255,0.2)); }
    .home-logo-link:hover img { transform: scale(1.1); filter: drop-shadow(0 0 10px rgba(79, 172, 254, 0.6)); }
    @media (min-width: 769px) {
        .draft-area { display: flex; justify-content: center; gap: 60px; }
        .game-header { display: flex; justify-content: center; }
        .home-logo-link { position: absolute; left: 20px; top: 50%; transform: translateY(-50%); }
        #room-container { position: absolute; right: 20px; left: auto; top: 50%; transform: translateY(-50%); margin: 0; z-index: 100; }
    }
    #game-screen { position: relative; }
    .series-bar { position: absolute; z-index: 60; top: calc(6vh + 9px); right: 20px; width: 216px; box-sizing: border-box; flex-direction: column; align-items: stretch; gap: 0; padding: 8px; background: linear-gradient(145deg,rgba(33,41,59,.95),rgba(21,27,41,.96)); border: 1px solid rgba(199,213,246,.12); border-radius: 16px; box-shadow: 0 8px 24px rgba(0,0,0,.2); }
    #series-score { display: block; color: #e8edf6; font-family: 'Segoe UI', sans-serif; font-size: 12px; font-weight: 600; text-align: center; letter-spacing: 0; padding: 2px 0 7px; border-bottom: 1px solid rgba(199,213,246,.12); }
    .series-tabs { display: flex; justify-content: center; gap: 3px; margin-top: 6px; padding: 4px; border: 1px solid rgba(199,213,246,.12); border-radius: 12px; background: rgba(11,15,24,.45); }
    .series-tab { flex: 1; min-width: 0; margin: 0; padding: 5px 2px; background: transparent; border: 1px solid transparent; border-radius: 9px; color: #9aa6bb; font-family: 'Segoe UI', sans-serif; font-size: 10px; font-weight: 600; letter-spacing: 0; text-transform: none; white-space: nowrap; transition: background .18s, border-color .18s, color .18s; }
    .series-tab:hover { color: #f4f6fb; background: rgba(255,255,255,.05); }
    .series-tab.active { background: rgba(185,244,120,.10); border-color: rgba(185,244,120,.4); color: #b9f478; box-shadow: none; }
    .series-tab-short { display: none; }
    .series-bar.compact .series-tab-full { display: none; }
    .series-bar.compact .series-tab-short { display: inline; }
    .series-panel { display: none; position: absolute; z-index: 70; right: 20px; bottom: 20px; width: min(320px, calc(100% - 40px)); box-sizing: border-box; align-items: center; justify-content: center; gap: 7px; flex-wrap: wrap; padding: 11px; color: #f4f6fb; background: linear-gradient(145deg,rgba(33,41,59,.96),rgba(21,27,41,.97)); border: 1px solid rgba(199,213,246,.12); border-radius: 18px; box-shadow: 0 10px 28px rgba(0,0,0,.28); font-family: 'Segoe UI', sans-serif; font-size: 11px; }
    .series-panel.visible { display: flex; }
    .series-panel span:first-child { width: 100%; text-align: center; font-family: 'Segoe UI', sans-serif; font-weight: 600; color: #e8edf6; letter-spacing: 0; }
    .series-action, .winner-choice { margin: 0; padding: 8px 11px; min-height: 34px; border-radius: 11px; border: 1px solid rgba(199,213,246,.16); background: #252d3e; color: #e8edf6; font-family: 'Segoe UI', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0; text-transform: none; box-shadow: none; transition: background .18s, border-color .18s, transform .18s; }
    .series-action:hover, .winner-choice:hover { background: #344056; border-color: rgba(199,213,246,.3); transform: translateY(-1px); }
    .series-action:not(.active) { background: rgba(185,244,120,.10); border-color: rgba(185,244,120,.35); color: #b9f478; }
    .series-action.active { background: #252d3e; color: #9aa6bb; border-color: rgba(199,213,246,.16); }
    .winner-choice.active { background: rgba(185,244,120,.10); color: #b9f478; border-color: rgba(185,244,120,.4); box-shadow: none; }
    .winner-choice:disabled { cursor: default; opacity: .7; }
    .series-panel span:last-child:not(:first-child) { color: #9aa6bb; text-align: center; }
    .series-tab:focus-visible, .series-action:focus-visible, .winner-choice:focus-visible { outline: 2px solid #b9f478; outline-offset: 2px; }
    .draft-area { transition: opacity .22s ease, transform .22s ease; }
    .draft-area.switching { opacity: 0; transform: translateX(16px); }
    @media (max-width: 768px) {
        .series-bar { position: static; width: calc(100% - 12px); margin: 6px auto 0; padding: 5px 7px; flex-direction: row; align-items: center; gap: 6px; flex-shrink: 0; border-radius: 12px; box-shadow: none; }
        #series-score { flex: 0 0 auto; font-size: 10px; padding: 0 7px 0 0; border-bottom: 0; border-right: 1px solid rgba(199,213,246,.12); white-space: nowrap; }
        .series-tabs { flex: 1; min-width: 0; gap: 2px; margin: 0; padding: 0; border: 0; background: transparent; }
        .series-tab { font-size: 9px; padding: 5px 1px; }
        .series-tab-full { display: none; }
        .series-tab-short { display: inline; }
        .series-panel { position: static; width: calc(100% - 16px); margin: 4px auto 8px; flex-shrink: 0; box-shadow: none; }
    }
    @media (prefers-reduced-motion: reduce) { .draft-area, .series-tab { transition: none; } }

</style>

<div id="game-screen">
    <div class="game-header">
         <a href="/" class="home-logo-link" title="Back to Home"><img src="/logo.png" alt="GITCG Logo"></a>
         <div class="reserve-timer blue-res"><span id="blue-res">3:00</span></div>
         <div id="status">Waiting...</div>
         <div class="reserve-timer red-res"><span id="red-res">3:00</span></div>
         <div id="room-container">
             <div id="room-display" onclick="copyRoomCode()">CODE: <%= roomId %></div>
         </div>
    </div>

    <div class="series-bar" id="series-bar" style="display:none;">
        <span id="series-score"></span>
        <div class="series-tabs" id="series-tabs"></div>
    </div>

     <div class="draft-area">
         <div id="global-bans-display" class="global-bans-display" style="display:none;">
             <div class="im-label">GLOBAL BANS</div>
             <div class="global-bans-sides">
                 <div class="im-row" id="global-blue-bans"></div>
                 <div class="im-row" id="global-red-bans"></div>
             </div>
         </div>
         <div id="immunity-top-display" class="immunity-top-container" style="display: none;">
             <div class="im-label">IMMUNE</div>
             <div class="im-row" id="immunity-icons-row"></div>
         </div>
         <div class="team-side blue-side">
             <div class="player-header">
                 <div id="blue-timer" class="turn-timer">45</div>
                 <div class="player-info-wrapper">
                     <img id="blue-avatar" class="player-avatar" src="" alt="">
                     <h2 id="blue-name-display">PLAYER 1</h2>
                     <button id="join-blue-btn" class="seat-btn join-seat" onclick="takeSeat('blue')" style="display:none;">SIT HERE</button>
                     <button id="leave-blue-btn" class="seat-btn leave-seat" onclick="leaveSeat()" style="display:none;">LEAVE</button>
                 </div>
                 <div id="blue-ready-switch" class="ready-switch" onclick="toggleReady('blue')">
                     <div class="switch-circle"></div>
                 </div>
             </div>
             <div class="ban-row" id="blue-bans"></div>
             <div class="pick-row" id="blue-picks-1"></div>
             <div class="pick-row-small" id="blue-picks-2"></div>
         </div>
         
         <div class="team-side red-side">
             <div class="player-header">
                 <div id="red-ready-switch" class="ready-switch" onclick="toggleReady('red')">
                     <div class="switch-circle"></div>
                 </div>
                 <div class="player-info-wrapper">
                     <img id="red-avatar" class="player-avatar" src="" alt="">
                     <h2 id="red-name-display">PLAYER 2</h2>
                     <button id="join-red-btn" class="seat-btn join-seat" onclick="takeSeat('red')" style="display:none;">SIT HERE</button>
                     <button id="leave-red-btn" class="seat-btn leave-seat" onclick="leaveSeat()" style="display:none;">LEAVE</button>
                 </div>
                 <div id="red-timer" class="turn-timer">45</div>
             </div>
             <div class="ban-row" id="red-bans"></div>
             <div class="pick-row" id="red-picks-1"></div>
             <div class="pick-row-small" id="red-picks-2"></div>
         </div>
     </div>

     <div class="controls-area" style="min-height: 40px;">
         <button id="skip-btn" class="round-btn" onclick="skipTurn()" style="display: none;">SKIP</button>
         <button id="confirm-btn" class="confirm-btn round-btn" onclick="confirmSelection()" disabled style="display: none;">SELECT</button>
     </div>
     <div class="series-panel" id="result-panel"></div>
     <div class="series-panel" id="next-panel"></div>

     <div class="char-pool" id="char-pool-container"></div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/draft-rules.js"></script>
<script src="/player-avatar.js"></script>
<script src="/draft-notices.js"></script>

<script>
    const socket = io({ transports: ['websocket'] });
    const currentRoom = '<%= roomId %>';
    
    let myRole = '', currentDraftType = 'gitcg', isGameStarted = false;
    let charsData = {}, selectedCharId = null, currentState = null;
    let isDraftFinishedLocal = false;
    let latestState = null, viewedGame = 1, isReview = false, savedStates = [];
    let lastFinishedNotice = 0, seriesNoticeShown = false;
    
    const myNick = <%- locals.user ? JSON.stringify(locals.user.username) : '""' %>;
    const localNick = sessionStorage.getItem('draft_nickname') || 'Player';
    const finalNick = myNick || localNick;

    const savedData = <%- JSON.stringify(locals.savedData || null) %>;
    const savedSeries = <%- JSON.stringify(locals.savedSeries || []) %>;
    const serverChars = <%- JSON.stringify(locals.chars || null) %>;

    function applyDefaultTimers(draftType) {
        const isMoba = (draftType === 'moba_3phase' || draftType === 'global_ban_sys');
        const defaultTurn = isMoba ? '30' : '45';
        const defaultBank = isMoba ? '2:10' : '3:00';
        
        document.getElementById('blue-timer').innerText = defaultTurn;
        document.getElementById('red-timer').innerText = defaultTurn;
        document.getElementById('blue-res').innerText = defaultBank;
        document.getElementById('red-res').innerText = defaultBank;
    }

    if (savedData) {
        socket.disconnect(); charsData = serverChars;
        // Archived drafts use their original pick/ban sequence.
        const mockState = {
            gameStarted: true, currentTeam: 'none', currentAction: 'none',
            bans: savedData.bans, bluePicks: savedData.bluePicks, redPicks: savedData.redPicks,
            blueName: savedData.blueName, redName: savedData.redName,
            blueDiscordId: savedData.blueDiscordId, redDiscordId: savedData.redDiscordId,
            blueAvatar: savedData.blueAvatar, redAvatar: savedData.redAvatar,
            draftType: savedData.draftType === 'abyss_box' ? 'gitcg_cup_2' : (savedData.draftType === 'chaos' ? 'classic' : (savedData.draftType || 'gitcg')), immunityPhaseActive: false,
            immunityPool: savedData.immunityPool||[], immunityBans: savedData.immunityBans||[],
            globalBans: savedData.globalBans || { blue: [], red: [] },
            stepIndex: 999, ready: { blue: true, red: true },
            draftFinished: true, isBlueTaken: true, isRedTaken: true
        };
        savedStates = savedSeries.map((match, index) => ({
            ...mockState, ...match, gameNumber: match.gameNumber || index + 1,
            draftType: match.draftType === 'abyss_box' ? 'gitcg_cup_2' :
                match.draftType === 'chaos' ? 'classic' : (match.draftType || 'gitcg'),
            bestOf: match.bestOf || 1, draftFinished: true, gameStarted: true,
            stepIndex: 999, isBlueTaken: true, isRedTaken: true,
            ready: { blue: true, red: true }
        }));
        currentDraftType = mockState.draftType;
        applyDefaultTimers(currentDraftType);
        renderRows(mockState);
        viewedGame = savedStates.some(game => game.gameNumber === <%= locals.initialGame || 1 %>)
            ? <%= locals.initialGame || 1 %> : (savedStates[0]?.gameNumber || 1);
        updateUI(savedStates.find(game => game.gameNumber === viewedGame) || mockState);
    } else {
        socket.on('connect', () => {
            if (currentRoom) {
                socket.emit('rejoin_game', { roomId: currentRoom });
            }
        });
        
        socket.on('init_game', (data) => {
            myRole = data.role; charsData = data.chars; currentDraftType = data.state.draftType || 'gitcg';
            applyDefaultTimers(currentDraftType);
            document.getElementById('room-display').innerText = `CODE: ${currentRoom}` + (myRole === 'spectator' ? " (SPEC)" : "");
            viewedGame = data.state.gameNumber || 1;
            renderRows(data.state); updateUI(data.state);
        });

        socket.on('role_update', (newRole) => {
            myRole = newRole;
            document.getElementById('room-display').innerText = `CODE: ${currentRoom}` + (myRole === 'spectator' ? " (SPEC)" : "");
            if (latestState) updateUI(latestState);
        });

        socket.on('update_state', updateUI);
        socket.on('game_started', () => { isGameStarted = true; });
        socket.on('game_over', (state) => {
            updateUI(state);
            if (state.gameNumber !== lastFinishedNotice) {
                lastFinishedNotice = state.gameNumber;
                showDraftNotice(myRole === 'spectator' ? 'Draft complete.' : 'Draft complete. Confirm the winner below.', 'success');
            }
        });
        socket.on('series_game_changed', () => {
            if (viewedGame === latestState?.gameNumber) viewedGame++;
            selectedCharId = null;
            document.getElementById('confirm-btn').disabled = true;
            showDraftNotice('Next game is ready. Both players can start the draft.', 'info');
        });
        socket.on('error_msg', (msg) => { showDraftNotice(msg, 'error'); });
        socket.on('connect_error', (error) => { showDraftNotice(error.message, 'error'); });
        
        socket.on('timer_tick', (data) => {
            const t = typeof data === 'object' ? data.main : data;
            if (viewedGame !== latestState?.gameNumber) return;
            document.getElementById('blue-timer').innerText = t; 
            document.getElementById('red-timer').innerText = t;
            if(typeof data === 'object') {
                 document.getElementById('blue-res').innerText = formatTime(data.blueReserve);
                 document.getElementById('red-res').innerText = formatTime(data.redReserve);
            }
        });
    }

    function renderSeries(state) {
        const seriesBar = document.getElementById('series-bar');
        const tabs = document.getElementById('series-tabs');
        const max = savedData ? savedStates.length : state.gameNumber;
        seriesBar.style.display = state.bestOf > 1 ? 'flex' : 'none';
        seriesBar.classList.toggle('compact', state.bestOf >= 5);
        tabs.replaceChildren();
        for (let n = 1; n <= max; n++) {
            const button = document.createElement('button');
            button.className = `series-tab${viewedGame === n ? ' active' : ''}`;
            const fullLabel = document.createElement('span');
            fullLabel.className = 'series-tab-full';
            fullLabel.textContent = `GAME ${n}`;
            const shortLabel = document.createElement('span');
            shortLabel.className = 'series-tab-short';
            shortLabel.textContent = `G${n}`;
            button.setAttribute('aria-label', `Game ${n}`);
            button.append(fullLabel, shortLabel);
            button.onclick = () => switchSeriesGame(n);
            tabs.appendChild(button);
        }
        const score = state.score || { player1: 0, player2: 0 };
        document.getElementById('series-score').textContent = `BO${state.bestOf || 1} · ${score.player1 || 0} : ${score.player2 || 0}`;

        const resultPanel = document.getElementById('result-panel');
        const nextPanel = document.getElementById('next-panel');
        resultPanel.replaceChildren(); nextPanel.replaceChildren();
        resultPanel.classList.remove('visible'); nextPanel.classList.remove('visible');
        if (!savedData && viewedGame !== state.gameNumber) return;
        if (savedData || !state.draftFinished || state.confirmedWinner) {
            if (!savedData && state.confirmedWinner && !state.seriesFinished && (myRole === 'blue' || myRole === 'red')) {
                nextPanel.classList.add('visible');
                const button = document.createElement('button');
                button.className = `series-action${state.nextReady?.[myRole] ? ' active' : ''}`;
                button.textContent = state.nextReady?.[myRole] ? 'Cancel readiness' : 'Move to next game';
                button.onclick = () => socket.emit('next_game_ready', { roomId: currentRoom });
                nextPanel.appendChild(button);
                const note = document.createElement('span');
                note.textContent = `Ready: ${(state.nextReady?.blue ? 1 : 0) + (state.nextReady?.red ? 1 : 0)}/2`;
                nextPanel.appendChild(note);
            } else if (!savedData && state.seriesFinished) {
                nextPanel.classList.add('visible');
                nextPanel.textContent = 'SERIES FINISHED';
            }
            return;
        }
        resultPanel.classList.add('visible');
        const title = document.createElement('span');
        title.textContent = 'Confirm game winner:';
        resultPanel.appendChild(title);
        for (const side of ['blue', 'red']) {
            const button = document.createElement('button');
            button.className = `winner-choice${state.resultVotes?.[myRole] === side ? ' active' : ''}`;
            button.textContent = state[`${side}Name`];
            button.disabled = myRole !== 'blue' && myRole !== 'red';
            button.onclick = () => socket.emit('vote_result', { roomId: currentRoom, winner: side });
            resultPanel.appendChild(button);
        }
        const note = document.createElement('span');
        note.textContent = state.resultVotes?.blue && state.resultVotes?.red && state.resultVotes.blue !== state.resultVotes.red
            ? 'Players selected different winners. Change a vote to agree.'
            : `Confirmed: ${(state.resultVotes?.blue ? 1 : 0) + (state.resultVotes?.red ? 1 : 0)}/2`;
        resultPanel.appendChild(note);
    }

    function switchSeriesGame(gameNumber) {
        if (gameNumber === viewedGame) return;
        const state = savedData ? savedStates.find(game => game.gameNumber === gameNumber) :
            gameNumber === latestState.gameNumber ? latestState : latestState.games?.[gameNumber - 1];
        if (!state) return;
        const area = document.querySelector('.draft-area');
        area.classList.add('switching');
        setTimeout(() => {
            viewedGame = gameNumber;
            selectedCharId = null;
            document.getElementById('confirm-btn').disabled = true;
            document.querySelectorAll('.char-option').forEach(char => char.classList.remove('selected-pending'));
            renderDraftState(state);
            renderSeries(latestState);
            area.classList.remove('switching');
        }, 220);
    }

    function formatTime(s) { if (s < 0) s = 0; const m=Math.floor(s/60), sec=s%60; return `${m}:${sec<10?'0':''}${sec}`; }
    function toggleReady(r) { if(myRole===r && !isReview) socket.emit('player_ready', currentRoom); }
    function copyRoomCode() {
        if (!navigator.clipboard?.writeText) return showDraftNotice('Could not copy the room code.', 'error');
        navigator.clipboard.writeText(currentRoom)
            .then(() => showDraftNotice('Room code copied.', 'success'))
            .catch(() => showDraftNotice('Could not copy the room code.', 'error'));
    }
    function skipTurn() { if(currentRoom && !isReview && !isDraftFinishedLocal) socket.emit('skip_action', currentRoom); }
    function takeSeat(side) { socket.emit('take_seat', { roomId: currentRoom, side: side, nickname: finalNick }); }
    function leaveSeat() { socket.emit('leave_seat', { roomId: currentRoom }); }
    
    function updateUI(state) {
        latestState = state;
        if (!savedData && state.seriesFinished && !seriesNoticeShown) {
            seriesNoticeShown = true;
            showDraftNotice('Series complete. Results are saved.', 'success');
        }
        renderSeries(state);
        if (!savedData && viewedGame !== state.gameNumber) return;
        renderDraftState(state);
    }

    function renderDraftState(state) {
        isReview = !!savedData || viewedGame !== latestState?.gameNumber;
        currentState = state;
        isGameStarted = state.gameStarted;
        isDraftFinishedLocal = state.draftFinished;
        currentDraftType = state.draftType || currentDraftType;
        const isMyTurn = !isReview && (myRole === state.currentTeam);

        const blueJoinBtn = document.getElementById('join-blue-btn');
        const redJoinBtn = document.getElementById('join-red-btn');
        const blueLeaveBtn = document.getElementById('leave-blue-btn');
        const redLeaveBtn = document.getElementById('leave-red-btn');

        if (!isReview && !state.gameStarted && !state.draftFinished) {
            blueJoinBtn.style.display = (!state.isBlueTaken && myRole !== 'blue') ? 'block' : 'none';
            blueLeaveBtn.style.display = (myRole === 'blue') ? 'block' : 'none';
            redJoinBtn.style.display = (!state.isRedTaken && myRole !== 'red') ? 'block' : 'none';
            redLeaveBtn.style.display = (myRole === 'red') ? 'block' : 'none';
        } else {
            blueJoinBtn.style.display = 'none'; redJoinBtn.style.display = 'none';
            blueLeaveBtn.style.display = 'none'; redLeaveBtn.style.display = 'none';
        }

        document.getElementById('blue-timer').style.opacity = (!state.gameStarted || state.draftFinished || state.currentTeam !== 'blue') ? '0' : '1';
        document.getElementById('red-timer').style.opacity = (!state.gameStarted || state.draftFinished || state.currentTeam !== 'red') ? '0' : '1';

        document.querySelectorAll('.ladder-step').forEach((el, idx) => {
            el.classList.remove('step-active', 'step-done');
            if (idx < state.stepIndex - 1) el.classList.add('step-done');
            else if (idx === state.stepIndex - 1 && state.gameStarted && !state.draftFinished && !state.immunityPhaseActive) el.classList.add('step-active');
        });
        
        const confirmBtn = document.getElementById('confirm-btn');
        const skipBtn = document.getElementById('skip-btn');
        if (state.gameStarted && !state.draftFinished && !isReview && isMyTurn) {
            confirmBtn.style.display = 'inline-block';
            if (state.immunityPhaseActive) {
                skipBtn.style.display = 'inline-block';
                skipBtn.className = (state.currentTeam === 'blue') ? 'round-btn skip-left' : 'round-btn skip-right';
            } else skipBtn.style.display = 'none';
        } else {
            confirmBtn.style.display = 'none'; skipBtn.style.display = 'none';
        }

        document.getElementById('blue-ready-switch').style.display = (state.gameStarted || !state.isBlueTaken) ? 'none' : 'flex';
        document.getElementById('red-ready-switch').style.display = (state.gameStarted || !state.isRedTaken) ? 'none' : 'flex';
        
        if(!state.gameStarted) {
             state.ready.blue ? document.getElementById('blue-ready-switch').classList.add('ready-on') : document.getElementById('blue-ready-switch').classList.remove('ready-on');
             state.ready.red ? document.getElementById('red-ready-switch').classList.add('ready-on') : document.getElementById('red-ready-switch').classList.remove('ready-on');
        }

        document.getElementById('blue-name-display').innerText = state.blueName;
        document.getElementById('red-name-display').innerText = state.redName;
        
        renderPlayerAvatar(document.getElementById('blue-avatar'), {
            taken: state.isBlueTaken, discordId: state.blueDiscordId, avatar: state.blueAvatar
        });
        renderPlayerAvatar(document.getElementById('red-avatar'), {
            taken: state.isRedTaken, discordId: state.redDiscordId, avatar: state.redAvatar
        });
        
        let txt = "WAITING...";
        if (state.draftFinished) txt = "DRAFT FINISHED";
        else if (state.immunityPhaseActive) txt = `IMMUNITY: ${state.currentTeam} ${state.currentAction}`;
        else if (state.gameStarted) txt = `${state.currentTeam} IS ${state.currentAction==='ban'?'BANNING':'PICKING'}`;
        document.getElementById('status').innerText = txt.toUpperCase();

        updateImmunityTop(state);
        updateGlobalBansTop(state);
        renderSlots(state); // Обновленный рендер в старом дизайне
        
        // Логика блокировки персонажей для MOBA 3-Phase
        if (state.draftType === 'moba_3phase' || state.draftType === 'global_ban_sys') {
            const allBanned = [...(state.bans || []).map(b => b.id),
                ...(state.globalBans?.blue || []), ...(state.globalBans?.red || [])];
            const allPicked = [...(state.bluePicks || []), ...(state.redPicks || [])];
            document.querySelectorAll('.char-option').forEach(el => {
                el.classList.remove('disabled', 'immunity-highlight');
                if (state.draftFinished) { el.classList.add('disabled'); return; }
                if (!state.gameStarted) return;
                const charId = el.getAttribute('data-id');
                if (allBanned.includes(charId) || allPicked.includes(charId)) {
                    el.classList.add('disabled');
                }
            });
            return;
        }

        const immuneChars = state.immunityPool ? state.immunityPool.filter(id => id !== 'skipped') : [];
        const immunityBans = state.immunityBans ? state.immunityBans.filter(id => id !== 'skipped') : [];
        const isImmunePhase = state.immunityPhaseActive;
        const rulesType = currentDraftType;
        const currentStepData = (DRAFT_RULES[rulesType] && DRAFT_RULES[rulesType][state.stepIndex - 1]) ? DRAFT_RULES[rulesType][state.stepIndex - 1] : {};
        const isImmuneStep = currentStepData.immunity === true;
        const isPickPhase = state.currentAction && state.currentAction.includes('pick');

        document.querySelectorAll('.char-option').forEach(el => {
            el.classList.remove('disabled', 'immunity-highlight');
            if (state.draftFinished) { el.classList.add('disabled'); return; }
            if (!state.gameStarted) return; 

            const charId = el.getAttribute('data-id');
                if (isImmunePhase) {
                    if (immuneChars.includes(charId)) el.classList.add('immunity-highlight', 'disabled');
                    if (immunityBans.includes(charId)) el.classList.add('disabled');
                } else {
                    if (state.bans.some(b => b.id === charId)) el.classList.add('disabled');
                    if (isPickPhase && !isImmuneStep && immuneChars.includes(charId)) el.classList.add('disabled');
                    if (!isPickPhase && immuneChars.includes(charId)) el.classList.add('disabled');
                    
                    if (state.bluePicks.includes(charId)) {
                        if (myRole === 'blue') el.classList.add('disabled'); else if (!immuneChars.includes(charId)) el.classList.add('disabled');
                    }
                    if (state.redPicks.includes(charId)) {
                        if (myRole === 'red') el.classList.add('disabled'); else if (!immuneChars.includes(charId)) el.classList.add('disabled');
                    }
                }
        });
    }

    function renderRows(state) {
        const container = document.getElementById('char-pool-container');
        container.innerHTML = '';
        
        const ladder = document.createElement('div'); ladder.className = 'ladder-container';
        const rulesType = currentDraftType;
        const schema = DRAFT_RULES[rulesType];
        
        if(schema) {
            schema.forEach((step, i) => {
                const d = document.createElement('div');
                const sideClass = step.team === 'blue' ? 'step-left' : 'step-right';
                let colorClass = 'step-pick'; 
                if (step.type.includes('ban')) { colorClass = 'step-ban'; } else if (step.immunity) { colorClass = 'step-immunity'; }
                d.className = `ladder-step ${sideClass} ${colorClass}`;
                d.id = `step-node-${i}`; d.innerText = `${i+1}. ${step.type}`;
                ladder.appendChild(d);
            });
            container.appendChild(ladder);
        }

        ['cryo','hydro','pyro','electro','anemo','geo','dendro'].forEach(elem => {
            const row = document.createElement('div'); row.className = `element-row row-${elem}`;
            const chars = charsData[elem];
            if(!chars || chars.length === 0) return; 
            
            const l = document.createElement('div'); l.className = 'row-half left-half';
            const r = document.createElement('div'); r.className = 'row-half right-half';
            
            const mid = Math.ceil(chars.length/2);
            chars.slice(0,mid).forEach(c => l.appendChild(createChar(c, 'left')));
            chars.slice(mid).forEach(c => r.appendChild(createChar(c, 'right')));
     
            const gap = document.createElement('div'); gap.className = 'row-gap';
            row.appendChild(l); row.appendChild(gap); row.appendChild(r);
            container.appendChild(row);
        });
    }

    function createChar(char, side) {
        const el = document.createElement('div');
        el.className = 'char-option'; 
        el.id = `char-${side}-${char.id}`;
        el.setAttribute('data-id', char.id);
        el.innerHTML = `<img src="${char.img}">`;
        
        el.onclick = () => {
            if(!isGameStarted || myRole === 'spectator' || isReview || isDraftFinishedLocal) return;
            if (el.classList.contains('disabled')) return;
            
            document.querySelectorAll('.char-option').forEach(c => c.classList.remove('selected-pending'));
            selectedCharId = char.id; 
            el.classList.add('selected-pending');
            document.getElementById('confirm-btn').disabled = false;
        };
        return el;
    }

    function confirmSelection() {
        if(selectedCharId && currentRoom && !isReview && !isDraftFinishedLocal) {
            socket.emit('action', { roomId: currentRoom, charId: selectedCharId });
            selectedCharId = null; document.getElementById('confirm-btn').disabled = true;
            document.querySelectorAll('.char-option').forEach(c => c.classList.remove('selected-pending'));
        }
    }

    function updateImmunityTop(state) {
         const topDisp = document.getElementById('immunity-top-display');
         if(state.draftType !== 'gitcg_cup_2') { topDisp.style.display = 'none'; return; }
         topDisp.style.display = 'flex';
         const row = document.getElementById('immunity-icons-row'); row.innerHTML = '';
         const bans = state.immunityBans || []; const picks = state.immunityPool || [];
         const slots = [ { val: bans[0], type: 'ban' }, { val: picks[0], type: 'pick' }, { val: picks[1], type: 'pick' }, { val: bans[1], type: 'ban' } ];
         slots.forEach(slot => {
             const div = document.createElement('div'); div.className = `im-icon im-${slot.type}`;
             if (slot.val === 'skipped') { div.innerHTML = `<span style="color:#aaa; font-size:20px; line-height:36px; display:block; text-align:center;">✖</span>`; div.style.background = '#222'; } 
             else if (slot.val) {
                 let all = []; Object.values(charsData).forEach(a => all.push(...a));
                 const char = all.find(c => c.id === slot.val);
                 if(char) div.innerHTML = `<img src="${char.img}">`;
             } else div.classList.add('im-empty');
             row.appendChild(div);
         });
    }

    function updateGlobalBansTop(state) {
        const display = document.getElementById('global-bans-display');
        display.style.display = state.draftType === 'global_ban_sys' ? 'flex' : 'none';
        if (state.draftType !== 'global_ban_sys') return;
        const byId = new Map(Object.values(charsData).flat().map(char => [char.id, char]));
        for (const side of ['blue', 'red']) {
            const row = document.getElementById(`global-${side}-bans`);
            row.replaceChildren();
            for (const id of state.globalBans?.[side] || []) {
                const character = byId.get(id);
                if (!character) continue;
                const icon = document.createElement('div');
                icon.className = 'im-icon im-ban';
                icon.title = character.name;
                const img = document.createElement('img');
                img.src = character.img;
                img.alt = character.name;
                icon.appendChild(img);
                row.appendChild(icon);
            }
        }
    }

    function renderSlots(state) {
         const rulesType = currentDraftType;
         const currentSchema = DRAFT_RULES[rulesType];
         if (!currentSchema) return;

         const getStepsFor = (schema, team, type) => schema.map((step, index) => ({ ...step, globalIndex: index + 1 })).filter(step => step.team === team && step.type === type).map(step => ({ num: step.globalIndex, immunity: step.immunity }));
         
         const blueBanSteps = getStepsFor(currentSchema, 'blue', 'ban'); 
         const redBanSteps = getStepsFor(currentSchema, 'red', 'ban');
         const bluePickSteps = getStepsFor(currentSchema, 'blue', 'pick'); 
         const redPickSteps = getStepsFor(currentSchema, 'red', 'pick');
         
         const fill = (containerId, items, stepData, isBan) => {
             const div = document.getElementById(containerId);
             if(!div) return; 
             div.innerHTML = ''; 
             
             stepData.forEach((step, i) => {
                 const slot = document.createElement('div'); 
                 slot.className = 'slot-circle';
                 
                 if (isBan) slot.classList.add('slot-ban');
                 if (step.immunity) slot.classList.add('slot-immunity-pick');
                 if (!state.immunityPhaseActive && state.gameStarted && !isReview && !state.draftFinished && step.num === state.stepIndex) {
                     slot.classList.add('active-slot');
                 }
  
                 let charId = null; 
                 if (items[i]) charId = typeof items[i] === 'object' ? items[i].id : items[i];
                 
                 if (charId) {
                     if (charId === 'skipped') {
                         slot.innerHTML = `<span style="color:#aaa; font-size:20px; line-height:36px; display:block; text-align:center;">✖</span>`;
                     } else {
                         let allFlat = []; 
                         Object.values(charsData).forEach(arr => allFlat.push(...arr));
                         const char = allFlat.find(c => c.id === charId);
                         if (char) slot.innerHTML = `<img src="${char.img}">`;
                     }
                 } else {
                     slot.innerHTML = `<span class="step-number">${step.num}</span>`;
                 }
                 div.appendChild(slot);
             });
         };
         
         fill('blue-bans', state.bans.filter(b => b.team === 'blue'), blueBanSteps, true); 
         fill('red-bans', state.bans.filter(b => b.team === 'red'), redBanSteps, true);
         
         if (currentDraftType === 'generals_2' || currentDraftType === 'classic' || currentDraftType === 'moba_3phase' || currentDraftType === 'global_ban_sys') {
             fill('blue-picks-1', state.bluePicks, bluePickSteps, false); 
             fill('blue-picks-2', [], [], false); 
             fill('red-picks-1', state.redPicks, redPickSteps, false); 
             fill('red-picks-2', [], [], false);
         } else {
             fill('blue-picks-1', state.bluePicks.slice(0, 5), bluePickSteps.slice(0, 5), false); 
             fill('blue-picks-2', state.bluePicks.slice(5, 9), bluePickSteps.slice(5, 9), false);
             fill('red-picks-1', state.redPicks.slice(0, 5), redPickSteps.slice(0, 5), false); 
             fill('red-picks-2', state.redPicks.slice(5, 9), redPickSteps.slice(5, 9), false);
         }
    }
</script>

