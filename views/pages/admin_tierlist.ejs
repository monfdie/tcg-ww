<%- include('../partials/header') %>

<style>
    .tierlist-wrapper { max-width: 1000px; margin: 0 auto; padding-bottom: 50px; }
    .tl-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 2px solid #2a3454; padding-bottom: 15px; }
    .tl-title { font-family: 'Cinzel', serif; color: #fff; font-size: 2em; margin: 0; }
    
    .btn-save { background: linear-gradient(135deg, #4facfe, #00f2fe); color: #050b14; font-weight: bold; border: none; padding: 10px 22px; border-radius: 4px; cursor: pointer; text-transform: uppercase; transition: 0.2s; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
    .btn-save:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(79, 172, 254, 0.4); }
    
    #capture-tierlist { background: #0d111a; border: 2px solid #2a3454; border-radius: 0; overflow: hidden; }
    .tier-row { display: flex; border-bottom: 1px solid #1a2235; min-height: 80px; background: rgba(16, 22, 36, 0.6); }
    .tier-row:last-child { border-bottom: none; }
    
    .tier-label { width: 100px; display: flex; align-items: center; justify-content: center; font-family: 'Segoe UI', sans-serif; font-size: 24px; font-weight: 800; text-shadow: 1px 1px 2px rgba(0,0,0,0.5); user-select: none; border-right: 1px solid rgba(0,0,0,0.3); }
    
    .tier-t0 { background: linear-gradient(135deg, #00f2fe, #4facfe); color: #050b14; }
    .tier-t1 { background: linear-gradient(135deg, #38ef7d, #11998e); color: #050b14; }
    .tier-t2 { background: linear-gradient(135deg, #fce38a, #f38181); color: #050b14; text-shadow: none; }
    .tier-t3 { background: linear-gradient(135deg, #667eea, #764ba2); color: #ffffff; }
    .tier-t4 { background: linear-gradient(135deg, #434343, #282828); color: #8da4c4; }
    
    .tier-dropzone, .pool-dropzone { flex: 1; display: flex; flex-wrap: wrap; gap: 8px; padding: 10px; align-content: center; min-height: 80px; }
    
    .player-card { position: relative; width: 125px; height: 38px; background: linear-gradient(135deg, #182238, #101726); border: 1px solid #3c4b70; border-radius: 4px; display: flex; align-items: center; justify-content: center; padding: 0 8px; cursor: grab; user-select: none; box-shadow: 0 4px 10px rgba(0,0,0,0.4); transition: 0.15s ease; }
    .player-card:active { cursor: grabbing; border-color: #4facfe; }
    .player-card:hover { border-color: #4facfe; }
    .player-name { color: #e6edf8; font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; pointer-events: none;}
    
    /* Кнопка смены стрелочки */
    .trend-toggle { position: absolute; right: -6px; top: -6px; width: 18px; height: 18px; border-radius: 50%; background: #0d111a; border: 1px solid #2e3b52; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: bold; cursor: pointer; z-index: 10; transition: 0.2s;}
    .trend-toggle:hover { transform: scale(1.1); }
    .trend-up { color: #2ecc71; border-color: #2ecc71; }
    .trend-down { color: #e74c3c; border-color: #e74c3c; }
    .trend-none { color: #8da4c4; }

    /* Кнопка удаления */
    .delete-btn { position: absolute; left: -6px; top: -6px; width: 18px; height: 18px; border-radius: 50%; background: #e74c3c; border: 1px solid #fff; display: flex; align-items: center; justify-content: center; font-size: 10px; cursor: pointer; z-index: 10; transition: 0.2s; color: #fff; font-family: sans-serif; font-weight: bold; }
    .delete-btn:hover { background: #c0392b; transform: scale(1.1); }

    .pool-section { margin-top: 30px; background: rgba(16, 22, 36, 0.6); border: 1px dashed #3c4b70; border-radius: 4px; padding: 15px; }
    .add-player-box { margin-top: 20px; display: flex; gap: 10px; }
    .add-player-box input { flex: 1; padding: 12px; background: #0b0d17; color: #fff; border: 1px solid #3c4b70; border-radius: 4px; outline: none; }
    .add-player-box input:focus { border-color: #4facfe; }
</style>

<div class="tierlist-wrapper">
    <div class="tl-header">
        <h1 class="tl-title">ADMIN: Edit Official Tierlist</h1>
        <button class="btn-save" onclick="saveTierlist()">PUBLISH CHANGES</button>
    </div>

    <div style="background: rgba(79, 172, 254, 0.1); border-left: 4px solid #4facfe; padding: 10px 15px; margin-bottom: 20px; color: #fff; font-size: 14px;">
        <b>Instruction:</b> Drag players to tiers. Click the circle on the right to cycle trends. Click the Red X on the left to delete a player.
    </div>

    <div id="capture-tierlist">
        <% const tiers = ['t0', 't1', 't2', 't3', 't4']; %>
        <% tiers.forEach((tier, index) => { %>
        <div class="tier-row">
            <div class="tier-label tier-<%= tier %>">T<%= index %></div>
            <div class="tier-dropzone" id="<%= tier %>">
                <% tierlistData[tier].forEach(player => { %>
                    <div class="player-card" data-name="<%= player.name %>" data-trend="<%= player.trend %>">
                        <div class="delete-btn" onmousedown="event.stopPropagation();" onclick="deletePlayer(this)">X</div>
                        <span class="player-name"><%= player.name %></span>
                        <div class="trend-toggle trend-<%= player.trend %>" onmousedown="event.stopPropagation();" onclick="cycleTrend(this)"><%= player.trend === 'up' ? '▲' : (player.trend === 'down' ? '▼' : '-') %></div>
                    </div>
                <% }) %>
            </div>
        </div>
        <% }) %>
    </div>

    <div class="pool-section">
        <div style="color: #8da4c4; font-size: 12px; font-weight: bold; text-transform: uppercase; margin-bottom: 15px;">Unassigned Players</div>
        <div class="pool-dropzone" id="unassigned">
            <% tierlistData.unassigned.forEach(player => { %>
                <div class="player-card" data-name="<%= player.name %>" data-trend="none">
                    <div class="delete-btn" onmousedown="event.stopPropagation();" onclick="deletePlayer(this)">X</div>
                    <span class="player-name"><%= player.name %></span>
                    <div class="trend-toggle trend-none" onmousedown="event.stopPropagation();" onclick="cycleTrend(this)">-</div>
                </div>
            <% }) %>
        </div>

        <div class="add-player-box">
            <input type="text" id="new-player-input" placeholder="Type new player name here..." onkeypress="if(event.key === 'Enter') addPlayer()">
            <button class="btn-save" onclick="addPlayer()">+ ADD</button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

<script>
    const zones = ['t0', 't1', 't2', 't3', 't4', 'unassigned'].map(id => document.getElementById(id));
    zones.forEach(zone => {
        new Sortable(zone, { 
            group: 'tierlist', 
            animation: 150,
            filter: '.trend-toggle, .delete-btn',
            preventOnFilter: false
        });
    });

    function cycleTrend(btn) {
        const card = btn.parentElement;
        let current = card.dataset.trend;
        let next = 'none'; let icon = '-';
        
        if (current === 'none') { next = 'up'; icon = '▲'; }
        else if (current === 'up') { next = 'down'; icon = '▼'; }
        else if (current === 'down') { next = 'none'; icon = '-'; }

        card.dataset.trend = next;
        btn.className = `trend-toggle trend-${next}`;
        btn.innerText = icon;
    }

    function deletePlayer(btn) {
        if(confirm("Delete this player?")) {
            btn.parentElement.remove();
        }
    }

    function addPlayer() {
        const input = document.getElementById('new-player-input');
        const name = input.value.trim();
        if (!name) return;

        const card = document.createElement('div');
        card.className = 'player-card';
        card.dataset.name = name;
        card.dataset.trend = 'none';
        
        card.innerHTML = `
            <div class="delete-btn" onmousedown="event.stopPropagation();" onclick="deletePlayer(this)">X</div>
            <span class="player-name">${name}</span>
            <div class="trend-toggle trend-none" onmousedown="event.stopPropagation();" onclick="cycleTrend(this)">-</div>
        `;
        
        document.getElementById('unassigned').appendChild(card);
        input.value = '';
    }

    async function saveTierlist() {
        const data = { t0: [], t1: [], t2: [], t3: [], t4: [], unassigned: [] };
        
        Object.keys(data).forEach(tierId => {
            const container = document.getElementById(tierId);
            container.querySelectorAll('.player-card').forEach(card => {
                data[tierId].push({
                    name: card.dataset.name,
                    trend: card.dataset.trend
                });
            });
        });

        try {
            const res = await fetch('/admin/tierlist/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (res.ok) {
                alert('Official Tierlist has been successfully updated and published!');
            } else {
                alert('Error saving tierlist.');
            }
        } catch (e) { alert('Error: ' + e.message); }
    }
</script>

<%- include('../partials/footer') %>
