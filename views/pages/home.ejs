<%- include('../partials/header') %>

<style>
    /* Главный баннер */
    .hero-banner {
        background: rgba(16, 25, 45, 0.65);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-top: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 12px;
        padding: 40px 20px;
        text-align: center;
        margin-bottom: 40px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
    }
    .hero-title {
        font-family: 'Cinzel', serif;
        font-size: 2.4rem;
        color: #ffcc00;
        text-shadow: 0 0 15px rgba(255, 204, 0, 0.4);
        margin-bottom: 12px;
        font-weight: bold;
    }
    .hero-subtitle {
        color: #aee3ff;
        font-size: 15px;
        max-width: 650px;
        margin: 0 auto 25px auto;
        line-height: 1.5;
    }

    /* Кнопки баннера */
    .btn-hero-primary {
        background: #009cf0;
        color: #fff;
        border: 1px solid #009cf0;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 14px;
        text-decoration: none;
        display: inline-block;
        transition: 0.2s;
        box-shadow: 0 4px 12px rgba(0, 156, 240, 0.3);
    }
    .btn-hero-primary:hover { background: #0085cc; color: #fff; text-decoration: none; transform: translateY(-2px); }

    .btn-hero-secondary {
        background: rgba(20, 30, 50, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #e0f2ff;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 14px;
        text-decoration: none;
        display: inline-block;
        transition: 0.2s;
    }
    .btn-hero-secondary:hover { background: rgba(255, 255, 255, 0.1); color: #fff; text-decoration: none; transform: translateY(-2px); }

    /* Секция активных турниров */
    .section-heading {
        font-family: 'Cinzel', serif;
        color: #ffffff;
        font-size: 1.3rem;
        letter-spacing: 2px;
        margin-bottom: 20px;
        text-transform: uppercase;
        border-left: 3px solid #00d2ff;
        padding-left: 10px;
    }

    /* Сетка турниров */
    .tournaments-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 25px;
    }

    /* Карточка турнира (Glassmorphism) */
    .tournament-card {
        background: rgba(16, 25, 45, 0.65);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-top: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        color: #fff;
        display: flex;
        flex-direction: column;
        transition: all 0.3s ease;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
    }
    .tournament-card:hover {
        transform: translateY(-5px);
        border-color: rgba(0, 210, 255, 0.6);
        box-shadow: 0 12px 35px rgba(0, 163, 255, 0.25);
        color: #fff;
        text-decoration: none;
    }
    .tournament-card-img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        background: #0b0d14;
    }
    .tournament-card-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }
    .tournament-card-title {
        font-size: 20px;
        font-weight: bold;
        color: #00d2ff;
        margin-bottom: 12px;
    }
    .tournament-card-meta {
        font-size: 14px;
        color: #aee3ff;
        margin-bottom: 6px;
    }
    .tournament-card-meta strong {
        color: #fff;
    }

    /* Блок, если турниров нет */
    .empty-tournaments-card {
        background: rgba(16, 25, 45, 0.4);
        backdrop-filter: blur(8px);
        border: 1px dashed rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        padding: 50px 20px;
        text-align: center;
    }
</style>

<div class="container mt-4 mb-5" style="max-width: 1100px;">

    <!-- Главный баннер -->
    <div class="hero-banner">
        <h1 class="hero-title">GENSHIN TCG DRAFTS</h1>
        <p class="hero-subtitle">The ultimate platform for Genshin Impact TCG draft matches. Create a room, ban and pick your characters, and duel with your friends!</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="/lobby" class="btn-hero-primary">CREATE MATCH</a>
            <a href="/recent" class="btn-hero-secondary">RECENT GAMES</a>
        </div>
    </div>

    <!-- Заголовок активных турниров -->
    <h3 class="section-heading">ACTIVE TOURNAMENTS</h3>

    <!-- Сетка турниров / Заглушка с безопасной проверкой locals -->
    <% 
    const tourList = (typeof tournaments !== 'undefined' && Array.isArray(tournaments)) ? tournaments : (locals.tournaments || []);
    const activeTournaments = tourList.filter(t => t && t.isLive !== false);
    %>

    <% if (activeTournaments.length > 0) { %>
        <div class="tournaments-grid">
            <% activeTournaments.forEach(t => { %>
                <a href="/tournament/<%= t.slug || t._id %>" class="tournament-card">
                    <% if (t.image) { %>
                        <img src="<%= (typeof t.image === 'string' && t.image.startsWith('http')) ? t.image : '/uploads/' + t.image %>" class="tournament-card-img" alt="<%= t.title || 'Tournament' %>" onerror="this.src='/logo.png'">
                    <% } else { %>
                        <img src="/logo.png" class="tournament-card-img" style="object-fit: contain; padding: 20px;" alt="Logo">
                    <% } %>
                    <div class="tournament-card-body">
                        <div class="tournament-card-title"><%= t.title || 'Untitled Tournament' %></div>
                        <div class="tournament-card-meta"><strong>Date:</strong> <%= t.date || 'TBA' %></div>
                        <div class="tournament-card-meta"><strong>Prize Pool:</strong> <%= t.prize || 'TBA' %></div>
                        <div class="tournament-card-meta"><strong>Format:</strong> <%= t.format || 'TBA' %></div>
                    </div>
                </a>
            <% }) %>
        </div>
    <% } else { %>
        <div class="empty-tournaments-card">
            <h4 style="font-family: 'Cinzel', serif; color: #fff; margin-bottom: 10px;">NO ACTIVE TOURNAMENTS</h4>
            <p style="color: #8fa0c9; font-size: 14px; margin-bottom: 20px;">There are currently no tournaments running.<br>Grab a friend and play a friendly match in the meantime!</p>
            <a href="/lobby" class="btn-hero-primary">START FRIENDLY MATCH</a>
        </div>
    <% } %>

</div>

<%- include('../partials/footer') %>
