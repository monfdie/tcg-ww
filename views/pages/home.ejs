<%- include('../partials/header') %>

<style>
    /* Стили для приветственного баннера */
    .hero-banner {
        background: linear-gradient(rgba(10, 12, 20, 0.7), rgba(10, 12, 20, 0.95)), url('/bg.jpg') center/cover no-repeat;
        padding: 60px 20px;
        text-align: center;
        border-radius: 12px;
        border: 1px solid #3c4566;
        margin-bottom: 40px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.6);
        position: relative;
        overflow: hidden;
    }
    
    .hero-banner::before {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 100%; height: 2px;
        background: linear-gradient(90deg, transparent, #d4af37, transparent);
    }

    .hero-title {
        font-family: 'Cinzel', serif;
        font-size: 3.5em;
        color: #d4af37;
        margin-bottom: 15px;
        text-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
        letter-spacing: 2px;
    }

    .hero-subtitle {
        color: #8da4c4;
        font-size: 1.2em;
        margin-bottom: 35px;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.6;
    }

    .hero-buttons {
        display: flex;
        gap: 20px;
        justify-content: center;
    }

    .btn-hero {
        padding: 15px 35px;
        border-radius: 6px;
        font-weight: bold;
        text-transform: uppercase;
        text-decoration: none;
        transition: 0.3s;
        font-size: 1.1em;
        letter-spacing: 1px;
    }

    .btn-primary-hero {
        background: linear-gradient(135deg, #4facfe, #00f2fe);
        color: #000;
        box-shadow: 0 0 15px rgba(79, 172, 254, 0.4);
    }

    .btn-primary-hero:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 25px rgba(79, 172, 254, 0.8);
    }

    .btn-secondary-hero {
        background: rgba(16, 20, 32, 0.8);
        color: #fff;
        border: 1px solid #4facfe;
    }

    .btn-secondary-hero:hover {
        background: #4facfe;
        color: #000;
    }

    /* Состояние, когда турниров нет */
    .empty-state {
        text-align: center;
        padding: 50px 20px;
        background: rgba(16, 20, 32, 0.5);
        border: 1px dashed #3c4566;
        border-radius: 12px;
        color: #8da4c4;
    }

    .empty-state h3 {
        color: #fff;
        font-family: 'Cinzel', serif;
        font-size: 1.8em;
        margin-bottom: 15px;
    }
</style>

<div class="hero-banner">
    <h1 class="hero-title">GENSHIN TCG DRAFTS</h1>
    <p class="hero-subtitle">The ultimate platform for Genshin Impact TCG draft matches. Create a room, ban and pick your characters, and duel with your friends!</p>
    <div class="hero-buttons">
        <a href="/create" class="btn-hero btn-primary-hero">Create Match</a>
        <a href="/history" class="btn-hero btn-secondary-hero">Recent Games</a>
    </div>
</div>

<h2 style="font-family: 'Cinzel', serif; color: #fff; border-bottom: 1px solid #3c4566; padding-bottom: 10px; margin-bottom: 20px;">
    ACTIVE TOURNAMENTS
</h2>

<div class="tournaments-grid">
    <% if (locals.tournaments && locals.tournaments.length > 0) { %>
        <% tournaments.forEach(t => { %>
            <a href="/tournament/<%= t.slug %>" class="tournament-card">
                <div class="tc-image">
                    <!-- Заглушка, если нет картинки -->
                    <img src="<%= t.image ? (t.image.startsWith('http') ? t.image : '/uploads/' + t.image) : '/bg.jpg' %>" alt="<%= t.title %>">
                    <div class="tc-status <%= t.status %>"><%= t.status.toUpperCase() %></div>
                </div>
                <div class="tc-content">
                    <h3 class="tc-title"><%= t.title %></h3>
                    <div class="tc-meta">
                        <span>Participants: <%= t.participants ? t.participants.length : 0 %></span>
                    </div>
                </div>
            </a>
        <% }) %>
    <% } else { %>
        <!-- Красивая заглушка вместо пустого места -->
        <div class="empty-state" style="grid-column: 1 / -1;">
            <h3>No Active Tournaments</h3>
            <p>There are currently no tournaments running. <br>Grab a friend and play a friendly match in the meantime!</p>
            <a href="/create" class="btn-hero btn-primary-hero" style="display: inline-block; margin-top: 20px; padding: 10px 20px; font-size: 1em;">Start Friendly Match</a>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
