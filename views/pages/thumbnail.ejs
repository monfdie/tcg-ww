<%- include('../partials/header') %>

<style>
    .maker-container { display: flex; gap: 30px; padding: 20px; align-items: flex-start; flex-wrap: wrap; }
    
    /* ПАНЕЛЬ УПРАВЛЕНИЯ */
    .controls-panel { background: rgba(16, 20, 32, 0.9); border: 1px solid #2a3454; border-radius: 8px; padding: 20px; width: 350px; flex-shrink: 0; box-shadow: 0 5px 20px rgba(0,0,0,0.5); }
    .controls-panel h2 { margin-top: 0; color: #fff; font-family: 'Cinzel', serif; border-bottom: 1px solid #3c4566; padding-bottom: 10px; }
    
    .input-group { margin-bottom: 15px; }
    .input-group label { display: block; color: #8da4c4; font-weight: bold; font-size: 0.85em; margin-bottom: 5px; text-transform: uppercase; }
    .input-group input, .input-group select { width: 100%; padding: 10px; background: #0b0d17; border: 1px solid #4facfe; color: #fff; border-radius: 4px; font-family: 'Segoe UI', sans-serif; font-size: 1em; }
    
    .download-btn { width: 100%; padding: 15px; font-size: 1.1em; background: linear-gradient(135deg, #4facfe, #00f2fe); color: #000; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; text-transform: uppercase; transition: 0.3s; margin-top: 10px; box-shadow: 0 0 15px rgba(79, 172, 254, 0.4); }
    .download-btn:hover { transform: translateY(-2px); box-shadow: 0 0 25px rgba(79, 172, 254, 0.8); }

    /* ЗОНА ПРЕВЬЮ (Жестко 1280x720, но отмасштабирована под экран) */
    .preview-wrapper { width: 800px; height: 450px; position: relative; overflow: hidden; border: 2px solid #3c4566; border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.8); }
    
    #canvas-area { 
        width: 1280px; height: 720px; position: absolute; top: 0; left: 0; 
        transform: scale(0.625); /* 800 / 1280 = 0.625 */
        transform-origin: top left;
        background: url('/bg.jpg') center/cover no-repeat;
        display: flex; justify-content: space-between; align-items: center; padding: 50px; box-sizing: border-box;
    }

    /* ЗАЛИТАЯ ПОДЛОЖКА ДЛЯ КРАСОТЫ */
    .overlay-shadow { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(90deg, rgba(10,12,20,0.9) 0%, rgba(10,12,20,0.4) 50%, rgba(10,12,20,0.9) 100%); pointer-events: none; }

    /* ИГРОКИ НА КАРТИНКЕ */
    .player-side { position: relative; z-index: 10; display: flex; flex-direction: column; align-items: center; gap: 30px; width: 450px; }
    .player-name-display { font-family: 'Cinzel', serif; font-size: 4em; font-weight: bold; color: #fff; text-shadow: 0 0 20px #000, 0 5px 10px rgba(0,0,0,0.8); text-transform: uppercase; text-align: center; line-height: 1.1; }
    .blue-name { color: #4facfe; text-shadow: 0 0 20px #4facfe, 0 5px 10px rgba(0,0,0,0.8); }
    .red-name { color: #ff6b6b; text-shadow: 0 0 20px #ff6b6b, 0 5px 10px rgba(0,0,0,0.8); }

    /* ОТОБРАЖЕНИЕ ПЕРСОНАЖЕЙ */
    .char-showcase { display: flex; justify-content: center; gap: 15px; }
    .char-card { width: 140px; height: 140px; border-radius: 12px; border: 4px solid #d4af37; box-shadow: 0 15px 25px rgba(0,0,0,0.8); object-fit: cover; background: #111; }
    
    /* ЭФФЕКТЫ */
    .blue-side .char-card { border-color: #4facfe; transform: rotate(-5deg); transition: 0.3s; }
    .blue-side .char-card:nth-child(2) { transform: rotate(0deg) scale(1.1); z-index: 2; margin-top: -20px; border-color: #d4af37; }
    .blue-side .char-card:nth-child(3) { transform: rotate(5deg); }
    
    .red-side .char-card { border-color: #ff6b6b; transform: rotate(5deg); transition: 0.3s; }
    .red-side .char-card:nth-child(2) { transform: rotate(0deg) scale(1.1); z-index: 2; margin-top: -20px; border-color: #d4af37; }
    .red-side .char-card:nth-child(3) { transform: rotate(-5deg); }

    /* ЦЕНТР (VS) */
    .vs-logo { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 20; font-family: 'Cinzel', serif; font-size: 8em; font-weight: bold; color: #fff; text-shadow: 0 0 30px #d4af37, 0 0 10px #000; letter-spacing: 5px; background: radial-gradient(circle, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 70%); padding: 50px; border-radius: 50%; }
</style>

<div class="page-container" style="max-width: 1300px;">
    
    <div style="margin-bottom: 20px; border-bottom: 1px solid #3c4566; padding-bottom: 10px;">
        <h1 style="color: #fff; font-family: 'Cinzel', serif; margin: 0;">YouTube Thumbnail Maker</h1>
        <p style="color: #8da4c4; margin: 5px 0 0 0;">Create a 1280x720 preview for your match replays. Only accessible via direct link.</p>
    </div>

    <div class="maker-container">
        <div class="controls-panel">
            <h2>Player 1 (Left)</h2>
            <div class="input-group">
                <label>Nickname</label>
                <input type="text" id="p1-name" value="PLAYER 1" oninput="updatePreview()">
            </div>
            <div class="input-group">
                <label>Main Characters</label>
                <select id="p1-c1" onchange="updatePreview()"><option value="none">-- Select --</option></select>
                <select id="p1-c2" onchange="updatePreview()" style="margin-top:5px;"><option value="none">-- Select --</option></select>
                <select id="p1-c3" onchange="updatePreview()" style="margin-top:5px;"><option value="none">-- Select --</option></select>
            </div>

            <h2 style="margin-top: 30px;">Player 2 (Right)</h2>
            <div class="input-group">
                <label>Nickname</label>
                <input type="text" id="p2-name" value="PLAYER 2" oninput="updatePreview()">
            </div>
            <div class="input-group">
                <label>Main Characters</label>
                <select id="p2-c1" onchange="updatePreview()"><option value="none">-- Select --</option></select>
                <select id="p2-c2" onchange="updatePreview()" style="margin-top:5px;"><option value="none">-- Select --</option></select>
                <select id="p2-c3" onchange="updatePreview()" style="margin-top:5px;"><option value="none">-- Select --</option></select>
            </div>

            <button class="download-btn" id="dl-btn" onclick="downloadImage()">📸 Download Image</button>
        </div>

        <div class="preview-wrapper">
            <div id="canvas-area">
                <div class="overlay-shadow"></div>
                
                <div class="vs-logo">VS</div>
                
                <div class="player-side blue-side">
                    <div class="player-name-display blue-name" id="disp-p1-name">PLAYER 1</div>
                    <div class="char-showcase">
                        <img src="https://cdn.discordapp.com/embed/avatars/0.png" class="char-card" id="disp-p1-c1" style="opacity: 0;">
                        <img src="https://cdn.discordapp.com/embed/avatars/0.png" class="char-card" id="disp-p1-c2" style="opacity: 0;">
                        <img src="https://cdn.discordapp.com/embed/avatars/0.png" class="char-card" id="disp-p1-c3" style="opacity: 0;">
                    </div>
                </div>

                <div class="player-side red-side">
                    <div class="player-name-display red-name" id="disp-p2-name">PLAYER 2</div>
                    <div class="char-showcase">
                        <img src="https://cdn.discordapp.com/embed/avatars/0.png" class="char-card" id="disp-p2-c1" style="opacity: 0;">
                        <img src="https://cdn.discordapp.com/embed/avatars/0.png" class="char-card" id="disp-p2-c2" style="opacity: 0;">
                        <img src="https://cdn.discordapp.com/embed/avatars/0.png" class="char-card" id="disp-p2-c3" style="opacity: 0;">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
    const charsData = <%- JSON.stringify(chars) %>;
    
    // Собираем плоский массив персонажей
    let allChars = [];
    ['cryo','hydro','pyro','electro','anemo','geo','dendro'].forEach(elem => {
        if(charsData[elem]) charsData[elem].forEach(c => allChars.push(c));
    });
    // Сортируем по алфавиту для удобства
    allChars.sort((a,b) => a.name.localeCompare(b.name));

    // Заполняем все селекты
    const selects = ['p1-c1', 'p1-c2', 'p1-c3', 'p2-c1', 'p2-c2', 'p2-c3'];
    selects.forEach(id => {
        const sel = document.getElementById(id);
        allChars.forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.img; // Сразу сохраняем путь к картинке в value
            opt.innerText = c.name;
            sel.appendChild(opt);
        });
    });

    // Функция обновления превьюхи при любом изменении в инпутах
    function updatePreview() {
        // Имена
        document.getElementById('disp-p1-name').innerText = document.getElementById('p1-name').value || 'PLAYER 1';
        document.getElementById('disp-p2-name').innerText = document.getElementById('p2-name').value || 'PLAYER 2';

        // Картинки
        selects.forEach(id => {
            const val = document.getElementById(id).value;
            const imgEl = document.getElementById('disp-' + id);
            if (val !== 'none') {
                imgEl.src = val;
                imgEl.style.opacity = '1';
            } else {
                imgEl.style.opacity = '0'; // Скрываем пустую рамку
            }
        });
    }

    // Скачивание
    function downloadImage() {
        const btn = document.getElementById('dl-btn');
        btn.innerText = '⏳ Processing...';
        btn.disabled = true;

        const target = document.getElementById('canvas-area');
        
        // Временно снимаем масштабирование, чтобы сфоткать в 1280x720 1:1
        target.style.transform = 'scale(1)';

        html2canvas(target, {
            scale: 1, 
            useCORS: true, 
            allowTaint: true,
            width: 1280,
            height: 720
        }).then(canvas => {
            // Возвращаем масштаб для UI
            target.style.transform = 'scale(0.625)';

            const link = document.createElement('a');
            const p1 = document.getElementById('p1-name').value || 'P1';
            const p2 = document.getElementById('p2-name').value || 'P2';
            link.download = `GITCG_Thumbnail_${p1}_vs_${p2}.png`;
            link.href = canvas.toDataURL('image/png');
            link.click();

            btn.innerText = '📸 Download Image';
            btn.disabled = false;
        }).catch(err => {
            console.error(err);
            target.style.transform = 'scale(0.625)';
            alert('Error creating thumbnail.');
            btn.innerText = '📸 Download Image';
            btn.disabled = false;
        });
    }

    // Инициализация при загрузке
    document.addEventListener('DOMContentLoaded', updatePreview);
</script>

<%- include('../partials/footer') %>
