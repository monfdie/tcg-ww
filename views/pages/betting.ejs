<%- include('../partials/header') %>
<link rel="stylesheet" href="/betting.css">
<section class="betting" data-view="<%= mode %>">
<header class="bet-heading bet-topbar"><% if (wallet) { %><div class="bet-wallet"><span class="bet-balance"><%= wallet.balance.toLocaleString('en-US') %> ◆</span><form method="post" action="/bets/bonus"><input type="hidden" name="csrf" value="<%= csrf %>"><button <%= wallet.week === week ? 'disabled' : '' %>><%= wallet.week === week ? 'Bonus claimed' : 'Claim +' + settings.weekly %></button></form></div><% } else { %><a href="/auth/discord">Sign in</a><% } %></header>
<div class="bet-toolbar"><nav class="bet-nav"><% for (const [url, name, active] of [['/bets','Events',mode === 'list'],['/bets/mine','My bets',mode === 'mine'],['/bets/leaders','Leaderboard',mode === 'leaders'], ...(isAdmin ? [['/bets/admin','Manage Bets',['admin','edit','confirm','participants'].includes(mode)],['/bets/admin/points','Manage Points',['points','remove-confirm'].includes(mode)]] : [])]) { %><a href="<%= url %>" class="<%= active ? 'active' : '' %>"><%= name %></a><% } %></nav><% if (isAdmin && ['list','admin'].includes(mode)) { %><a class="bet-button bet-create" href="/bets/new">＋ Create event</a><% } %></div>
<% if (notice) { %><p class="bet-notice" role="status"><%= notice %></p><% } %>
<% if (mode === 'list' || mode === 'admin') { %>
<% if (mode === 'list') { %><div class="bet-grid bet-events"><% for (const event of events) { %><a class="bet-card bet-event" href="/bets/event/<%= event._id %>"><div class="bet-event-top"><span class="bet-badge"><%= labels[event.status === 'open' && !isOpen(event) ? 'closed' : event.status] %></span></div><h2><%= event.title %></h2><div class="bet-matchup"><% for (let i=0;i<2;i++) { %><% if (i) { %><span class="bet-vs">VS</span><% } %><div class="bet-contender" data-side="<%= i %>"><span class="bet-avatar"><%= Array.from(event.sides[i])[0] %></span><span class="bet-player"><%= event.sides[i] %></span><span class="bet-odd"><%= oddsText(event.odds[i]) %>×</span></div><% } %></div><div class="bet-event-footer"><%= dateText(event.closesAt) %> · View event →</div></a><% } %></div><% } else { %>
<div class="bet-table-wrap bet-admin-list"><table><thead><tr><th>Event / players</th><th>Status</th><th>Closes · UTC+3</th><th>Bets / points</th><th>Actions</th></tr></thead><tbody><% for (const event of events) { %><tr><td><a href="/bets/event/<%= event._id %>"><strong><%= event.title %></strong></a><br><small><%= event.sides.join(' vs ') %> · <%= event.odds.map(oddsText).join(' / ') %></small></td><td><%= labels[event.status] %></td><td><%= dateText(event.closesAt) %></td><td><a href="/bets/admin/event/<%= event._id %>/bets"><strong><%= (stats[String(event._id)] || {}).count || 0 %> bets · <%= (stats[String(event._id)] || {}).amount || 0 %> ◆</strong><br><small><% for(let i=0;i<2;i++) { %><%= event.sides[i] %>: <%= ((stats[String(event._id)] || {}).sides || [0,0])[i] %> ◆<%= i === 0 ? ' / ' : '' %><% } %></small></a></td><td><div class="bet-actions"><a class="bet-button" href="/bets/admin/event/<%= event._id %>/bets">View bets</a><a class="bet-button" href="/bets/event/<%= event._id %>">Manage</a><% if (['settled','cancelled'].includes(event.status)) { %><a class="bet-button bet-danger" href="/bets/event/<%= event._id %>/delete-confirm">Delete from history</a><% } %></div></td></tr><% } %></tbody></table></div><% } %>
<% if (!events.length) { %><div class="bet-empty"><h2>No events</h2></div><% } %><nav class="bet-nav"><% if (page>1) { %><a href="?page=<%= page-1 %>">← Previous</a><% } %><% if (more) { %><a href="?page=<%= page+1 %>">Next →</a><% } %></nav><% } %>
<% if (mode === 'points') { %><%- include('../partials/betting-points') %><% } %>
<%- include('../partials/betting-admin-panels') %>
<% if (mode === 'event' && isAdmin) { %><p><a class="bet-button" href="/bets/admin/event/<%= event._id %>/bets">View all bets · Admin only</a></p><% } %>
<% if (mode === 'event') { %><article class="bet-card"><span class="bet-badge"><%= labels[event.status] %></span><h2><%= event.title %></h2><p class="bet-description"><%= event.description %></p><p class="bet-muted">Closes: <%= dateText(event.closesAt) %> · UTC+3</p><% if (event.status === 'settled') { %><p class="bet-notice">Winner: <%= event.sides[event.winner] %></p><% } %><% if (event.status === 'cancelled') { %><p class="bet-notice">Refunded</p><% } %><% if (event.status === 'settling') { %><p class="bet-notice">Processing payouts / refunds</p><% } %><div class="bet-grid"><% for(let i=0;i<2;i++) { const allowed = !bets.length || bets[0].side === i; %><form class="bet-card bet-form bet-place" method="post" action="/bets/event/<%= event._id %>/bet" data-odds="<%= event.odds[i] %>"><h3><%= event.sides[i] %> ×<%= oddsText(event.odds[i]) %></h3><% if(wallet && isOpen(event) && allowed) { %><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="request" value="<%= uuid() %>"><input type="hidden" name="side" value="<%= i %>"><input type="hidden" name="odds" value="<%= event.odds[i] %>"><label>Stake<input type="number" name="amount" min="1" max="<%= wallet.balance %>" step="1" required></label><p>Payout: <strong class="bet-preview">0</strong> points</p><button <%= wallet.balance < 1 ? 'disabled' : '' %>>Place bet</button><% } else { %><p class="bet-muted"><%= !wallet ? 'Sign in to bet' : !allowed ? 'Other side selected' : 'Betting is closed.' %></p><% } %></form><% } %></div></article>
<% if (bets.length) { %><h2>Your bets</h2><div class="bet-table-wrap"><table><thead><tr><th>Side</th><th>Amount</th><th>Odds</th><th>Status</th><th>Payout</th></tr></thead><tbody><% for(const bet of bets) { %><tr><td><%= event.sides[bet.side] %></td><td><%= bet.amount %></td><td>×<%= oddsText(bet.odds) %></td><td><%= labels[bet.status] %></td><td><%= bet.status === 'pending' ? '—' : bet.payout %></td></tr><% } %></tbody></table></div><% } %>
<% if(isAdmin && !['settling','settled','cancelled'].includes(event.status)) { %><div class="bet-card"><h2>Manage event</h2><div class="bet-actions"><% if(event.status === 'draft' || isOpen(event)) { %><a class="bet-button" href="/bets/event/<%= event._id %>/edit">Edit</a><% } %><% for(const action of (event.status === 'draft' ? ['publish'] : event.status === 'open' ? ['close'] : [])) { %><form method="post" action="/bets/event/<%= event._id %>/<%= action %>"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= event.version %>"><button><%= action === 'publish' ? 'Publish' : 'Close betting' %></button></form><% } %><% if(event.status === 'closed') { for(let i=0;i<2;i++) { %><a class="bet-button" href="/bets/event/<%= event._id %>/confirm?winner=<%= i %>">Winner: <%= event.sides[i] %></a><% } } %><a class="bet-button bet-danger" href="/bets/event/<%= event._id %>/confirm?cancel=1">Cancel & refund</a></div></div><% } %><% } %>
<% if(mode === 'edit') { const locked = !creating && event.status !== 'draft'; %><form class="bet-card bet-form" method="post" action="<%= creating ? '/bets/admin/create' : '/bets/event/' + event._id + '/edit' %>" data-event-form><h2><%= creating ? 'New event' : 'Edit event' %></h2><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= event._id %>"><input type="hidden" name="version" value="<%= event.version %>"><label>Title<input name="title" maxlength="160" value="<%= event.title %>" required <%= locked ? 'readonly' : '' %>></label><label>Description<textarea name="description" maxlength="3000" <%= locked ? 'readonly' : '' %>><%= event.description %></textarea></label><div class="bet-grid"><% for(let i=0;i<2;i++) { %><div><label>Player <%= i+1 %><input name="side<%= i %>" maxlength="100" value="<%= event.sides[i] %>" required <%= locked ? 'readonly' : '' %>></label><label>Odds<input name="odds<%= i %>" type="number" min="1" step="0.01" value="<%= oddsText(event.odds[i]) %>" required></label></div><% } %></div><label>Closes at (UTC+3)<input type="datetime-local" data-deadline data-initial="<%= event.closesAt ? new Date(event.closesAt).toISOString() : '' %>"></label><input type="hidden" name="closesAt" value="<%= event.closesAt ? new Date(event.closesAt).toISOString() : '' %>"><button>Save <%= creating ? 'draft' : 'changes' %></button></form><% } %>
<% if(mode === 'confirm') { %><div class="bet-card"><h2>Confirm result</h2><h3><%= event.title %></h3><p><%= cancelled ? 'Cancel event & refund all bets' : 'Winner: ' + event.sides[winner] %></p><p>Bets: <strong><%= count %></strong> · Total payout: <strong><%= total %></strong> points</p><form method="post" action="/bets/event/<%= event._id %>/decide"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="winner" value="<%= winner %>"><input type="hidden" name="cancelled" value="<%= cancelled ? '1' : '0' %>"><input type="hidden" name="version" value="<%= event.version %>"><label class="bet-check"><input type="checkbox" required> Confirm final result and payouts</label><div class="bet-actions"><button>Confirm result</button><a href="/bets/event/<%= event._id %>">Back</a></div></form></div><% } %>
<% if(mode === 'mine') { %><nav class="bet-nav" aria-label="Filter bets"><a href="/bets/mine" <%- !status ? 'aria-current="page"' : '' %>>All</a><% for(const s of ['pending','won','lost','refunded']) { %><a href="?status=<%= s %>" <%- s === status ? 'aria-current="page"' : '' %>><%= labels[s] %></a><% } %></nav><div class="bet-table-wrap"><table><thead><tr><th>Date · UTC+3</th><th>Event / pick</th><th>Amount</th><th>Odds</th><th>Status</th><th>Payout</th><% if (isAdmin) { %><th>History</th><% } %></tr></thead><tbody><% for(const bet of bets) { %><tr><td><%= dateText(bet.createdAt) %></td><td><% if(bet.event) { %><a href="/bets/event/<%= bet.event._id %>"><%= bet.event.title %></a><br><small><%= bet.event.sides[bet.side] %></small><% } %></td><td><%= bet.amount %></td><td>×<%= oddsText(bet.odds) %></td><td><%= labels[bet.status] %></td><td><%= bet.status === 'pending' ? '—' : bet.payout %></td><% if (isAdmin) { %><td><% if(bet.status !== 'pending') { %><a class="bet-button bet-danger" href="/bets/history/<%= bet._id %>/delete-confirm">Delete</a><% } %></td><% } %></tr><% } %><% if(!bets.length) { %><tr><td colspan="<%= isAdmin ? 7 : 6 %>">No bets</td></tr><% } %></tbody></table></div><nav class="bet-nav"><% if(page>1) { %><a href="?page=<%= page-1 %>&status=<%= status %>">← Previous</a><% } %><% if(more) { %><a href="?page=<%= page+1 %>&status=<%= status %>">Next →</a><% } %></nav><h2>Recent activity</h2><div class="bet-table-wrap"><table><thead><tr><th>Date · UTC+3</th><th>Activity</th><th>Points</th></tr></thead><tbody><% for(const row of ledger) { %><tr><td><%= dateText(row.createdAt) %></td><td><%= ({start:'Starting balance',weekly:'Weekly bonus',grant:'Admin credit',remove:'Admin debit',bet:'Bet',won:'Won',lost:'Lost',refunded:'Refunded'})[row.kind] %><% if(!['start','weekly'].includes(row.kind)) { %><br><small><%= row.reason %></small><% } %></td><td><%= row.amount>0 ? '+' : '' %><%= row.amount %></td></tr><% } %></tbody></table></div><% } %>
<% if(mode === 'leaders') { %><div class="bet-table-wrap"><table><thead><tr><th>Rank</th><th>Player</th><th>Points</th></tr></thead><tbody><% for(const entry of leaders) { %><tr class="<%= user && entry.user && String(entry.user._id) === String(user._id) ? 'bet-own' : '' %>"><td>#<%= entry.rank %></td><td><span class="bet-person"><img alt="" src="<%= entry.user && entry.user.avatar ? 'https://cdn.discordapp.com/avatars/' + encodeURIComponent(entry.user.discordId) + '/' + encodeURIComponent(entry.user.avatar) + '.png' : 'https://cdn.discordapp.com/embed/avatars/0.png' %>"><%= entry.user ? entry.user.username : 'Player' %></span></td><td><strong><%= entry.wealth.toLocaleString('en-GB') %></strong></td></tr><% } %></tbody></table></div><% if(wallet) { %><div class="bet-card bet-own">Your rank: <strong>#<%= ownRank %></strong> · <%= user.username %> · <strong><%= wallet.wealth.toLocaleString('en-GB') %></strong> points</div><% } %><% if(!leaders.length) { %><p>No players</p><% } %><% } %>
<% if(mode === 'error') { %><div class="bet-card" role="alert"><h2>Action failed</h2><p><%= message %></p><a href="/bets">Back to events</a><% if(isAdmin) { %> · <a href="/bets/admin">Manage Bets</a><% } %></div><% } %>
</section><script src="/betting.js" defer></script><%- include('../partials/footer') %>
