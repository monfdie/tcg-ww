<%- include('../partials/header') %>
<div class="page-container" style="max-width: 800px;">
    <h2>Edit Tournament</h2>
    <form action="/admin/edit/<%= tour._id %>" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 15px;">
        
        <label style="color: #fff;"><input type="checkbox" name="isMine" <%= tour.isMine ? 'checked' : '' %>> Is this "My" Tournament?</label>

        <input type="text" name="title" value="<%= tour.title %>" placeholder="Title" required class="form-input">
        <input type="text" name="slug" value="<%= tour.slug %>" placeholder="Slug" required class="form-input">
        
        <div style="display: flex; gap: 15px;">
            <input type="text" name="date" value="<%= tour.date %>" placeholder="Date" class="form-input" style="flex: 1;">
            <input type="text" name="prize" value="<%= tour.prize %>" placeholder="Prize Pool" class="form-input" style="flex: 1;">
        </div>

        <div style="display: flex; gap: 15px;">
            <select name="region" class="form-input" style="flex: 1;">
                <option value="Global" <%= tour.region === 'Global' ? 'selected' : '' %>>Global</option>
                <option value="EU" <%= tour.region === 'EU' ? 'selected' : '' %>>EU</option>
                <option value="AS" <%= tour.region === 'AS' ? 'selected' : '' %>>AS</option>
                <option value="NA" <%= tour.region === 'NA' ? 'selected' : '' %>>NA</option>
            </select>
            <select name="format" class="form-input" style="flex: 1;">
                <option value="Draft" <%= tour.format === 'Draft' ? 'selected' : '' %>>Draft</option>
                <option value="All Pick" <%= tour.format === 'All Pick' ? 'selected' : '' %>>All Pick</option>
            </select>
        </div>

        <textarea name="description" placeholder="Description" class="form-input" rows="4"><%= tour.description || '' %></textarea>

        <h4 style="margin-bottom: 0; color: #4facfe;">Links</h4>
        <input type="text" name="regLink" value="<%= tour.regLink || '' %>" placeholder="Registration Link" class="form-input">
        <input type="text" name="bracketLink" value="<%= tour.bracketLink || '' %>" placeholder="Bracket Link" class="form-input">
        <div style="display: flex; gap: 15px;">
            <input type="text" name="rulesLink" value="<%= tour.rulesLink || '' %>" placeholder="Rules (RU) Link" class="form-input" style="flex: 1;">
            <input type="text" name="rulesEnLink" value="<%= tour.rulesEnLink || '' %>" placeholder="Rules (EN) Link" class="form-input" style="flex: 1;">
        </div>
        <div style="display: flex; gap: 15px;">
            <input type="text" name="discordLink" value="<%= tour.discordLink || '' %>" placeholder="Discord" class="form-input" style="flex: 1;">
            <input type="text" name="telegramLink" value="<%= tour.telegramLink || '' %>" placeholder="Telegram" class="form-input" style="flex: 1;">
        </div>

        <label style="color: #8da4c4;">New Banner Image (Leave empty to keep current):</label>
        <input type="file" name="image" class="form-input" style="color: #fff;">

        <hr style="border-color: #333; margin: 20px 0;">
        
        <h3 style="color: #d4af37;">Matches (For "My" Tournaments)</h3>
        <div id="matches-container" style="display: flex; flex-direction: column; gap: 10px;">
            <% if(tour.matches && tour.matches.length > 0) { %>
                <% tour.matches.forEach((m, idx) => { %>
                    <div class="match-row" style="display: flex; gap: 10px;">
                        <input type="text" name="matchStage" value="<%= m.stage %>" placeholder="Stage (e.g. 1/8)" class="form-input" style="width: 100px;" required>
                        <input type="text" name="matchTitle" value="<%= m.title %>" placeholder="Match Title (P1 vs P2)" class="form-input" style="flex: 1;" required>
                        <input type="text" name="matchRoomId" value="<%= m.roomId %>" placeholder="Room ID" class="form-input" style="width: 150px;" required>
                        <button type="button" onclick="this.parentElement.remove()" style="background: #ff4444; color: white; border: none; padding: 0 15px; border-radius: 4px; cursor:pointer;">X</button>
                    </div>
                <% }) %>
            <% } %>
        </div>
        <button type="button" onclick="addMatchRow()" style="background: #2a3454; border: 1px dashed #4facfe; padding: 10px; color: #4facfe; cursor: pointer; border-radius: 4px; margin-top: 10px;">+ Add Match</button>

        <button type="submit" style="background: #4facfe; border: none; padding: 15px; color: #000; font-weight: bold; border-radius: 4px; cursor: pointer; margin-top: 30px;">SAVE CHANGES</button>
    </form>
</div>

<script>
    function addMatchRow() {
        const container = document.getElementById('matches-container');
        const row = document.createElement('div');
        row.className = 'match-row';
        row.style.cssText = 'display: flex; gap: 10px;';
        row.innerHTML = `
            <input type="text" name="matchStage" placeholder="Stage (1/8, Final)" class="form-input" style="width: 100px;" required>
            <input type="text" name="matchTitle" placeholder="Title (P1 vs P2)" class="form-input" style="flex: 1;" required>
            <input type="text" name="matchRoomId" placeholder="Room ID" class="form-input" style="width: 150px;" required>
            <button type="button" onclick="this.parentElement.remove()" style="background: #ff4444; color: white; border: none; padding: 0 15px; border-radius: 4px; cursor:pointer;">X</button>
        `;
        container.appendChild(row);
    }
</script>

<style> .form-input { padding: 12px; border-radius: 4px; border: 1px solid #3c4566; background: rgba(0,0,0,0.3); color: #fff; font-family: 'Segoe UI', sans-serif; } </style>
<%- include('../partials/footer') %>
