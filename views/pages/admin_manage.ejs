<%- include('../partials/header') %>

<style>
    .groups-panel { background: #151822; padding: 20px; border-radius: 8px; margin-top: 30px; border: 1px solid #2a2e40; }
    .group-card { background: #1b1e2b; border: 1px solid #2a2e40; padding: 15px; border-radius: 8px; margin-bottom: 20px; }
    
    .deck-slot { width: 35px; height: 35px; background: #0b0d14; border: 1px solid #3c445c; display: inline-block; cursor: pointer; border-radius: 4px; overflow: hidden; vertical-align: middle; margin-right: 2px;}
    .deck-slot img { width: 100%; height: 100%; object-fit: cover; }
    .deck-slot:hover { border-color: #00d2ff; }
    .deck-container { margin-bottom: 5px; }
    
    .table-dark th { color: #8fa0c9; font-weight: normal; font-size: 12px; border-bottom: 1px solid #2a2e40; }
    .player-input { background: #0b0d14; border: 1px solid #3c445c; color: white; border-radius: 4px; padding: 4px 8px; font-size: 14px; width: 100%; }
    .player-input:focus { outline: none; border-color: #00d2ff; }
    .num-input { width: 50px; text-align: center; }
    
    .btn-tcg { padding: 8px 16px; border-radius: 4px; cursor: pointer; font-weight: bold; text-transform: uppercase; font-size: 13px; transition: 0.2s; border: none; }
    .btn-tcg-save { background: #0066cc; color: #fff; }
    .btn-tcg-save:hover { background: #0052a3; }
    .btn-tcg-add { background: #1a3a2a; border: 1px solid #00ff88; color: #00ff88; }
    .btn-tcg-add:hover { background: #00ff88; color: #000; }
    .btn-tcg-copy { background: #3a2a1a; border: 1px solid #ffcc00; color: #ffcc00; }
    .btn-tcg-copy:hover { background: #ffcc00; color: #000; }
    .btn-tcg-del { background: transparent; border: 1px solid #ff4444; color: #ff4444; padding: 4px 10px; font-size: 12px; }
    .btn-tcg-del:hover { background: #ff4444; color: #fff; }
    
    .stage-tabs { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid #2a2e40; padding-bottom: 10px; }
    .stage-tab { background: transparent; border: 1px solid #3c445c; color: #8fa0c9; padding: 8px 20px; border-radius: 20px; cursor: pointer; font-weight: bold; }
    .stage-tab.active { border-color: #00d2ff; color: #00d2ff; background: rgba(0, 210, 255, 0.1); }
    
    #charModal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.8); }
    .char-modal-content { background-color: #1b1e2b; margin: 5% auto; padding: 20px; border: 1px solid #3c445c; border-radius: 8px; width: 90%; max-width: 800px; color: white; max-height: 80vh; overflow-y: auto; }
    .char-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(60px, 1fr)); gap: 10px; margin-top: 15px; }
    .char-item { width: 60px; height: 60px; cursor: pointer; border: 2px solid transparent; border-radius: 4px; overflow: hidden; transition: 0.2s; position: relative;}
    .char-item img { width: 100%; height: 100%; object-fit: cover; }
    .char-item.selected { border-color: #00ff88; box-shadow: 0 0 10px #00ff88; }
    .char-item.selected::after { content: '✓'; position: absolute; top: 0; right: 0; background: #00ff88; color: black; font-size: 12px; padding: 0 4px; font-weight: bold; }
    .selected-deck-preview { display: flex; gap: 10px; justify-content: center; margin-bottom: 15px; background: #0b0d14; padding: 15px; border-radius: 8px;}
    .preview-slot { width: 60px; height: 60px; border: 1px dashed #4e5a7e; border-radius: 4px; overflow: hidden; }
</style>

<div class="container mt-5 mb-5">
    <h2>Edit Tournament: <%= tour.title %></h2>
    <hr>
    
    <!-- General Settings Form -->
    <form action="/admin/edit/<%= tour._id %>" method="POST" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Title</label><input type="text" name="title" class="player-input" value="<%= tour.title %>" required></div>
            <div class="col-md-6 mb-3"><label class="form-label">Slug (URL)</label><input type="text" name="slug" class="player-input" value="<%= tour.slug %>" required></div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3"><label class="form-label">Date</label><input type="text" name="date" class="player-input" value="<%= tour.date %>"></div>
            <div class="col-md-4 mb-3"><label class="form-label">Prize</label><input type="text" name="prize" class="player-input" value="<%= tour.prize %>"></div>
            <div class="col-md-4 mb-3"><label class="form-label">Region</label><input type="text" name="region" class="player-input" value="<%= tour.region %>"></div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Format</label><input type="text" name="format" class="player-input" value="<%= tour.format %>"></div>
            <div class="col-md-6 mb-3"><label class="form-label">Image (Upload new to replace)</label><input type="file" name="image" class="player-input" accept="image/*"></div>
        </div>
        <div class="mb-3"><label class="form-label">Description</label><textarea name="description" class="player-input" rows="4"><%= tour.description %></textarea></div>
        <h4 class="mt-4">Links</h4>
        <div class="row">
            <div class="col-md-4 mb-3"><label class="form-label">Registration</label><input type="text" name="regLink" class="player-input" value="<%= tour.regLink %>"></div>
            <div class="col-md-4 mb-3"><label class="form-label">Rules (RU)</label><input type="text" name="rulesLink" class="player-input" value="<%= tour.rulesLink %>"></div>
            <div class="col-md-4 mb-3"><label class="form-label">Rules (EN)</label><input type="text" name="rulesEnLink" class="player-input" value="<%= tour.rulesEnLink %>"></div>
            <div class="col-md-4 mb-3"><label class="form-label">Discord</label><input type="text" name="discordLink" class="player-input" value="<%= tour.discordLink %>"></div>
            <div class="col-md-4 mb-3"><label class="form-label">Telegram</label><input type="text" name="telegramLink" class="player-input" value="<%= tour.telegramLink %>"></div>
            <div class="col-md-4 mb-3"><label class="form-label">Bracket</label><input type="text" name="bracketLink" class="player-input" value="<%= tour.bracketLink %>"></div>
        </div>
        <div class="row mb-4 mt-2">
            <div class="col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="isMine" id="isMine" <%= tour.isMine ? 'checked' : '' %>><label class="form-check-label" for="isMine">Is My Tournament</label></div></div>
            <div class="col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="isLive" id="isLive" <%= tour.isLive ? 'checked' : '' %>><label class="form-check-label" for="isLive">Is Live</label></div></div>
        </div>
        <button type="submit" class="btn-tcg btn-tcg-save">💾 Save General Settings</button>
    </form>

    <div class="groups-panel">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="m-0 text-info">Group Stages Editor</h3>
            <button class="btn-tcg btn-tcg-save" onclick="saveGroupsToDB()">💾 Save Groups Data</button>
        </div>

        <div class="stage-tabs">
            <button class="stage-tab active" onclick="switchStage(1)" id="tab-stage-1">Stage 1</button>
            <button class="stage-tab" onclick="switchStage(2)" id="tab-stage-2">Stage 2</button>
        </div>

        <div class="mb-4 d-flex gap-2">
            <button class="btn-tcg btn-tcg-add" onclick="addGroup()">+ Add New Group</button>
            <button class="btn-tcg btn-tcg-copy" onclick="duplicateToStage2()" id="btn-duplicate" style="display:none;">Copy Rosters to Stage 2</button>
        </div>

        <div id="groups-container"></div>
    </div>
</div>

<div id="charModal">
    <div class="char-modal-content">
        <h4 class="mb-3 text-center">Select 3 Characters</h4>
        <div class="selected-deck-preview">
            <div class="preview-slot" id="prev-0"></div>
            <div class="preview-slot" id="prev-1"></div>
            <div class="preview-slot" id="prev-2"></div>
        </div>
        <div class="text-center mb-3">
            <button class="btn-tcg btn-tcg-save" onclick="confirmDeckSelection()">Confirm</button>
            <button class="btn-tcg" style="background:#4e5a7e;" onclick="closeCharModal()">Cancel</button>
            <button class="btn-tcg btn-tcg-del" onclick="clearDeckSelection()">Clear</button>
        </div>
        <input type="text" class="player-input mb-3" id="charSearch" placeholder="Search character..." onkeyup="filterChars()">
        
        <div class="char-grid" id="modalCharGrid">
            <% 
            const allChars = [];
            Object.values(chars).forEach(elementArr => {
                elementArr.forEach(c => allChars.push(c));
            });
            allChars.sort((a,b) => a.name.localeCompare(b.name));
            allChars.forEach(c => { 
                let charImg = c.image || c.avatar || c.icon || `https://gi-tcg-assets.s3.eu-north-1.amazonaws.com/${c.id}.webp`;
            %>
                <div class="char-item" data-id="<%= c.id %>" data-name="<%= c.name.toLowerCase() %>" onclick="toggleCharSelect('<%= c.id %>', this)">
                    <img src="<%= charImg %>" title="<%= c.name %>" onerror="this.src='/logo.png'">
                </div>
            <% }); %>
        </div>
    </div>
</div>

<script>
    // Массив изображений из вашего characters.json для JS
    const charImages = {};
    <% allChars.forEach(c => { 
        let charImg = c.image || c.avatar || c.icon || `https://gi-tcg-assets.s3.eu-north-1.amazonaws.com/${c.id}.webp`;
    %>
        charImages['<%= c.id %>'] = '<%= charImg %>';
    <% }); %>

    let currentStage = 1;
    let tournamentData = <%- JSON.stringify(tour.groups || []) %>;
    let editingContext = { groupIdx: -1, playerIdx: -1, deckIdx: -1 };
    let currentSelection = [];

    function renderGroups() {
        const container = document.getElementById('groups-container');
        container.innerHTML = '';
        const stageGroups = tournamentData.filter(g => g.stage === currentStage);
        
        if (stageGroups.length === 0) {
            container.innerHTML = '<p class="text-muted py-4">No groups in this stage.</p>';
            return;
        }

        stageGroups.forEach(group => {
            const realGroupIdx = tournamentData.findIndex(g => g === group);
            
            let html = `
            <div class="group-card">
                <div class="d-flex justify-content-between mb-3">
                    <input type="text" class="player-input" style="width: 250px; font-weight: bold; font-size: 16px; color:#00d2ff; border-color:#00d2ff;" 
                           value="${group.name}" onchange="updateGroupData(${realGroupIdx}, 'name', this.value)">
                    <button class="btn-tcg btn-tcg-del" onclick="deleteGroup(${realGroupIdx})">Delete Group</button>
                </div>
                
                <table class="table table-dark table-borderless mb-0">
                    <thead>
                        <tr>
                            <th width="20%">PLAYER</th>
                            <th width="8%" class="text-center">PTS</th>
                            <th width="8%" class="text-center">W</th>
                            <th width="8%" class="text-center">D</th>
                            <th width="8%" class="text-center">L</th>
                            <th width="48%">DECKS (Click to edit)</th>
                        </tr>
                    </thead>
                    <tbody>`;
            
            group.players.forEach((player, pIdx) => {
                let pts = (Number(player.wins) || 0) * 3 + (Number(player.draws) || 0);
                
                html += `
                        <tr>
                            <td><input type="text" class="player-input" value="${player.name || ''}" placeholder="Player ${pIdx+1}" onchange="updatePlayer(${realGroupIdx}, ${pIdx}, 'name', this.value)"></td>
                            <td class="text-center align-middle" style="color: #ffcc00; font-weight: bold; font-size: 16px;">${pts}</td>
                            <td><input type="number" class="player-input num-input" value="${player.wins || 0}" min="0" onchange="updatePlayer(${realGroupIdx}, ${pIdx}, 'wins', this.value)"></td>
                            <td><input type="number" class="player-input num-input" value="${player.draws || 0}" min="0" onchange="updatePlayer(${realGroupIdx}, ${pIdx}, 'draws', this.value)"></td>
                            <td><input type="number" class="player-input num-input" value="${player.losses || 0}" min="0" onchange="updatePlayer(${realGroupIdx}, ${pIdx}, 'losses', this.value)"></td>
                            <td>`;
                
                for (let dIdx = 0; dIdx < 4; dIdx++) {
                    let deck = player.decks && player.decks[dIdx] ? player.decks[dIdx] : [];
                    html += `<div class="deck-container d-inline-block me-3">`;
                    for (let cIdx = 0; cIdx < 3; cIdx++) {
                        let charId = deck[cIdx];
                        if (charId) {
                            let imgUrl = charImages[charId] || '/logo.png';
                            html += `<div class="deck-slot" onclick="openDeckEditor(${realGroupIdx}, ${pIdx}, ${dIdx})">
                                        <img src="${imgUrl}" onerror="this.src='/logo.png'">
                                     </div>`;
                        } else {
                            html += `<div class="deck-slot" onclick="openDeckEditor(${realGroupIdx}, ${pIdx}, ${dIdx})"></div>`;
                        }
                    }
                    html += `</div>`;
                }
                html += `</td></tr>`;
            });

            html += `</tbody></table></div>`;
            container.innerHTML += html;
        });
    }

    function switchStage(stage) {
        currentStage = stage;
        document.getElementById('tab-stage-1').classList.toggle('active', stage === 1);
        document.getElementById('tab-stage-2').classList.toggle('active', stage === 2);
        document.getElementById('btn-duplicate').style.display = stage === 1 ? 'inline-block' : 'none';
        renderGroups();
    }

    function addGroup() {
        tournamentData.push({
            name: 'New Group', stage: currentStage,
            players: [
                { name: '', wins: 0, draws: 0, losses: 0, decks: [[],[],[],[]] },
                { name: '', wins: 0, draws: 0, losses: 0, decks: [[],[],[],[]] },
                { name: '', wins: 0, draws: 0, losses: 0, decks: [[],[],[],[]] },
                { name: '', wins: 0, draws: 0, losses: 0, decks: [[],[],[],[]] }
            ]
        });
        renderGroups();
    }

    function deleteGroup(idx) {
        if(confirm('Are you sure?')) { tournamentData.splice(idx, 1); renderGroups(); }
    }

    function updateGroupData(idx, field, value) { tournamentData[idx][field] = value; }

    function updatePlayer(gIdx, pIdx, field, value) {
        if(field === 'name') tournamentData[gIdx].players[pIdx].name = value;
        else { tournamentData[gIdx].players[pIdx][field] = parseInt(value) || 0; renderGroups(); }
    }

    function duplicateToStage2() {
        if(!confirm('Copy Stage 1 groups to Stage 2 (clearing scores and decks)?')) return;
        tournamentData = tournamentData.filter(g => g.stage !== 2);
        const stage1Groups = tournamentData.filter(g => g.stage === 1);
        stage1Groups.forEach(g => {
            const newGroup = JSON.parse(JSON.stringify(g));
            newGroup.stage = 2; newGroup._id = undefined;
            newGroup.players.forEach(p => { p._id = undefined; p.wins = 0; p.draws = 0; p.losses = 0; p.points = 0; p.decks = [[], [], [], []]; });
            tournamentData.push(newGroup);
        });
        switchStage(2);
    }

    const modal = document.getElementById('charModal');
    
    function openDeckEditor(gIdx, pIdx, dIdx) {
        editingContext = { groupIdx: gIdx, playerIdx: pIdx, deckIdx: dIdx };
        currentSelection = [...(tournamentData[gIdx].players[pIdx].decks[dIdx] || [])];
        updateModalVisuals(); modal.style.display = 'block';
    }

    function closeCharModal() { modal.style.display = 'none'; }

    function toggleCharSelect(charId, elem) {
        const idx = currentSelection.indexOf(charId);
        if (idx > -1) currentSelection.splice(idx, 1);
        else if (currentSelection.length < 3) currentSelection.push(charId);
        updateModalVisuals();
    }

    function updateModalVisuals() {
        document.querySelectorAll('.char-item').forEach(el => {
            el.classList.toggle('selected', currentSelection.includes(el.dataset.id));
        });
        for(let i=0; i<3; i++) {
            const slot = document.getElementById('prev-'+i);
            if (currentSelection[i]) {
                let imgUrl = charImages[currentSelection[i]] || '/logo.png';
                slot.innerHTML = `<img src="${imgUrl}" style="width:100%; height:100%; object-fit:cover;" onerror="this.src='/logo.png'">`;
            } else {
                slot.innerHTML = '';
            }
        }
    }

    function clearDeckSelection() { currentSelection = []; updateModalVisuals(); }

    function confirmDeckSelection() {
        tournamentData[editingContext.groupIdx].players[editingContext.playerIdx].decks[editingContext.deckIdx] = [...currentSelection];
        closeCharModal(); renderGroups();
    }

    function filterChars() {
        const term = document.getElementById('charSearch').value.toLowerCase();
        document.querySelectorAll('.char-item').forEach(el => { el.style.display = el.dataset.name.includes(term) ? 'block' : 'none'; });
    }

    async function saveGroupsToDB() {
        const btns = document.querySelectorAll('.btn-tcg-save');
        btns.forEach(b => { b.innerHTML = 'Saving...'; b.disabled = true; });
        try {
            const res = await fetch('/admin/edit-groups/<%= tour._id %>', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ groups: tournamentData }) });
            if((await res.json()).success) alert('Groups saved!');
            else alert('Error saving groups');
        } catch (e) { alert('Server error'); } 
        finally { btns.forEach(b => { b.innerHTML = '💾 Save Groups Data'; b.disabled = false; }); }
    }

    switchStage(1);
</script>

<%- include('../partials/footer') %>
