<%- include('../partials/header') %>

<style>
    .groups-panel { background: #151822; padding: 20px; border-radius: 8px; margin-top: 30px; border: 1px solid #2a2e40; }
    
    /* КОМПАКТНЫЕ ГРУППЫ: уменьшены отступы */
    .group-card { background: #1b1e2b; border: 1px solid #2a2e40; padding: 12px 20px; border-radius: 8px; margin-bottom: 15px; }
    
    /* КРУГЛЫЕ ИКОНКИ: убран фон и рамки контейнера, скругление на самой картинке */
    .deck-slot { width: 40px; height: 40px; background: transparent; border: none; display: inline-block; cursor: pointer; border-radius: 50%; overflow: hidden; flex-shrink: 0;}
    .deck-slot img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 1px solid #3c445c; transition: 0.2s; }
    .deck-slot:hover img { border-color: #00d2ff; }
    
    /* КРАСНАЯ КНОПКА УДАЛЕНИЯ */
    .btn-delete-group { background-color: #d32f2f !important; color: #ffffff !important; border: 1px solid #b71c1c !important; font-weight: bold; border-radius: 4px; padding: 6px 12px; font-size: 13px; text-transform: uppercase; cursor: pointer; transition: 0.2s; }
    .btn-delete-group:hover { background-color: #b71c1c !important; }

    .player-input { background: #0b0d14; border: 1px solid #3c445c; color: white; border-radius: 4px; padding: 6px 10px; font-size: 14px; width: 100%; }
    .player-input:focus { outline: none; border-color: #00d2ff; }
    .num-input { text-align: center; }
    
    .btn-tcg { padding: 8px 16px; border-radius: 4px; cursor: pointer; font-weight: bold; text-transform: uppercase; font-size: 13px; transition: 0.2s; border: none; }
    .btn-tcg-save { background: #0066cc; color: #fff; }
    .btn-tcg-save:hover { background: #0052a3; }
    .btn-tcg-add { background: #1a3a2a; border: 1px solid #00ff88; color: #00ff88; }
    .btn-tcg-add:hover { background: #00ff88; color: #000; }
    .btn-tcg-copy { background: #3a2a1a; border: 1px solid #ffcc00; color: #ffcc00; }
    .btn-tcg-copy:hover { background: #ffcc00; color: #000; }
    
    .stage-tabs { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid #2a2e40; padding-bottom: 10px; }
    .stage-tab { background: transparent; border: 1px solid #3c445c; color: #8fa0c9; padding: 8px 20px; border-radius: 20px; cursor: pointer; font-weight: bold; }
    .stage-tab.active { border-color: #00d2ff; color: #00d2ff; background: rgba(0, 210, 255, 0.1); }
    
    /* ЖЕСТКАЯ МОДАЛКА */
    #charModal { display: none; position: fixed; z-index: 99999; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.85); overflow: auto; }
    .char-modal-content { background-color: #1b1e2b; margin: 5% auto; padding: 25px; border: 1px solid #3c445c; border-radius: 8px; width: 90%; max-width: 900px; color: white; box-shadow: 0 10px 30px rgba(0,0,0,0.7); }
    .char-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(70px, 1fr)); gap: 12px; margin-top: 15px; max-height: 50vh; overflow-y: auto; padding-right: 10px; }
    .char-item { width: 70px; height: 70px; cursor: pointer; border: 2px solid #3c445c; border-radius: 6px; overflow: hidden; transition: 0.2s; position: relative; background: #0b0d14;}
    .char-item img { width: 100%; height: 100%; object-fit: cover; }
    .char-item.selected { border-color: #00ff88; box-shadow: 0 0 12px rgba(0, 255, 136, 0.4); transform: scale(1.05); }
    .char-item.selected::after { content: '✓'; position: absolute; top: 2px; right: 2px; background: #00ff88; color: black; font-size: 14px; padding: 2px 6px; font-weight: bold; border-radius: 4px; }
    .selected-deck-preview { display: flex; gap: 15px; justify-content: center; margin-bottom: 20px; background: #0b0d14; padding: 20px; border-radius: 8px; border: 1px solid #2a2e40;}
    .preview-slot { width: 70px; height: 70px; border: 2px dashed #4e5a7e; border-radius: 6px; overflow: hidden; background: #151822; }
</style>

<div class="container mt-5 mb-5">
    <h2 style="color: white;">Edit Tournament: <span style="color: #00d2ff;"><%= tour.title %></span></h2>
    <hr style="border-color: #2a2e40;">
    
    <form action="/admin/edit/<%= tour._id %>" method="POST" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label text-white">Title</label><input type="text" name="title" class="player-input" value="<%= tour.title %>" required></div>
            <div class="col-md-6 mb-3"><label class="form-label text-white">Slug (URL)</label><input type="text" name="slug" class="player-input" value="<%= tour.slug %>" required></div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3"><label class="form-label text-white">Date</label><input type="text" name="date" class="player-input" value="<%= tour.date %>"></div>
            <div class="col-md-4 mb-3"><label class="form-label text-white">Prize</label><input type="text" name="prize" class="player-input" value="<%= tour.prize %>"></div>
            <div class="col-md-4 mb-3"><label class="form-label text-white">Region</label><input type="text" name="region" class="player-input" value="<%= tour.region %>"></div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label text-white">Format</label><input type="text" name="format" class="player-input" value="<%= tour.format %>"></div>
            <div class="col-md-6 mb-3"><label class="form-label text-white">Image (Upload new to replace)</label><input type="file" name="image" class="player-input" accept="image/*"></div>
        </div>
        <div class="mb-3"><label class="form-label text-white">Description</label><textarea name="description" class="player-input" rows="4"><%= tour.description %></textarea></div>
        <h4 class="mt-4 text-white">Links</h4>
        <div class="row">
            <div class="col-md-4 mb-3"><label class="form-label text-white">Registration</label><input type="text" name="regLink" class="player-input" value="<%= tour.regLink %>"></div>
            <div class="col-md-4 mb-3"><label class="form-label text-white">Rules (RU)</label><input type="text" name="rulesLink" class="player-input" value="<%= tour.rulesLink %>"></div>
            <div class="col-md-4 mb-3"><label class="form-label text-white">Rules (EN)</label><input type="text" name="rulesEnLink" class="player-input" value="<%= tour.rulesEnLink %>"></div>
            <div class="col-md-4 mb-3"><label class="form-label text-white">Discord</label><input type="text" name="discordLink" class="player-input" value="<%= tour.discordLink %>"></div>
            <div class="col-md-4 mb-3"><label class="form-label text-white">Telegram</label><input type="text" name="telegramLink" class="player-input" value="<%= tour.telegramLink %>"></div>
            <div class="col-md-4 mb-3"><label class="form-label text-white">Bracket</label><input type="text" name="bracketLink" class="player-input" value="<%= tour.bracketLink %>"></div>
        </div>
        <div class="row mb-4 mt-2">
            <div class="col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="isMine" id="isMine" <%= tour.isMine ? 'checked' : '' %>><label class="form-check-label text-white" for="isMine">Is My Tournament</label></div></div>
            <div class="col-md-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="isLive" id="isLive" <%= tour.isLive ? 'checked' : '' %>><label class="form-check-label text-white" for="isLive">Is Live</label></div></div>
        </div>
        <button type="submit" class="btn-tcg btn-tcg-save">💾 Save General Settings</button>
    </form>

    <div class="groups-panel">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="m-0 text-info">Group Stages Editor</h3>
            <button class="btn-tcg btn-tcg-save" onclick="saveGroupsToDB()">💾 Save Groups Data</button>
        </div>

        <div class="stage-tabs">
            <button class="stage-tab active" onclick="switchStage(1)" id="tab-stage-1">Stage 1</button>
            <button class="stage-tab" onclick="switchStage(2)" id="tab-stage-2">Stage 2</button>
        </div>

        <div class="mb-4 d-flex gap-2">
            <button class="btn-tcg btn-tcg-add" onclick="addGroup()">+ Add New Group</button>
            <button class="btn-tcg btn-tcg-copy" onclick="duplicateToStage2()" id="btn-duplicate" style="display:none;">Copy Rosters to Stage 2</button>
        </div>

        <div id="groups-container"></div>
    </div>
</div>

<div id="charModal">
    <div class="char-modal-content">
        <h3 class="mb-4 text-center" style="color: #00d2ff; font-weight: bold;">Select 3 Characters</h3>
        <div class="selected-deck-preview">
            <div class="preview-slot" id="prev-0"></div>
            <div class="preview-slot" id="prev-1"></div>
            <div class="preview-slot" id="prev-2"></div>
        </div>
        <div class="text-center mb-4 d-flex justify-content-center gap-3">
            <button class="btn btn-success px-4 fw-bold" onclick="confirmDeckSelection()">Confirm</button>
            <button class="btn btn-secondary px-4 fw-bold" onclick="closeCharModal()">Cancel</button>
            <button class="btn btn-danger px-4 fw-bold" onclick="clearDeckSelection()">Clear</button>
        </div>
        <input type="text" class="form-control bg-dark text-white mb-3 border-secondary" id="charSearch" placeholder="Search character..." onkeyup="filterChars()">
        
        <div class="char-grid" id="modalCharGrid">
            <% 
            const allChars = [];
            Object.values(chars).forEach(elementArr => {
                elementArr.forEach(c => allChars.push(c));
            });
            allChars.sort((a,b) => a.name.localeCompare(b.name));
            allChars.forEach(c => { 
                let charImg = c.img || `/cardback.png`;
            %>
                <div class="char-item" data-id="<%= c.id %>" data-name="<%= c.name.toLowerCase() %>" onclick="toggleCharSelect('<%= c.id %>', this)">
                    <img src="<%= charImg %>" title="<%= c.name %>" onerror="this.src='/cardback.png'">
                </div>
            <% }); %>
        </div>
    </div>
</div>

<script>
    // Массив изображений персонажей для скрипта (считывает c.img)
    const charImages = {};
    <% allChars.forEach(c => { 
        let charImg = c.img || `/cardback.png`;
    %>
        charImages['<%= c.id %>'] = '<%= charImg %>';
    <% }); %>

    let currentStage = 1;
    let tournamentData = <%- JSON.stringify(tour.groups || []) %>;
    let editingContext = { groupIdx: -1, playerIdx: -1, deckIdx: -1 };
    let currentSelection = [];

    function renderGroups() {
        const container = document.getElementById('groups-container');
        container.innerHTML = '';
        const stageGroups = tournamentData.filter(g => g.stage === currentStage);
        
        if (stageGroups.length === 0) {
            container.innerHTML = '<p class="text-muted py-4 text-center">No groups in this stage.</p>';
            return;
        }

        stageGroups.forEach(group => {
            const realGroupIdx = tournamentData.findIndex(g => g === group);
            
            let html = `
            <div class="group-card">
                <div class="d-flex justify-content-between mb-3">
                    <input type="text" class="player-input" style="width: 250px; font-weight: bold; font-size: 16px; color:#00d2ff; border-color:#00d2ff;" 
                           value="${group.name}" onchange="updateGroupData(${realGroupIdx}, 'name', this.value)">
                    <button class="btn-delete-group" onclick="deleteGroup(${realGroupIdx})">Delete Group</button>
                </div>
                
                <table style="width: 100%; table-layout: fixed; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 2px solid #3c445c; color: #8fa0c9; font-size: 14px;">
                            <th style="width: 250px; padding: 8px 10px; text-align: left;">PLAYER</th>
                            <th style="width: 70px; text-align: center;">PTS</th>
                            <th style="width: 70px; text-align: center;">W</th>
                            <th style="width: 70px; text-align: center;">D</th>
                            <th style="width: 70px; text-align: center;">L</th>
                            <th style="padding: 8px 10px; text-align: left;">DECKS (Click to edit)</th>
                        </tr>
                    </thead>
                    <tbody>`;
            
            group.players.forEach((player, pIdx) => {
                let pts = (Number(player.wins) || 0) * 3 + (Number(player.draws) || 0);
                
                html += `
                        <tr style="border-bottom: 1px solid #2a2e40;">
                            <td style="padding: 8px 10px;">
                                <input type="text" class="player-input" value="${player.name || ''}" placeholder="Player ${pIdx+1}" onchange="updatePlayer(${realGroupIdx}, ${pIdx}, 'name', this.value)">
                            </td>
                            <td style="text-align: center; color: #ffcc00; font-weight: bold; font-size: 18px;">${pts}</td>
                            <td style="text-align: center; padding: 6px;"><input type="number" class="player-input num-input" value="${player.wins || 0}" min="0" onchange="updatePlayer(${realGroupIdx}, ${pIdx}, 'wins', this.value)"></td>
                            <td style="text-align: center; padding: 6px;"><input type="number" class="player-input num-input" value="${player.draws || 0}" min="0" onchange="updatePlayer(${realGroupIdx}, ${pIdx}, 'draws', this.value)"></td>
                            <td style="text-align: center; padding: 6px;"><input type="number" class="player-input num-input" value="${player.losses || 0}" min="0" onchange="updatePlayer(${realGroupIdx}, ${pIdx}, 'losses', this.value)"></td>
                            <td style="padding: 8px 10px;">
                                <div style="display: flex; flex-wrap: wrap; gap: 10px; align-items: center;">`;
                
                for (let dIdx = 0; dIdx < 4; dIdx++) {
                    let deck = player.decks && player.decks[dIdx] ? player.decks[dIdx] : [];
                    html += `<div style="display: flex; flex-direction: row; gap: 4px; background: transparent; padding: 0; border: none;">`;
                    for (let cIdx = 0; cIdx < 3; cIdx++) {
                        let charId = deck[cIdx];
                        if (charId) {
                            let imgUrl = charImages[charId] || '/cardback.png';
                            html += `<div class="deck-slot" onclick="openDeckEditor(${realGroupIdx}, ${pIdx}, ${dIdx})">
                                        <img src="${imgUrl}" onerror="this.src='/cardback.png'">
                                     </div>`;
                        } else {
                            html += `<div class="deck-slot" style="border:1px dashed #4e5a7e;" onclick="openDeckEditor(${realGroupIdx}, ${pIdx}, ${dIdx})">
                                        <img src="/cardback.png" style="opacity: 0.2; border: none;">
                                     </div>`;
                        }
                    }
                    html += `</div>`;
                }
                html += `       </div>
                            </td>
                        </tr>`;
            });

            html += `</tbody></table></div>`;
            container.innerHTML += html;
        });
    }

    function switchStage(stage) {
        currentStage = stage;
        document.getElementById('tab-stage-1').className = stage === 1 ? 'stage-tab active' : 'stage-tab';
        document.getElementById('tab-stage-2').className = stage === 2 ? 'stage-tab active' : 'stage-tab';
        document.getElementById('btn-duplicate').style.display = stage === 1 ? 'inline-block' : 'none';
        renderGroups();
    }

    function addGroup() {
        tournamentData.push({
            name: 'New Group', stage: currentStage,
            players: [
                { name: '', wins: 0, draws: 0, losses: 0, decks: [[],[],[],[]] },
                { name: '', wins: 0, draws: 0, losses: 0, decks: [[],[],[],[]] },
                { name: '', wins: 0, draws: 0, losses: 0, decks: [[],[],[],[]] },
                { name: '', wins: 0, draws: 0, losses: 0, decks: [[],[],[],[]] }
            ]
        });
        renderGroups();
    }

    function deleteGroup(idx) {
        if(confirm('Are you sure you want to delete this group?')) { tournamentData.splice(idx, 1); renderGroups(); }
    }

    function updateGroupData(idx, field, value) { tournamentData[idx][field] = value; }

    function updatePlayer(gIdx, pIdx, field, value) {
        if(field === 'name') tournamentData[gIdx].players[pIdx].name = value;
        else { tournamentData[gIdx].players[pIdx][field] = parseInt(value) || 0; renderGroups(); }
    }

    function duplicateToStage2() {
        if(!confirm('Copy Stage 1 groups to Stage 2 (clearing scores and decks)?')) return;
        tournamentData = tournamentData.filter(g => g.stage !== 2);
        const stage1Groups = tournamentData.filter(g => g.stage === 1);
        stage1Groups.forEach(g => {
            const newGroup = JSON.parse(JSON.stringify(g));
            newGroup.stage = 2; newGroup._id = undefined;
            newGroup.players.forEach(p => { p._id = undefined; p.wins = 0; p.draws = 0; p.losses = 0; p.points = 0; p.decks = [[], [], [], []]; });
            tournamentData.push(newGroup);
        });
        switchStage(2);
    }

    function openDeckEditor(gIdx, pIdx, dIdx) {
        editingContext = { groupIdx: gIdx, playerIdx: pIdx, deckIdx: dIdx };
        currentSelection = [...(tournamentData[gIdx].players[pIdx].decks[dIdx] || [])];
        updateModalVisuals(); document.getElementById('charModal').style.display = 'block';
    }

    function closeCharModal() { document.getElementById('charModal').style.display = 'none'; }

    function toggleCharSelect(charId, elem) {
        const idx = currentSelection.indexOf(charId);
        if (idx > -1) currentSelection.splice(idx, 1);
        else if (currentSelection.length < 3) currentSelection.push(charId);
        updateModalVisuals();
    }

    function updateModalVisuals() {
        document.querySelectorAll('.char-item').forEach(el => {
            el.classList.toggle('selected', currentSelection.includes(el.dataset.id));
        });
        for(let i=0; i<3; i++) {
            const slot = document.getElementById('prev-'+i);
            if (currentSelection[i]) {
                let imgUrl = charImages[currentSelection[i]] || '/cardback.png';
                slot.innerHTML = `<img src="${imgUrl}" style="width:100%; height:100%; object-fit:cover;" onerror="this.src='/cardback.png'">`;
            } else {
                slot.innerHTML = '';
            }
        }
    }

    function clearDeckSelection() { currentSelection = []; updateModalVisuals(); }

    function confirmDeckSelection() {
        tournamentData[editingContext.groupIdx].players[editingContext.playerIdx].decks[editingContext.deckIdx] = [...currentSelection];
        closeCharModal(); renderGroups();
    }

    function filterChars() {
        const term = document.getElementById('charSearch').value.toLowerCase();
        document.querySelectorAll('.char-item').forEach(el => { el.style.display = el.dataset.name.includes(term) ? 'block' : 'none'; });
    }

    async function saveGroupsToDB() {
        const btn = document.querySelector('button[onclick="saveGroupsToDB()"]');
        btn.innerHTML = 'Saving...'; btn.disabled = true;
        try {
            const res = await fetch('/admin/edit-groups/<%= tour._id %>', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ groups: tournamentData }) });
            if((await res.json()).success) alert('Groups saved!');
            else alert('Error saving groups');
        } catch (e) { alert('Server error'); } 
        finally { btn.innerHTML = '💾 Save Groups Data'; btn.disabled = false; }
    }

    switchStage(1);
</script>

<%- include('../partials/footer') %>
