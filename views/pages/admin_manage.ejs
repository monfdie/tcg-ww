<%- include('../partials/header') %>

<style>
    /* Базовые панели */
    .admin-panel {
        background: rgba(16, 25, 45, 0.65);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-top: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
    }

    /* Сетка для групп: 2 в ряд */
    .groups-admin-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .group-card { 
        background: rgba(20, 32, 54, 0.6); 
        border: 1px solid rgba(255, 255, 255, 0.1); 
        padding: 12px 14px; 
        border-radius: 8px; 
        margin-bottom: 0; 
    }

    /* Аккуратные инпуты */
    .player-input { 
        background: rgba(255, 255, 255, 0.05); 
        border: 1px solid rgba(255, 255, 255, 0.15); 
        color: #ffffff; 
        border-radius: 6px; 
        padding: 4px 8px; 
        font-size: 13px; 
        width: 100%;
        transition: border-color 0.2s, background 0.2s;
    }
    .player-input:focus { 
        outline: none; 
        border-color: #00d2ff; 
        background: rgba(0, 210, 255, 0.05);
    }
    .num-input { text-align: center; }

    /* Скрытие стрелочек у числовых инпутов */
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    input[type="number"] {
        -moz-appearance: textfield;
    }

    /* Кнопки порядка */
    .order-btn {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #8fa0c9;
        border-radius: 3px;
        cursor: pointer;
        padding: 0 4px;
        font-size: 9px;
        line-height: 12px;
        transition: 0.15s;
    }
    .order-btn:hover {
        background: rgba(0, 210, 255, 0.2);
        color: #00d2ff;
        border-color: #00d2ff;
    }

    /* Компактные слоты дек */
    .deck-slot { 
        width: 28px; 
        height: 28px; 
        background: transparent; 
        border: none; 
        display: inline-block; 
        cursor: pointer; 
        border-radius: 50%; 
        flex-shrink: 0;
    }
    .deck-slot img { 
        width: 100%; 
        height: 100%; 
        object-fit: cover; 
        border-radius: 50%; 
        border: none; 
        transition: 0.15s; 
        box-shadow: 0 2px 5px rgba(0,0,0,0.5); 
    }
    .deck-slot:hover img { 
        transform: scale(1.15); 
        box-shadow: 0 0 8px rgba(0, 210, 255, 0.6); 
    }
    
    .btn-delete-group { 
        background-color: rgba(211, 47, 47, 0.2) !important; 
        color: #ff8b8b !important; 
        border: 1px solid rgba(211, 47, 47, 0.5) !important; 
        font-weight: 700; 
        border-radius: 6px; 
        padding: 3px 8px; 
        font-size: 11px; 
        text-transform: uppercase; 
        cursor: pointer; 
        transition: 0.2s; 
    }
    .btn-delete-group:hover { 
        background-color: #d32f2f !important; 
        color: #ffffff !important; 
    }

    .btn-tcg { 
        padding: 6px 14px; 
        border-radius: 6px; 
        cursor: pointer; 
        font-weight: 700; 
        text-transform: uppercase; 
        font-size: 12px; 
        transition: 0.2s; 
        border: none; 
    }
    .btn-tcg-save { background: #0088e8; color: #fff; }
    .btn-tcg-save:hover { background: #0066cc; }
    .btn-tcg-add { background: rgba(0, 255, 136, 0.12); border: 1px solid rgba(0, 255, 136, 0.4); color: #00ff88; }
    .btn-tcg-add:hover { background: #00ff88; color: #000; }
    .btn-tcg-copy { background: transparent; border: 1px solid #fbc02d; color: #fbc02d; }
    .btn-tcg-copy:hover { background: rgba(251, 192, 45, 0.1); }
    
    .stage-tabs { display: flex; gap: 8px; margin-bottom: 15px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 10px; }
    .stage-tab { background: transparent; border: 1px solid rgba(255, 255, 255, 0.15); color: #8fa0c9; padding: 5px 14px; border-radius: 6px; cursor: pointer; font-weight: 700; font-size: 12px; }
    .stage-tab.active { border-color: #00d2ff; color: #ffffff; background: rgba(0, 210, 255, 0.2); }
    
    /* Play-offs сетка */
    .playoff-admin-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 15px; grid-column: 1 / -1; }
    .playoff-admin-card { background: rgba(20, 32, 54, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); padding: 12px; border-radius: 8px; }

    /* Аккуратные кастомные тогглы */
    .custom-switch-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        user-select: none;
        margin: 0;
        font-size: 13px;
        color: #d6f2ff;
    }
    .custom-switch-label input {
        appearance: none;
        -webkit-appearance: none;
        width: 36px;
        height: 20px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        position: relative;
        cursor: pointer;
        outline: none;
        transition: background 0.2s, border-color 0.2s;
    }
    .custom-switch-label input::before {
        content: '';
        position: absolute;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        top: 2px;
        left: 2px;
        background: #ffffff;
        transition: transform 0.2s;
    }
    .custom-switch-label input:checked {
        background: rgba(0, 210, 255, 0.35);
        border-color: #00d2ff;
    }
    .custom-switch-label input:checked::before {
        transform: translateX(16px);
        background: #00d2ff;
        box-shadow: 0 0 6px #00d2ff;
    }

    /* Модальное окно */
    #charModal { display: none; position: fixed; z-index: 99999; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.85); overflow: auto; }
    .char-modal-content { background-color: #1b263b; margin: 4% auto; padding: 20px; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; width: 90%; max-width: 850px; color: white; }
    .char-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 10px; margin-top: 15px; max-height: 50vh; overflow-y: auto; padding-right: 8px; }
    .char-item { width: 64px; height: 64px; cursor: pointer; border: 2px solid rgba(255,255,255,0.15); border-radius: 6px; overflow: hidden; position: relative; background: #0b0d14;}
    .char-item img { width: 100%; height: 100%; object-fit: cover; }
    .char-item.selected { border-color: #00ff88; box-shadow: 0 0 10px rgba(0, 255, 136, 0.5); }
    .char-item.selected::after { content: '✓'; position: absolute; top: 2px; right: 2px; background: #00ff88; color: black; font-size: 11px; padding: 1px 4px; font-weight: bold; border-radius: 3px; }
    .selected-deck-preview { display: flex; gap: 12px; justify-content: center; margin-bottom: 15px; background: rgba(0,0,0,0.3); padding: 12px; border-radius: 8px;}
    .preview-slot { width: 60px; height: 60px; border: 2px dashed #4e5a7e; border-radius: 6px; overflow: hidden; background: #151822; }
    
    .m-btn { padding: 6px 18px; font-weight: 700; text-transform: uppercase; border-radius: 4px; cursor: pointer; border: none; font-size: 12px; }
    .m-confirm { background: #00d2ff; color: #000; }
    .m-cancel { background: transparent; color: #ff6b6b; border: 1px solid #ff6b6b; }
    .m-clear { background: #3c445c; color: #fff; }

    @media (max-width: 1100px) {
        .groups-admin-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="container-fluid mt-4 mb-5" style="max-width: 1380px;">
    
    <div class="admin-panel">
        <h4 class="text-white mb-3" style="font-weight: 700;">General Tournament Settings</h4>
        <form action="/admin/edit/<%= tour._id %>" method="POST" enctype="multipart/form-data">
            <div class="row g-2">
                <div class="col-md-6 mb-2">
                    <label class="form-label text-muted small mb-1">Title</label>
                    <input type="text" name="title" class="player-input" value="<%= tour.title %>" required>
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label text-muted small mb-1">Slug (URL)</label>
                    <input type="text" name="slug" class="player-input" value="<%= tour.slug %>" required>
                </div>
            </div>
            
            <div class="row g-2">
                <div class="col-md-3 mb-2">
                    <label class="form-label text-muted small mb-1">Date</label>
                    <input type="text" name="date" class="player-input" value="<%= tour.date %>">
                </div>
                <div class="col-md-3 mb-2">
                    <label class="form-label text-muted small mb-1">Prize</label>
                    <input type="text" name="prize" class="player-input" value="<%= tour.prize %>">
                </div>
                <div class="col-md-3 mb-2">
                    <label class="form-label text-muted small mb-1">Region</label>
                    <input type="text" name="region" class="player-input" value="<%= tour.region %>">
                </div>
                <div class="col-md-3 mb-2">
                    <label class="form-label text-muted small mb-1">Format</label>
                    <input type="text" name="format" class="player-input" value="<%= tour.format %>">
                </div>
            </div>

            <div class="row g-2 mb-2">
                <div class="col-md-6">
                    <label class="form-label text-muted small mb-1">Image (Upload new to replace)</label>
                    <input type="file" name="image" class="player-input" accept="image/*">
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small mb-1">Description</label>
                    <textarea name="description" class="player-input" rows="1"><%= tour.description %></textarea>
                </div>
            </div>

            <div class="row g-2 mt-2">
                <div class="col-md-4 mb-2"><label class="form-label text-muted small mb-1">Registration Link</label><input type="text" name="regLink" class="player-input" value="<%= tour.regLink %>"></div>
                <div class="col-md-4 mb-2"><label class="form-label text-muted small mb-1">Rules (RU)</label><input type="text" name="rulesLink" class="player-input" value="<%= tour.rulesLink %>"></div>
                <div class="col-md-4 mb-2"><label class="form-label text-muted small mb-1">Rules (EN)</label><input type="text" name="rulesEnLink" class="player-input" value="<%= tour.rulesEnLink %>"></div>
                <div class="col-md-4 mb-2"><label class="form-label text-muted small mb-1">Discord</label><input type="text" name="discordLink" class="player-input" value="<%= tour.discordLink %>"></div>
                <div class="col-md-4 mb-2"><label class="form-label text-muted small mb-1">Telegram</label><input type="text" name="telegramLink" class="player-input" value="<%= tour.telegramLink %>"></div>
                <div class="col-md-4 mb-2"><label class="form-label text-muted small mb-1">Bracket</label><input type="text" name="bracketLink" class="player-input" value="<%= tour.bracketLink %>"></div>
            </div>

            <div class="d-flex align-items-center gap-4 mt-3 pt-3 border-top border-secondary border-opacity-25">
                <label class="custom-switch-label">
                    <input type="checkbox" name="isMine" <%= tour.isMine ? 'checked' : '' %>>
                    <span>Is My Tournament</span>
                </label>
                <label class="custom-switch-label">
                    <input type="checkbox" name="isLive" <%= tour.isLive ? 'checked' : '' %>>
                    <span>Is Live</span>
                </label>
                <button type="submit" class="btn-tcg btn-tcg-save ms-auto">💾 Save General Settings</button>
            </div>
        </form>
    </div>

    <!-- Редактор этапов -->
    <div class="admin-panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="m-0 text-white" style="font-weight: 700;">Stages & Rosters Editor</h4>
            <button class="btn-tcg btn-tcg-save" onclick="saveGroupsToDB()">💾 Save Stages Data</button>
        </div>

        <div class="stage-tabs">
            <button class="stage-tab active" onclick="switchStage(1)" id="tab-stage-1">Stage 1</button>
            <button class="stage-tab" onclick="switchStage(2)" id="tab-stage-2">Stage 2</button>
            <button class="stage-tab" onclick="switchStage(3)" id="tab-stage-3">Play-offs (Stage 3)</button>
        </div>

        <div class="mb-3 d-flex gap-2">
            <button class="btn-tcg btn-tcg-add" id="btn-add-entity" onclick="handleAddEntity()">+ Add New Group</button>
            <button class="btn-tcg btn-tcg-copy" onclick="duplicateToStage2()" id="btn-duplicate" style="display:none;">Copy Rosters to Stage 2</button>
        </div>

        <div id="groups-container" class="groups-admin-grid"></div>
    </div>
</div>

<div id="charModal">
    <div class="char-modal-content">
        <h5 class="mb-3 text-center text-info font-weight-bold">Select 3 Characters</h5>
        <div class="selected-deck-preview">
            <div class="preview-slot" id="prev-0"></div>
            <div class="preview-slot" id="prev-1"></div>
            <div class="preview-slot" id="prev-2"></div>
        </div>
        <div class="text-center mb-3 d-flex justify-content-center gap-2">
            <button class="m-btn m-confirm" onclick="confirmDeckSelection()">CONFIRM</button>
            <button class="m-btn m-cancel" onclick="closeCharModal()">CANCEL</button>
            <button class="m-btn m-clear" onclick="clearDeckSelection()">CLEAR</button>
        </div>
        <input type="text" class="player-input mb-2" id="charSearch" placeholder="Search character..." onkeyup="filterChars()">
        
        <div class="char-grid" id="modalCharGrid">
            <% 
            const allChars = [];
            Object.values(chars).forEach(elementArr => {
                elementArr.forEach(c => allChars.push(c));
            });
            allChars.sort((a,b) => a.name.localeCompare(b.name));
            allChars.forEach(c => { 
                let charImg = c.img || `/cardback.png`;
            %>
                <div class="char-item" data-id="<%= c.id %>" data-name="<%= c.name.toLowerCase() %>" onclick="toggleCharSelect('<%= c.id %>', this)">
                    <img src="<%= charImg %>" title="<%= c.name %>" onerror="this.src='/cardback.png'">
                </div>
            <% }); %>
        </div>
    </div>
</div>

<script>
    const charImages = {};
    <% allChars.forEach(c => { 
        let charImg = c.img || `/cardback.png`;
    %>
        charImages['<%= c.id %>'] = '<%= charImg %>';
    <% }); %>

    let currentStage = 1;
    let tournamentData = <%- JSON.stringify(tour.groups || []) %>;
    let editingContext = { groupIdx: -1, playerIdx: -1, deckIdx: -1 };
    let currentSelection = [];

    function renderGroups() {
        const container = document.getElementById('groups-container');
        container.innerHTML = '';

        if (currentStage === 3) {
            let playoffGroup = tournamentData.find(g => g.stage === 3);
            if (!playoffGroup) {
                playoffGroup = { name: 'Play-offs', stage: 3, players: [] };
                tournamentData.push(playoffGroup);
            }
            const gIdx = tournamentData.findIndex(g => g === playoffGroup);

            let html = `<div class="playoff-admin-grid">`;
            if (playoffGroup.players.length === 0) {
                html += `<div class="col-12 text-muted py-3 text-center small">No playoff players added yet. Click "+ Add Playoff Player" above.</div>`;
            } else {
                playoffGroup.players.forEach((player, pIdx) => {
                    html += `
                    <div class="playoff-admin-card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <input type="text" class="player-input" style="font-weight:700; color:#00d2ff; width: 85%;" 
                                   value="${player.name || ''}" placeholder="Player Name" onchange="updatePlayer(${gIdx}, ${pIdx}, 'name', this.value)">
                            <button class="btn-delete-group" style="padding: 2px 6px; font-size: 10px;" onclick="deletePlayoffPlayer(${pIdx})">✕</button>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 4px;">`;

                    for (let dIdx = 0; dIdx < 5; dIdx++) {
                        html += `<div style="display: flex; gap: 5px; justify-content: center;">`;
                        for (let cIdx = 0; cIdx < 3; cIdx++) {
                            html += `<div class="deck-slot" onclick="openDeckEditor(${gIdx}, ${pIdx}, ${dIdx})" id="slot-${gIdx}-${pIdx}-${dIdx}-${cIdx}"></div>`;
                        }
                        html += `</div>`;
                    }

                    html += `</div></div>`;
                });
            }
            html += `</div>`;
            container.innerHTML = html;

            playoffGroup.players.forEach((player, pIdx) => {
                for (let dIdx = 0; dIdx < 5; dIdx++) {
                    let deck = player.decks && player.decks[dIdx] ? player.decks[dIdx] : [];
                    for (let cIdx = 0; cIdx < 3; cIdx++) {
                        let charId = deck[cIdx];
                        let slotEl = document.getElementById(`slot-${gIdx}-${pIdx}-${dIdx}-${cIdx}`);
                        if (slotEl) {
                            if (charId) {
                                slotEl.innerHTML = `<img src="${charImages[charId] || '/cardback.png'}" onerror="this.src='/cardback.png'">`;
                            } else {
                                slotEl.innerHTML = `<img src="/cardback.png" style="opacity: 0.12; border-radius: 50%;">`;
                            }
                        }
                    }
                }
            });
            return;
        }

        const stageGroups = tournamentData.filter(g => g.stage === currentStage);
        if (stageGroups.length === 0) {
            container.innerHTML = '<p class="text-muted py-3 text-center small col-12" style="grid-column: 1/-1;">No groups in this stage.</p>';
            return;
        }

        stageGroups.forEach(group => {
            const realGroupIdx = tournamentData.findIndex(g => g === group);
            
            let html = `
            <div class="group-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <input type="text" class="player-input" style="width: 150px; font-weight: 700; color:#00d2ff; border-color: rgba(0, 210, 255, 0.4);" 
                           value="${group.name}" onchange="updateGroupData(${realGroupIdx}, 'name', this.value)">
                    <button class="btn-delete-group" onclick="deleteGroup(${realGroupIdx})">Delete</button>
                </div>
                
                <table style="width: 100%; table-layout: fixed; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: #8fa0c9; font-size: 11px; font-weight: 700;">
                            <th style="width: 145px; padding: 4px; text-align: left;">PLAYER</th>
                            <th style="width: 32px; text-align: center;">PTS</th>
                            <th style="width: 32px; text-align: center;">W</th>
                            <th style="width: 32px; text-align: center;">D</th>
                            <th style="width: 32px; text-align: center;">L</th>
                            <th style="padding: 4px; text-align: left; padding-left: 8px;">DECKS</th>
                        </tr>
                    </thead>
                    <tbody>`;
            
            group.players.forEach((player, pIdx) => {
                let pts = (Number(player.wins) || 0) * 3 + (Number(player.draws) || 0);
                
                html += `
                        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                            <td style="padding: 3px 2px;">
                                <div style="display: flex; gap: 4px; align-items: center;">
                                    <div style="display: flex; flex-direction: column; gap: 2px;">
                                        <button type="button" class="order-btn" title="Move Up" onclick="movePlayerUp(${realGroupIdx}, ${pIdx})" ${pIdx === 0 ? 'disabled style="opacity:0.3; cursor:default;"' : ''}>▲</button>
                                        <button type="button" class="order-btn" title="Move Down" onclick="movePlayerDown(${realGroupIdx}, ${pIdx})" ${pIdx === group.players.length - 1 ? 'disabled style="opacity:0.3; cursor:default;"' : ''}>▼</button>
                                    </div>
                                    <input type="text" class="player-input" value="${player.name || ''}" placeholder="P${pIdx+1}" onchange="updatePlayer(${realGroupIdx}, ${pIdx}, 'name', this.value)">
                                </div>
                            </td>
                            <td style="text-align: center; color: #ffcc00; font-weight: 700; font-size: 13px;">${pts}</td>
                            <td style="text-align: center; padding: 1px;"><input type="number" class="player-input num-input" style="padding: 4px 2px;" value="${player.wins || 0}" min="0" onchange="updatePlayer(${realGroupIdx}, ${pIdx}, 'wins', this.value)"></td>
                            <td style="text-align: center; padding: 1px;"><input type="number" class="player-input num-input" style="padding: 4px 2px;" value="${player.draws || 0}" min="0" onchange="updatePlayer(${realGroupIdx}, ${pIdx}, 'draws', this.value)"></td>
                            <td style="text-align: center; padding: 1px;"><input type="number" class="player-input num-input" style="padding: 4px 2px;" value="${player.losses || 0}" min="0" onchange="updatePlayer(${realGroupIdx}, ${pIdx}, 'losses', this.value)"></td>
                            <td style="padding: 3px 2px 3px 8px;">
                                <div style="display: flex; flex-direction: column; gap: 3px;">
                                    <div style="display: flex; gap: 8px;">`;

                for (let dIdx = 0; dIdx < 2; dIdx++) {
                    html += `<div style="display: flex; flex-direction: row; gap: 3px;">`;
                    for (let cIdx = 0; cIdx < 3; cIdx++) {
                        html += `<div class="deck-slot" onclick="openDeckEditor(${realGroupIdx}, ${pIdx}, ${dIdx})" id="slot-${realGroupIdx}-${pIdx}-${dIdx}-${cIdx}"></div>`;
                    }
                    html += `</div>`;
                }

                html += `           </div>
                                    <div style="display: flex; gap: 8px;">`;

                for (let dIdx = 2; dIdx < 4; dIdx++) {
                    html += `<div style="display: flex; flex-direction: row; gap: 3px;">`;
                    for (let cIdx = 0; cIdx < 3; cIdx++) {
                        html += `<div class="deck-slot" onclick="openDeckEditor(${realGroupIdx}, ${pIdx}, ${dIdx})" id="slot-${realGroupIdx}-${pIdx}-${dIdx}-${cIdx}"></div>`;
                    }
                    html += `</div>`;
                }

                html += `           </div>
                                </div>
                            </td>
                        </tr>`;
            });

            html += `</tbody></table></div>`;
            container.innerHTML += html;
        });

        tournamentData.forEach((group, gIdx) => {
            if(group.stage !== currentStage) return;
            group.players.forEach((player, pIdx) => {
                for(let dIdx = 0; dIdx < 4; dIdx++) {
                    let deck = player.decks && player.decks[dIdx] ? player.decks[dIdx] : [];
                    for(let cIdx = 0; cIdx < 3; cIdx++) {
                        let charId = deck[cIdx];
                        let slotEl = document.getElementById(`slot-${gIdx}-${pIdx}-${dIdx}-${cIdx}`);
                        if(slotEl) {
                            if(charId) {
                                slotEl.innerHTML = `<img src="${charImages[charId] || '/cardback.png'}" onerror="this.src='/cardback.png'">`;
                            } else {
                                slotEl.innerHTML = `<img src="/cardback.png" style="opacity: 0.12; border-radius: 50%;">`;
                            }
                        }
                    }
                }
            });
        });
    }

    function switchStage(stage) {
        currentStage = stage;
        document.getElementById('tab-stage-1').className = stage === 1 ? 'stage-tab active' : 'stage-tab';
        document.getElementById('tab-stage-2').className = stage === 2 ? 'stage-tab active' : 'stage-tab';
        document.getElementById('tab-stage-3').className = stage === 3 ? 'stage-tab active' : 'stage-tab';
        
        document.getElementById('btn-duplicate').style.display = stage === 1 ? 'inline-block' : 'none';
        document.getElementById('btn-add-entity').innerText = stage === 3 ? '+ Add Playoff Player' : '+ Add New Group';
        
        renderGroups();
    }

    function handleAddEntity() {
        if (currentStage === 3) {
            let playoffGroup = tournamentData.find(g => g.stage === 3);
            if (!playoffGroup) {
                playoffGroup = { name: 'Play-offs', stage: 3, players: [] };
                tournamentData.push(playoffGroup);
            }
            playoffGroup.players.push({
                name: '', wins: 0, draws: 0, losses: 0,
                decks: [[], [], [], [], []]
            });
            renderGroups();
        } else {
            addGroup();
        }
    }

    function deletePlayoffPlayer(pIdx) {
        let playoffGroup = tournamentData.find(g => g.stage === 3);
        if (playoffGroup && confirm('Delete this playoff player?')) {
            playoffGroup.players.splice(pIdx, 1);
            renderGroups();
        }
    }

    function addGroup() {
        tournamentData.push({
            name: 'New Group', stage: currentStage,
            players: [
                { name: '', wins: 0, draws: 0, losses: 0, decks: [[],[],[],[]] },
                { name: '', wins: 0, draws: 0, losses: 0, decks: [[],[],[],[]] },
                { name: '', wins: 0, draws: 0, losses: 0, decks: [[],[],[],[]] },
                { name: '', wins: 0, draws: 0, losses: 0, decks: [[],[],[],[]] }
            ]
        });
        renderGroups();
    }

    function deleteGroup(idx) {
        if(confirm('Are you sure you want to delete this group?')) { tournamentData.splice(idx, 1); renderGroups(); }
    }

    function updateGroupData(idx, field, value) { tournamentData[idx][field] = value; }

    function updatePlayer(gIdx, pIdx, field, value) {
        if(field === 'name') {
            tournamentData[gIdx].players[pIdx].name = value;
        } else {
            tournamentData[gIdx].players[pIdx][field] = parseInt(value) || 0;
            const p = tournamentData[gIdx].players[pIdx];
            p.points = (Number(p.wins) || 0) * 3 + (Number(p.draws) || 0);
            renderGroups();
        }
    }

    function movePlayerUp(gIdx, pIdx) {
        if (pIdx <= 0) return;
        const players = tournamentData[gIdx].players;
        const temp = players[pIdx];
        players[pIdx] = players[pIdx - 1];
        players[pIdx - 1] = temp;
        renderGroups();
    }

    function movePlayerDown(gIdx, pIdx) {
        const players = tournamentData[gIdx].players;
        if (pIdx >= players.length - 1) return;
        const temp = players[pIdx];
        players[pIdx] = players[pIdx + 1];
        players[pIdx + 1] = temp;
        renderGroups();
    }

    function duplicateToStage2() {
        if(!confirm('Copy Stage 1 groups to Stage 2 (keeping current scores and decks)?')) return;
        tournamentData = tournamentData.filter(g => g.stage !== 2);
        const stage1Groups = tournamentData.filter(g => g.stage === 1);
        stage1Groups.forEach(g => {
            const newGroup = JSON.parse(JSON.stringify(g));
            newGroup.stage = 2;
            newGroup._id = undefined;
            newGroup.players.forEach(p => { 
                p._id = undefined; 
                p.wins = Number(p.wins) || 0;
                p.draws = Number(p.draws) || 0;
                p.losses = Number(p.losses) || 0;
                p.points = p.wins * 3 + p.draws;
                p.decks = Array.isArray(p.decks) ? p.decks : [[], [], [], []];
            });
            tournamentData.push(newGroup);
        });
        switchStage(2);
    }

    function openDeckEditor(gIdx, pIdx, dIdx) {
        editingContext = { groupIdx: gIdx, playerIdx: pIdx, deckIdx: dIdx };
        if (!tournamentData[gIdx].players[pIdx].decks) {
            tournamentData[gIdx].players[pIdx].decks = [];
        }
        currentSelection = [...(tournamentData[gIdx].players[pIdx].decks[dIdx] || [])];
        updateModalVisuals(); 
        document.getElementById('charModal').style.display = 'block';
    }

    function closeCharModal() { document.getElementById('charModal').style.display = 'none'; }

    function toggleCharSelect(charId, elem) {
        const idx = currentSelection.indexOf(charId);
        if (idx > -1) currentSelection.splice(idx, 1);
        else if (currentSelection.length < 3) currentSelection.push(charId);
        updateModalVisuals();
    }

    function updateModalVisuals() {
        document.querySelectorAll('.char-item').forEach(el => {
            el.classList.toggle('selected', currentSelection.includes(el.dataset.id));
        });
        for(let i=0; i<3; i++) {
            const slot = document.getElementById('prev-'+i);
            if (currentSelection[i]) {
                let imgUrl = charImages[currentSelection[i]] || '/cardback.png';
                slot.innerHTML = `<img src="${imgUrl}" style="width:100%; height:100%; object-fit:cover; border-radius:50%; border:none; box-shadow: 0 2px 6px rgba(0,0,0,0.5);" onerror="this.src='/cardback.png'">`;
            } else {
                slot.innerHTML = '';
            }
        }
    }

    function clearDeckSelection() { currentSelection = []; updateModalVisuals(); }

    function confirmDeckSelection() {
        tournamentData[editingContext.groupIdx].players[editingContext.playerIdx].decks[editingContext.deckIdx] = [...currentSelection];
        closeCharModal(); 
        renderGroups();
    }

    function filterChars() {
        const term = document.getElementById('charSearch').value.toLowerCase();
        document.querySelectorAll('.char-item').forEach(el => { el.style.display = el.dataset.name.includes(term) ? 'block' : 'none'; });
    }

    async function saveGroupsToDB() {
        const btn = document.querySelector('button[onclick="saveGroupsToDB()"]');
        btn.innerHTML = 'Saving...'; btn.disabled = true;
        try {
            const res = await fetch('/admin/edit-groups/<%= tour._id %>', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ groups: tournamentData }) });
            if((await res.json()).success) alert('Stages data saved successfully!');
            else alert('Error saving data');
        } catch (e) { alert('Server error'); } 
        finally { btn.innerHTML = '💾 Save Stages Data'; btn.disabled = false; }
    }

    switchStage(1);
</script>

