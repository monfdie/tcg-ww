<%- include('../partials/header') %>

<style>
    .profile-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; background: rgba(16, 20, 32, 0.8); padding: 20px 30px; border: 1px solid #2a3454; border-radius: 8px; }
    .profile-title { font-family: 'Cinzel', serif; font-size: 2em; color: #fff; margin: 0; text-shadow: 0 0 15px rgba(79, 172, 254, 0.4); }
    
    .tiers-panel { display: flex; gap: 15px; flex-wrap: wrap; justify-content: center; margin-bottom: 20px; }
    .tier-box { background: rgba(10, 12, 20, 0.9); border: 1px solid #3c4566; padding: 15px 25px; border-radius: 8px; text-align: center; min-width: 100px; transition: 0.3s; }
    .tier-box h3 { margin: 0 0 5px 0; font-size: 0.9em; color: #8da4c4; text-transform: uppercase; letter-spacing: 1px; }
    .tier-count { font-size: 1.8em; font-weight: bold; font-family: 'Cinzel', serif; color: #fff; }
    
    .count-ok { color: #50b36b !important; text-shadow: 0 0 10px rgba(80, 179, 107, 0.5); border-color: #50b36b; }
    .count-error { color: #ff6b6b !important; text-shadow: 0 0 10px rgba(255, 107, 107, 0.5); border-color: #ff6b6b; }

    .char-grid { background: rgba(16, 20, 32, 0.6); border: 1px solid #2a3454; border-radius: 8px; padding: 20px; display: flex; flex-direction: column; gap: 10px; }
    .element-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 10px; background: rgba(0,0,0,0.2); border-radius: 6px; }
    
    .char-option-box { width: 55px; height: 55px; border-radius: 8px; cursor: pointer; border: 2px solid transparent; transition: 0.2s; position: relative; background: #111; overflow: hidden; }
    .char-option-box img { width: 100%; height: 100%; object-fit: cover; opacity: 0.4; transition: 0.2s; }
    .char-option-box:hover img { opacity: 0.8; transform: scale(1.05); }
    
    .char-option-box.in-box { border-color: #d4af37; box-shadow: 0 0 15px rgba(212, 175, 55, 0.5); transform: translateY(-2px); }
    .char-option-box.in-box img { opacity: 1; }
    
    .char-tier-badge { position: absolute; bottom: 0; right: 0; background: rgba(0,0,0,0.8); color: #fff; font-size: 10px; padding: 2px 5px; border-top-left-radius: 4px; font-weight: bold; }

    .save-btn { padding: 12px 30px; font-size: 1.1em; background: #28a745; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-family: 'Segoe UI', sans-serif; font-weight: bold; transition: 0.3s; text-transform: uppercase; letter-spacing: 1px; }
    .save-btn:disabled { background: #444; color: #888; cursor: not-allowed; }
    .save-btn:not(:disabled):hover { background: #34d058; box-shadow: 0 0 15px rgba(40, 167, 69, 0.5); transform: translateY(-2px); }

    .total-counter { display: flex; justify-content: space-between; align-items: center; margin-top: 20px; padding: 20px; background: rgba(16, 20, 32, 0.9); border: 1px solid #2a3454; border-radius: 8px; }
    .total-text { font-size: 1.2em; color: #8da4c4; }
    .total-text span { font-size: 1.5em; font-weight: bold; color: #fff; margin-left: 10px; }

    /* Сортировка */
    .controls-panel { display: flex; justify-content: flex-end; margin-bottom: 10px; align-items: center; }
    .sort-label { color: #8da4c4; margin-right: 10px; font-weight: bold; text-transform: uppercase; font-size: 0.9em; letter-spacing: 1px; }
    .sort-select { background: #0b0d17; color: #4facfe; border: 1px solid #4facfe; padding: 8px 15px; border-radius: 4px; font-family: 'Segoe UI', sans-serif; cursor: pointer; outline: none; font-weight: bold; transition: 0.3s; }
    .sort-select:hover { box-shadow: 0 0 10px rgba(79, 172, 254, 0.3); }

    .tier-section-title { color: #8da4c4; font-weight: bold; font-family: 'Cinzel', serif; font-size: 1.2em; margin-top: 15px; margin-bottom: 5px; text-transform: uppercase; letter-spacing: 2px; text-shadow: 0 0 10px rgba(141, 164, 196, 0.3); }
</style>

<div class="profile-header">
    <div>
        <h1 class="profile-title">Abyss Box Builder</h1>
        <div style="color: #8da4c4; margin-top: 5px;">Assemble up to 50 characters based on tier limits. You don't have to fill all slots.</div>
    </div>
</div>

<div class="tiers-panel">
    <% [4, 3, 2, 1, 0].forEach(tier => { %>
        <div class="tier-box" id="tier-box-<%= tier %>">
            <h3>Tier <%= tier %></h3>
            <div class="tier-count" id="count-t<%= tier %>">0 / <%= tiers.limits[tier] %></div>
        </div>
    <% }) %>
</div>

<div class="controls-panel">
    <div class="sort-label">Sort By:</div>
    <select id="sort-select" class="sort-select" onchange="changeSort(this.value)">
        <option value="element">Elements</option>
        <option value="tier">Tiers</option>
    </select>
</div>

<div id="char-grid" class="char-grid"></div>

<div class="total-counter">
    <div class="total-text">Total Box Size: <span id="total-count">0 / 50</span></div>
    <button id="save-box-btn" class="save-btn" disabled onclick="saveBox()">Save Box</button>
</div>

<script>
    const charsData = <%- JSON.stringify(chars) %>;
    const tiersData = <%- JSON.stringify(tiers.characters) %>;
    const limits = <%- JSON.stringify(tiers.limits) %>;
    
    let selectedBox = <%- JSON.stringify(user.box || []) %>;
    let currentSort = 'element';
    
    // Определяем порядок элементов
    const elementsOrder = ['cryo', 'hydro', 'pyro', 'electro', 'anemo', 'geo', 'dendro'];
    
    // Создаем единый плоский массив всех персонажей со вшитыми тирами и элементами
    let allChars = [];
    elementsOrder.forEach(elem => {
        if(charsData[elem]) {
            charsData[elem].forEach(c => {
                allChars.push({
                    id: c.id,
                    name: c.name,
                    img: c.img,
                    element: elem,
                    tier: tiersData[c.id] !== undefined ? tiersData[c.id] : 0
                });
            });
        }
    });

    // Функция отрисовки сетки
    function renderGrid() {
        const grid = document.getElementById('char-grid');
        grid.innerHTML = '';

        if (currentSort === 'element') {
            elementsOrder.forEach(elem => {
                const elemChars = allChars.filter(c => c.element === elem);
                if(elemChars.length === 0) return;
                
                const row = document.createElement('div');
                row.className = 'element-row';
                
                elemChars.forEach(c => { row.appendChild(createCharBox(c)); });
                grid.appendChild(row);
            });
        } else if (currentSort === 'tier') {
            [4, 3, 2, 1, 0].forEach(t => {
                // Сортируем внутри тира по порядку элементов
                const tierChars = allChars.filter(c => c.tier === t).sort((a, b) => {
                    return elementsOrder.indexOf(a.element) - elementsOrder.indexOf(b.element);
                });
                
                if(tierChars.length === 0) return;

                const wrapper = document.createElement('div');
                const title = document.createElement('div');
                title.className = 'tier-section-title';
                title.innerText = `Tier ${t}`;
                
                const row = document.createElement('div');
                row.className = 'element-row';
                
                tierChars.forEach(c => { row.appendChild(createCharBox(c)); });
                
                wrapper.appendChild(title);
                wrapper.appendChild(row);
                grid.appendChild(wrapper);
            });
        }
        
        updateVisualSelection();
    }

    // Создание HTML-элемента карточки
    function createCharBox(c) {
        const div = document.createElement('div');
        div.className = 'char-option-box';
        div.setAttribute('data-id', c.id);
        div.onclick = function() { toggleChar(this); };
        
        div.innerHTML = `
            <img src="${c.img}" alt="${c.name}">
            <div class="char-tier-badge">T${c.tier}</div>
        `;
        return div;
    }

    // Переключение сортировки
    function changeSort(val) {
        currentSort = val;
        renderGrid();
    }

    function toggleChar(element) {
        const charId = element.getAttribute('data-id');
        
        if (selectedBox.includes(charId)) {
            selectedBox = selectedBox.filter(id => id !== charId);
        } else {
            selectedBox.push(charId);
        }
        updateVisualSelection();
    }

    // Обновляет классы выделения и счетчики
    function updateVisualSelection() {
        document.querySelectorAll('.char-option-box').forEach(el => {
            if (selectedBox.includes(el.getAttribute('data-id'))) {
                el.classList.add('in-box');
            } else {
                el.classList.remove('in-box');
            }
        });
        updateCounters();
    }

    function updateCounters() {
        let counts = { "0": 0, "1": 0, "2": 0, "3": 0, "4": 0 };
        
        // Считаем по сохраненному массиву (самый надежный способ)
        selectedBox.forEach(id => {
            const charObj = allChars.find(c => c.id === id);
            if(charObj) counts[charObj.tier]++;
        });

        let allValid = true;
        let total = selectedBox.length;

        for (let i = 0; i <= 4; i++) {
            const tBox = document.getElementById(`tier-box-${i}`);
            const tCount = document.getElementById(`count-t${i}`);
            const current = counts[i];
            const limit = limits[i];
            
            tCount.innerText = `${current} / ${limit}`;

            tBox.classList.remove('count-ok', 'count-error');
            if (current <= limit) {
                tBox.classList.add('count-ok');
            } else {
                tBox.classList.add('count-error');
                allValid = false;
            }
        }

        const totalEl = document.getElementById('total-count');
        totalEl.innerText = `${total} / 50`;
        
        if (total > 0 && total <= 50) {
            totalEl.style.color = '#50b36b';
        } else if (total > 50) {
            totalEl.style.color = '#ff6b6b';
            allValid = false;
        } else {
            totalEl.style.color = '#fff';
        }

        document.getElementById('save-box-btn').disabled = !(allValid && total > 0);
    }

    async function saveBox() {
        const btn = document.getElementById('save-box-btn');
        btn.innerText = 'Saving...';
        btn.disabled = true;

        try {
            const res = await fetch('/profile/save-box', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ box: selectedBox })
            });
            const data = await res.json();
            if (data.success) {
                alert('Box successfully saved! You are ready for Abyss Draft.');
                btn.innerText = 'Save Box';
                btn.disabled = false;
            } else {
                alert('Error saving box.');
                btn.innerText = 'Save Box';
                btn.disabled = false;
            }
        } catch(e) {
            console.error(e);
            alert('Server connection error.');
            btn.innerText = 'Save Box';
            btn.disabled = false;
        }
    }

    // Рендерим при загрузке страницы
    document.addEventListener('DOMContentLoaded', () => {
        renderGrid();
    });
</script>

<%- include('../partials/footer') %>
