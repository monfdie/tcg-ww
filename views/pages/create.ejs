<%- include('../partials/header') %>
<link rel="stylesheet" href="/draft-notices.css">

<style>
    .create-room-wrap { display: flex; justify-content: center; margin-top: 50px; }
    body.modern-site .series-picker { box-sizing: border-box; width: calc(100% - 20px); min-width: 0; margin-inline: auto; gap: 8px; padding: 13px 14px 11px; border: 1px solid rgba(199,213,246,.12); border-radius: 16px; background: linear-gradient(145deg,rgba(35,44,60,.58),rgba(18,24,36,.48)); overflow: hidden; }
    body.modern-site .series-picker label { display: flex; justify-content: space-between; align-items: center; margin: 0; font-weight: 600; }
    #series-label { display: inline-flex; align-items: center; min-height: 25px; padding: 0 9px; border-radius: 100px; background: rgba(185,244,120,.09); color: #b9f478; font-family: 'Segoe UI', sans-serif; font-size: 12px; font-weight: 650; letter-spacing: 0; }
    .series-range-wrap { position: relative; width: 100%; height: 32px; --series-progress: 0%; }
    .series-range-wrap::before { content: ''; position: absolute; top: 50%; left: 12px; right: 12px; height: 5px; transform: translateY(-50%); border-radius: 99px; background: linear-gradient(to right, #819e62 0 var(--series-progress), #303a4d var(--series-progress) 100%); }
    body.modern-site #series-length { appearance: none; -webkit-appearance: none; position: relative; z-index: 2; display: block; width: 100%; height: 32px; margin: 0; padding: 0; background: transparent !important; border: 0 !important; box-shadow: none !important; cursor: pointer; }
    body.modern-site #series-length:focus { background: transparent !important; box-shadow: none !important; }
    #series-length::-webkit-slider-runnable-track { height: 5px; border: 0; background: transparent; }
    #series-length::-moz-range-track { height: 5px; border: 0; background: transparent; }
    #series-length::-webkit-slider-thumb { -webkit-appearance: none; width: 24px; height: 24px; margin-top: -9.5px; border-radius: 50%; border: 2px solid #b9f478; background: #273242; box-shadow: 0 0 0 2px rgba(185,244,120,.06), 0 2px 4px rgba(0,0,0,.25); transition: transform .12s, box-shadow .12s; }
    #series-length::-moz-range-thumb { width: 20px; height: 20px; border-radius: 50%; border: 2px solid #b9f478; background: #273242; box-shadow: 0 0 0 2px rgba(185,244,120,.06), 0 2px 4px rgba(0,0,0,.25); transition: transform .12s, box-shadow .12s; }
    .series-range-wrap.is-clicking #series-length::-webkit-slider-thumb { transform: scale(.88); box-shadow: 0 1px 2px rgba(0,0,0,.25); }
    .series-range-wrap.is-clicking #series-length::-moz-range-thumb { transform: scale(.88); box-shadow: 0 1px 2px rgba(0,0,0,.25); }
    .series-range-marks { position: absolute; z-index: 1; top: 50%; left: 12px; right: 12px; display: flex; justify-content: space-between; transform: translateY(-50%); pointer-events: none; }
    .series-range-marks span { width: 5px; height: 5px; border-radius: 50%; background: #9aa6bb; }
    .series-range-marks span.passed { background: #b9f478; }
    .series-range-labels { display: flex; justify-content: space-between; width: 100%; margin: 0; }
    body.modern-site .series-range-labels button { box-sizing: border-box; min-width: 0; width: 34px; min-height: 26px; margin: 0; padding: 4px 0 !important; border: 1px solid transparent !important; border-radius: 9px !important; background: transparent !important; color: #9aa6bb !important; font-family: 'Segoe UI', sans-serif; font-size: 11px; letter-spacing: 0; }
    body.modern-site .series-range-labels button.active { color: #b9f478 !important; border-color: rgba(185,244,120,.22) !important; background: rgba(185,244,120,.07) !important; }
    body.modern-site .series-range-labels button.active:hover:not(:disabled) { color: #8fbd4f !important; border-color: rgba(185,244,120,.4) !important; background: rgba(185,244,120,.14) !important; }
    @media (max-width: 768px) {
        .create-room-wrap { margin-top: 16px; padding-bottom: 20px; }
    }
    @media (max-width: 380px) {
        body.modern-site .series-picker { width: calc(100% - 8px); padding-inline: 10px; }
    }
</style>

<div class="create-room-wrap">
    <div class="lobby-card">
        <h1>Create Room</h1>
        <div class="input-group">
            <label>NICKNAME</label>
            <input id="nickname-input" placeholder="Enter Name" maxlength="15" 
                   value="<%= locals.user ? locals.user.username : '' %>">
        </div>
     
        <div class="input-group">
            <label>DRAFT MODE</label>
            <select name="draftType" id="draftType">
                <option value="global_ban_sys">Fast Cup NewGen</option>
                <option value="moba_3phase">Harmony in Snow: DE</option>
                <option value="gitcg">GITCG CUP</option>
                <option value="gitcg_cup_2">GITCG CUP 2</option>
                <option value="classic">Classic</option>
                <option value="generals_2">Generals 2</option>
            </select>
        </div>
        <div class="input-group" id="global-tournament-field" style="display:none;">
            <label>TOURNAMENT</label>
            <select id="global-tournament" class="form-input">
                <option value="">Select tournament</option>
                <% globalBanTournaments.forEach(tour => { %>
                    <option value="<%= tour.slug %>" <%= selectedTournament === tour.slug ? 'selected' : '' %>><%= tour.title %><%= tour.globalBansLocked ? '' : ' (ban selection open)' %></option>
                <% }) %>
            </select>
        </div>
        <div class="input-group series-picker">
            <label for="series-length">SERIES <span id="series-label">BO1</span></label>
            <div class="series-range-wrap" id="series-range-wrap">
                <input id="series-length" type="range" min="0" max="4" step="1" value="0" aria-label="Series length">
                <div class="series-range-marks" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
            </div>
            <div class="series-range-labels" id="series-range-labels">
                <button type="button" data-step="0" class="active">BO1</button>
                <button type="button" data-step="1">BO2</button>
                <button type="button" data-step="2">BO3</button>
                <button type="button" data-step="3">BO5</button>
                <button type="button" data-step="4">BO7</button>
            </div>
        </div>
        <button class="btn-primary" onclick="createGame()">Create Game</button>
     
        <div class="separator"><span>OR JOIN</span></div>
        
        <div class="input-group">
            <label>ROOM CODE</label>
            <input id="room-input" placeholder="Enter Code" style="text-transform: uppercase;">
        </div>
        
        <button class="btn-secondary" onclick="joinGame()">Join Game</button>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/draft-notices.js"></script>
<script>
    const socket = io({ transports: ['websocket'] });
    const modeSelect = document.getElementById('draftType');
    const tournamentField = document.getElementById('global-tournament-field');
    const seriesOptions = [1, 2, 3, 5, 7];
    const seriesLength = document.getElementById('series-length');
    const seriesRangeWrap = document.getElementById('series-range-wrap');
    let seriesClickTimer;
    function updateSeriesLength(animate = true) {
        const step = Number(seriesLength.value);
        const label = `BO${seriesOptions[step]}`;
        document.getElementById('series-label').textContent = label;
        seriesLength.setAttribute('aria-valuetext', label);
        seriesRangeWrap.style.setProperty('--series-progress', `${step / (seriesOptions.length - 1) * 100}%`);
        document.querySelectorAll('#series-range-labels button').forEach(button => {
            button.classList.toggle('active', Number(button.dataset.step) === step);
        });
        document.querySelectorAll('.series-range-marks span').forEach((mark, index) => {
            mark.classList.toggle('passed', index <= step);
        });
        if (!animate) return;
        seriesRangeWrap.classList.add('is-clicking');
        clearTimeout(seriesClickTimer);
        seriesClickTimer = setTimeout(() => seriesRangeWrap.classList.remove('is-clicking'), 125);
    }
    seriesLength.addEventListener('input', updateSeriesLength);
    document.querySelectorAll('#series-range-labels button').forEach(button => {
        button.addEventListener('click', () => { seriesLength.value = button.dataset.step; updateSeriesLength(); });
    });
    updateSeriesLength(false);
    function updateTournamentField() { tournamentField.style.display = modeSelect.value === 'global_ban_sys' ? 'block' : 'none'; }
    modeSelect.addEventListener('change', updateTournamentField);
    if (new URLSearchParams(location.search).get('mode') === 'global_ban_sys') modeSelect.value = 'global_ban_sys';
    updateTournamentField();

    function createGame() { 
        const nick = document.getElementById('nickname-input').value.trim() || 'Player 1';
        const type = document.getElementById('draftType').value;
        const tournamentSlug = document.getElementById('global-tournament').value;
        if (type === 'global_ban_sys' && !tournamentSlug) return showDraftNotice('Select a tournament.', 'error');
        socket.emit('create_game', { 
            nickname: nick, 
            draftType: type,
            tournamentSlug,
            bestOf: seriesOptions[Number(seriesLength.value)]
        });
    }

    function joinGame() {
        const room = document.getElementById('room-input').value.trim().toUpperCase();
        if(!room) return showDraftNotice('Enter a room code.', 'error');
        
        // Сохраняем введенный ник, чтобы он передался на страницу игры
        const nick = document.getElementById('nickname-input').value.trim() || 'Player 2';
        sessionStorage.setItem('draft_nickname', nick);
        
        window.location.href = `/game/${room}`;
    }

    socket.on('init_game', (data) => {
        sessionStorage.setItem('draft_room_id', data.roomId);
        const nick = document.getElementById('nickname-input').value.trim();
        if(nick) sessionStorage.setItem('draft_nickname', nick);
        
        window.location.href = `/game/${data.roomId}`;
    });
    socket.on('error_msg', (message) => { showDraftNotice(message, 'error'); });
    socket.on('connect_error', (error) => { showDraftNotice(error.message, 'error'); });
</script>

<%- include('../partials/footer') %>
