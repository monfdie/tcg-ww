<%- include('../partials/header') %>

<style>
    .stats-header { background: linear-gradient(135deg, rgba(22, 28, 48, 0.9), rgba(10, 12, 20, 0.9)); padding: 40px; border-radius: 12px; border: 1px solid #2a3454; display: flex; align-items: center; gap: 30px; margin-bottom: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    .stats-avatar { width: 120px; height: 120px; border-radius: 50%; border: 3px solid #4facfe; box-shadow: 0 0 20px rgba(79, 172, 254, 0.4); object-fit: cover; }
    .stats-info h1 { margin: 0 0 10px 0; color: #fff; font-family: 'Cinzel', serif; font-size: 2.5em; text-shadow: 0 0 10px rgba(255,255,255,0.2); }
    .stats-tag { background: #2a3454; color: #8da4c4; padding: 5px 15px; border-radius: 20px; font-weight: bold; font-size: 0.9em; display: inline-block; }
    
    .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
    @media (max-width: 768px) { .stats-grid { grid-template-columns: 1fr; } }
    
    .stats-card { background: rgba(16, 20, 32, 0.6); border: 1px solid #3c4566; border-radius: 12px; padding: 25px; }
    .stats-card h2 { margin: 0 0 20px 0; color: #fff; font-family: 'Cinzel', serif; border-bottom: 1px solid #3c4566; padding-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
    
    .char-stat-row { display: flex; align-items: center; justify-content: space-between; padding: 10px; background: rgba(0,0,0,0.3); border-radius: 8px; margin-bottom: 10px; transition: 0.2s; }
    .char-stat-row:hover { background: rgba(79, 172, 254, 0.1); transform: translateX(5px); }
    
    .char-info { display: flex; align-items: center; gap: 15px; }
    .char-img { width: 50px; height: 50px; border-radius: 8px; object-fit: cover; border: 1px solid #555; }
    .char-name { color: #fff; font-weight: bold; font-size: 1.1em; }
    
    .stat-count { font-family: 'Cinzel', serif; font-size: 1.4em; font-weight: bold; }
    .pick-count { color: #4facfe; }
    .ban-count { color: #ff6b6b; }

    .no-data { text-align: center; color: #8da4c4; padding: 20px; font-style: italic; }
</style>

<div class="page-container" style="max-width: 1000px;">
    
    <div class="stats-header">
        <img class="stats-avatar" src="https://cdn.discordapp.com/avatars/<%= player.discordId %>/<%= player.avatar %>.png" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
        <div class="stats-info">
            <h1><%= player.username %></h1>
            <div class="stats-tag">Total Matches: <span style="color: #fff;"><%= matchesCount %></span></div>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stats-card">
            <h2 style="color: #4facfe;">🏆 Signature Picks <span>(Top 5)</span></h2>
            <% if (topPicks && topPicks.length > 0) { %>
                <% topPicks.forEach(([charId, count]) => { %>
                    <% const charData = flatChars[charId]; %>
                    <% if (charData) { %>
                        <div class="char-stat-row">
                            <div class="char-info">
                                <img class="char-img" src="<%= charData.img %>" alt="<%= charData.name %>">
                                <span class="char-name"><%= charData.name %></span>
                            </div>
                            <div class="stat-count pick-count"><%= count %></div>
                        </div>
                    <% } %>
                <% }) %>
            <% } else { %>
                <div class="no-data">Not enough data to display top picks.</div>
            <% } %>
        </div>

        <div class="stats-card">
            <h2 style="color: #ff6b6b;">🚫 Most Feared <span>(Top 5 Bans)</span></h2>
            <% if (topBans && topBans.length > 0) { %>
                <% topBans.forEach(([charId, count]) => { %>
                    <% const charData = flatChars[charId]; %>
                    <% if (charData) { %>
                        <div class="char-stat-row">
                            <div class="char-info">
                                <img class="char-img" src="<%= charData.img %>" alt="<%= charData.name %>">
                                <span class="char-name"><%= charData.name %></span>
                            </div>
                            <div class="stat-count ban-count"><%= count %></div>
                        </div>
                    <% } %>
                <% }) %>
            <% } else { %>
                <div class="no-data">Not enough data to display top bans.</div>
            <% } %>
        </div>
    </div>

</div>

<%- include('../partials/footer') %>
