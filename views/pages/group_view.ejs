<%- include('../partials/header') %>

<style>
    /* Мягкий морозный фон страницы вместо глухой темноты */
    body {
        background: radial-gradient(circle at 50% 15%, #182844 0%, #0d1527 55%, #080c16 100%) !important;
        min-height: 100vh;
    }

    /* Сбалансированная ледяная панель */
    .glass-panel {
        background: rgba(18, 29, 50, 0.65);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(174, 227, 255, 0.2);
        border-top: 1px solid rgba(255, 255, 255, 0.35);
        border-left: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 12px;
        box-shadow: 0 12px 35px 0 rgba(0, 0, 0, 0.4), inset 0 0 18px rgba(174, 227, 255, 0.04);
        padding: 20px;
    }

    /* Стили таблицы */
    .glass-table { width: 100%; table-layout: fixed; border-collapse: collapse; }
    .glass-table th { border-bottom: 2px solid rgba(174, 227, 255, 0.2); color: #aee3ff; font-size: 13px; font-weight: bold; text-shadow: 0 1px 2px rgba(0,0,0,0.8); }
    .glass-table td { border-bottom: 1px solid rgba(255, 255, 255, 0.08); transition: background 0.2s; }
    .glass-table tr:last-child td { border-bottom: none; }

    /* Полоски-маркеры слева для Stage 2 */
    .indicator-cell {
        position: relative;
        padding-left: 14px !important;
    }
    .status-strip {
        position: absolute;
        left: 0;
        top: 15%;
        bottom: 15%;
        width: 3px;
        border-radius: 2px;
    }
    .strip-upper { background: #ffcc00; box-shadow: 0 0 8px rgba(255, 204, 0, 0.6); }
    .strip-lower { background: #00d2ff; box-shadow: 0 0 8px rgba(0, 210, 255, 0.6); }
    .strip-elim { background: rgba(255, 107, 107, 0.4); }

    /* Легкое приглушение для выбывших */
    .row-eliminated {
        opacity: 0.65;
    }
    .row-eliminated:hover {
        opacity: 0.9;
    }

    /* Чистые круглые иконки */
    .char-icon-wrap { 
        width: 48px; 
        height: 48px; 
        flex-shrink: 0; 
        background: transparent; 
        border: none; 
        border-radius: 50%; 
    }
    .char-icon-wrap img { 
        width: 100%; 
        height: 100%; 
        object-fit: cover; 
        border-radius: 50%; 
        border: none; 
        box-shadow: 0 4px 10px rgba(0,0,0,0.5); 
    }
    
    /* Контейнер деки */
    .deck-box-glass { 
        display: flex; 
        flex-direction: row; 
        gap: 8px; 
        background: transparent; 
        padding: 0; 
        border: none; 
        box-shadow: none; 
    }
    
    /* Кнопка назад */
    .back-btn-glass { 
        color: #e0f2ff; 
        text-decoration: none; 
        font-size: 14px; 
        font-weight: bold; 
        transition: 0.2s; 
        display: inline-block; 
        padding: 8px 16px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 6px;
        backdrop-filter: blur(6px);
    }
    .back-btn-glass:hover { background: rgba(255, 255, 255, 0.16); color: #ffffff; border-color: #00d2ff; text-decoration: none; }

    /* Заголовок группы */
    .group-main-title { 
        background: linear-gradient(180deg, #ffffff 0%, #bde7ff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0px 4px 18px rgba(0, 198, 255, 0.4);
        font-weight: bold; 
        font-size: 2.8rem; 
        margin-top: 5px;
        margin-bottom: 15px;
    }

    /* Лаконичная легенда */
    .playoff-legend {
        display: flex;
        gap: 20px;
        margin-top: 15px;
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        font-size: 12px;
        color: #8fa0c9;
    }
    .legend-item { display: flex; align-items: center; gap: 6px; }
    .legend-line { width: 12px; height: 3px; border-radius: 2px; }
</style>

<div class="container mt-4 mb-5" style="max-width: 1100px;">
    
    <!-- КНОПКА НАЗАД С ПЕРЕДАЧЕЙ СТАДИИ ГРУППЫ -->
    <div class="mb-3">
        <a href="/tournament/<%= tour.slug %>?stage=<%= group.stage || 1 %>" class="back-btn-glass">&larr; BACK TO TOURNAMENT</a>
    </div>

    <h2 class="text-center group-main-title"><%= group.name %></h2>

    <div class="glass-panel">
        <table class="glass-table">
            <thead>
                <tr>
                    <th style="width: 250px; padding: 12px 10px; text-align: center;">PLAYER</th>
                    <th style="width: 60px; text-align: center;">PTS</th>
                    <th style="width: 60px; text-align: center;">W</th>
                    <th style="width: 60px; text-align: center;">D</th>
                    <th style="width: 60px; text-align: center;">L</th>
                    <th style="padding: 12px 10px; text-align: left; padding-left: 40px;">DECKS</th>
                </tr>
            </thead>
            <tbody>
                <% 
                // Сохраняем исходный индекс из админки для ручного тай-брейкера
                players.forEach((p, originalIndex) => { 
                    p.calcPts = (Number(p.wins) || 0) * 3 + (Number(p.draws) || 0); 
                    p.originalIndex = originalIndex;
                });
                
                // Сортировка по очкам, при равенстве — по выставленному порядку в админке
                players.sort((a, b) => {
                    if (b.calcPts !== a.calcPts) {
                        return b.calcPts - a.calcPts;
                    }
                    return a.originalIndex - b.originalIndex;
                });
                
                const isStageTwo = (group.stage === 2);

                players.forEach((p, idx) => { 
                    const isUpper = isStageTwo && idx === 0;
                    const isLower = isStageTwo && idx === 1;
                    const isElim = isStageTwo && idx >= 2;
                %>
                    <tr class="<%= isElim ? 'row-eliminated' : '' %>">
                        <td class="indicator-cell" style="padding: 16px 15px;">
                            <% if (isStageTwo) { %>
                                <div class="status-strip <%= isUpper ? 'strip-upper' : (isLower ? 'strip-lower' : 'strip-elim') %>"></div>
                            <% } %>
                            
                            <div style="display: grid; grid-template-columns: 24px 1fr; align-items: center; gap: 10px;">
                                <div style="color: #8fa0c9; font-size: 18px; font-weight: bold; text-shadow: 0 1px 2px rgba(0,0,0,0.8);">
                                    <%= idx + 1 %>
                                </div>
                                <div style="text-align: center; font-size: 22px; font-weight: bold; color: #ffffff; text-shadow: 0 2px 6px rgba(0,0,0,0.9); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    <%= p.name || 'TBA' %>
                                </div>
                            </div>
                        </td>
                        
                        <td style="text-align: center; font-size: 24px; font-weight: bold; color: #00d2ff; text-shadow: 0 0 10px rgba(0, 210, 255, 0.4);"><%= p.calcPts %></td>
                        <td style="text-align: center; font-size: 16px; color: white;"><%= p.wins || 0 %></td>
                        <td style="text-align: center; font-size: 16px; color: white;"><%= p.draws || 0 %></td>
                        <td style="text-align: center; font-size: 16px; color: white;"><%= p.losses || 0 %></td>
                        
                        <td style="padding: 16px 10px 16px 40px;">
                            <div style="display: flex; flex-direction: column; gap: 12px;">
                                
                                <!-- Верхний ряд -->
                                <div style="display: flex; gap: 30px;">
                                    <% for(let dIdx = 0; dIdx < 2; dIdx++) { 
                                        let deck = p.decks && p.decks[dIdx] ? p.decks[dIdx] : [];
                                    %>
                                        <div class="deck-box-glass">
                                            <% for(let cIdx = 0; cIdx < 3; cIdx++) { 
                                                let charId = deck[cIdx];
                                                let charImg = '/cardback.png';
                                                if(charId) {
                                                    for(let el in chars) {
                                                        let c = chars[el].find(x => String(x.id) === String(charId));
                                                        if(c && c.img) { charImg = c.img; break; }
                                                    }
                                                }
                                            %>
                                                <div class="char-icon-wrap">
                                                    <% if(charId) { %>
                                                        <img src="<%= charImg %>" onerror="this.src='/cardback.png'">
                                                    <% } else { %>
                                                        <img src="/cardback.png" style="opacity: 0.18; border-radius: 50%;">
                                                    <% } %>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Нижний ряд -->
                                <div style="display: flex; gap: 30px;">
                                    <% for(let dIdx = 2; dIdx < 4; dIdx++) { 
                                        let deck = p.decks && p.decks[dIdx] ? p.decks[dIdx] : [];
                                    %>
                                        <div class="deck-box-glass">
                                            <% for(let cIdx = 0; cIdx < 3; cIdx++) { 
                                                let charId = deck[cIdx];
                                                let charImg = '/cardback.png';
                                                if(charId) {
                                                    for(let el in chars) {
                                                        let c = chars[el].find(x => String(x.id) === String(charId));
                                                        if(c && c.img) { charImg = c.img; break; }
                                                    }
                                                }
                                            %>
                                                <div class="char-icon-wrap">
                                                    <% if(charId) { %>
                                                        <img src="<%= charImg %>" onerror="this.src='/cardback.png'">
                                                    <% } else { %>
                                                        <img src="/cardback.png" style="opacity: 0.18; border-radius: 50%;">
                                                    <% } %>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>
                                
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <% if (isStageTwo) { %>
            <div class="playoff-legend">
                <div class="legend-item">
                    <span class="legend-line" style="background: #ffcc00;"></span>
                    <span>Upper Bracket</span>
                </div>
                <div class="legend-item">
                    <span class="legend-line" style="background: #00d2ff;"></span>
                    <span>Lower Bracket</span>
                </div>
                <div class="legend-item">
                    <span class="legend-line" style="background: rgba(255, 107, 107, 0.5);"></span>
                    <span>Eliminated</span>
                </div>
            </div>
        <% } %>
    </div>

</div>

<%- include('../partials/footer') %>
