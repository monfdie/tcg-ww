<%- include('../partials/header') %>

<div class="container mt-5 mb-5">
    
    <div class="mb-4">
        <a href="/tournament/<%= tour.slug %>" class="btn btn-outline-secondary" style="border-color: #3c445c; color: #8fa0c9;">&larr; Back to Tournament</a>
    </div>

    <h2 class="text-center mb-5" style="color: #00d2ff; font-weight: bold;"><%= group.name %></h2>

    <div class="table-responsive">
        <table class="table table-dark table-hover text-center align-middle" style="background: #1b1e2b; border-radius: 8px; overflow: hidden; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 2px solid #3c445c;">
                    <th class="text-start" style="padding: 15px; color: #8fa0c9;">PLAYER</th>
                    <th style="color: #8fa0c9;">PTS</th>
                    <th style="color: #8fa0c9;">W</th>
                    <th style="color: #8fa0c9;">D</th>
                    <th style="color: #8fa0c9;">L</th>
                    <th width="40%" style="color: #8fa0c9;">DECKS</th>
                </tr>
            </thead>
            <tbody>
                <% 
                // Динамически считаем очки и сортируем игроков (Победа = 3, Ничья = 1)
                players.forEach(p => {
                    p.calcPts = (Number(p.wins) || 0) * 3 + (Number(p.draws) || 0);
                });
                players.sort((a, b) => b.calcPts - a.calcPts);
                
                players.forEach((p, idx) => { 
                %>
                    <tr style="border-bottom: 1px solid #2a2e40;">
                        <td class="text-start" style="padding: 15px; font-size: 16px; font-weight: bold;">
                            <span style="color: #5c6784; margin-right: 15px; font-size: 18px;"><%= idx + 1 %></span>
                            <%= p.name || 'TBA' %>
                        </td>
                        <td style="font-size: 20px; font-weight: bold; color: #00d2ff;"><%= p.calcPts %></td>
                        <td><%= p.wins || 0 %></td>
                        <td><%= p.draws || 0 %></td>
                        <td><%= p.losses || 0 %></td>
                        <td>
                            <div class="d-flex justify-content-center gap-3">
                                <% for(let dIdx = 0; dIdx < 4; dIdx++) { 
                                    let deck = p.decks && p.decks[dIdx] ? p.decks[dIdx] : [];
                                %>
                                    <div class="d-flex" style="gap: 2px;">
                                        <% for(let cIdx = 0; cIdx < 3; cIdx++) { 
                                            let charId = deck[cIdx];
                                            let charImg = '/logo.png';
                                            
                                            // Достаем ссылку на картинку прямо из вашего characters.json
                                            if(charId) {
                                                for(let el in chars) {
                                                    let c = chars[el].find(x => x.id == charId || x.id == parseInt(charId));
                                                    if(c) {
                                                        charImg = c.image || c.avatar || c.icon || `https://gi-tcg-assets.s3.eu-north-1.amazonaws.com/${c.id}.webp`;
                                                        break;
                                                    }
                                                }
                                            }
                                        %>
                                            <div style="width: 35px; height: 35px; border-radius: 50%; overflow: hidden; border: 1px solid #3c445c; background: #0b0d14;">
                                                <% if(charId) { %>
                                                    <img src="<%= charImg %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/logo.png'">
                                                <% } %>
                                            </div>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</div>

<%- include('../partials/footer') %>
