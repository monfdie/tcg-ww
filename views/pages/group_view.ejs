<%- include('../partials/header') %>

<div class="container mt-4 mb-5" style="max-width: 1200px;">
    
    <div class="mb-4">
        <a href="/tournament/<%= tour.slug %>" class="btn btn-outline-secondary" style="border-color: #3c445c; color: #8fa0c9;">&larr; Back to Tournament</a>
    </div>

    <h2 class="text-center mb-5" style="color: #00d2ff; font-weight: bold; font-size: 2.5rem;"><%= group.name %></h2>

    <div style="background: #1b1e2b; border: 1px solid #2a2e40; border-radius: 8px; padding: 20px;">
        <table style="width: 100%; table-layout: fixed; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 2px solid #3c445c; color: #8fa0c9; font-size: 14px;">
                    <th style="width: 250px; padding: 15px 10px; text-align: left;">PLAYER</th>
                    <th style="width: 80px; text-align: center;">PTS</th>
                    <th style="width: 80px; text-align: center;">W</th>
                    <th style="width: 80px; text-align: center;">D</th>
                    <th style="width: 80px; text-align: center;">L</th>
                    <th style="padding: 15px 10px; text-align: left;">DECKS</th>
                </tr>
            </thead>
            <tbody>
                <% 
                players.forEach(p => { p.calcPts = (Number(p.wins) || 0) * 3 + (Number(p.draws) || 0); });
                players.sort((a, b) => b.calcPts - a.calcPts);
                
                players.forEach((p, idx) => { 
                %>
                    <tr style="border-bottom: 1px solid #2a2e40;">
                        <td style="padding: 20px 10px;">
                            <div style="display: flex; align-items: center; font-size: 18px; font-weight: bold; color: white;">
                                <div style="width: 30px; text-align: right; color: #5c6784; margin-right: 15px;"><%= idx + 1 %></div>
                                <div style="flex-grow: 1; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= p.name || 'TBA' %></div>
                            </div>
                        </td>
                        
                        <td style="text-align: center; font-size: 24px; font-weight: bold; color: #00d2ff;"><%= p.calcPts %></td>
                        <td style="text-align: center; font-size: 18px; color: white;"><%= p.wins || 0 %></td>
                        <td style="text-align: center; font-size: 18px; color: white;"><%= p.draws || 0 %></td>
                        <td style="text-align: center; font-size: 18px; color: white;"><%= p.losses || 0 %></td>
                        
                        <td style="padding: 20px 10px;">
                            <div style="display: flex; flex-wrap: wrap; gap: 15px; align-items: center;">
                                <% for(let dIdx = 0; dIdx < 4; dIdx++) { 
                                    let deck = p.decks && p.decks[dIdx] ? p.decks[dIdx] : [];
                                %>
                                    <div style="display: flex; gap: 4px; background: #10121a; padding: 6px; border-radius: 8px; border: 1px solid #2a2e40;">
                                        <% for(let cIdx = 0; cIdx < 3; cIdx++) { 
                                            let charId = deck[cIdx];
                                            let charImg = '/cardback.png';
                                            
                                            // ДОСТАЕМ ИМЕННО СВОЙСТВО c.img ИЗ ВАШЕГО JSON
                                            if(charId) {
                                                for(let el in chars) {
                                                    let c = chars[el].find(x => String(x.id) === String(charId));
                                                    if(c && c.img) {
                                                        charImg = c.img; 
                                                        break;
                                                    }
                                                }
                                            }
                                        %>
                                            <div style="width: 50px; height: 50px; border-radius: 4px; overflow: hidden; border: 1px solid #3c445c; background: #0b0d14;">
                                                <% if(charId) { %>
                                                    <img src="<%= charImg %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/cardback.png'">
                                                <% } else { %>
                                                    <img src="/cardback.png" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.2;">
                                                <% } %>
                                            </div>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</div>

<%- include('../partials/footer') %>
