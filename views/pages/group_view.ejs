<%- include('../partials/header') %>

<style>
    /* Ледяная панель таблицы (Glassmorphism) */
    .glass-panel {
        background: rgba(16, 25, 45, 0.65);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-top: 1px solid rgba(255, 255, 255, 0.3);
        border-left: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 12px;
        box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(255, 255, 255, 0.02);
        padding: 20px;
    }

    /* Стили таблицы */
    .glass-table { width: 100%; table-layout: fixed; border-collapse: collapse; }
    .glass-table th { border-bottom: 2px solid rgba(255, 255, 255, 0.2); color: #aee3ff; font-size: 13px; font-weight: bold; text-shadow: 0 1px 2px rgba(0,0,0,0.8); }
    .glass-table td { border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
    .glass-table tr:last-child td { border-bottom: none; }

    /* ЧИСТЫЕ КРУГЛЫЕ ИКОНКИ (БЕЗ РАМОК И ФОНА) */
    .char-icon-wrap { 
        width: 48px; 
        height: 48px; 
        flex-shrink: 0; 
        background: transparent; 
        border: none; 
        border-radius: 50%; 
    }
    .char-icon-wrap img { 
        width: 100%; 
        height: 100%; 
        object-fit: cover; 
        border-radius: 50%; 
        border: none; /* Убрана обводка вокруг самой картинки */
        box-shadow: 0 4px 10px rgba(0,0,0,0.5); /* Легкая тень для объема */
    }
    
    /* КОНТЕЙНЕР ДЕКИ (БЕЗ ФОНА И РАМОК) */
    .deck-box-glass { 
        display: flex; 
        flex-direction: row; 
        gap: 8px; 
        background: transparent; /* Убран темный фон */
        padding: 0; /* Убраны отступы внутри рамки */
        border: none; /* Убрана рамка контейнера */
        box-shadow: none;
    }
    
    /* Кнопка назад в стиле прозрачного стекла */
    .back-btn-glass { 
        color: #e0f2ff; 
        text-decoration: none; 
        font-size: 14px; 
        font-weight: bold; 
        transition: 0.2s; 
        display: inline-block; 
        padding: 8px 16px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 6px;
        backdrop-filter: blur(5px);
    }
    .back-btn-glass:hover { background: rgba(255, 255, 255, 0.15); color: #ffffff; border-color: #00d2ff; text-decoration: none; }

    /* Градиентный заголовок группы */
    .group-main-title { 
        background: linear-gradient(180deg, #ffffff 0%, #aee3ff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0px 4px 15px rgba(0, 198, 255, 0.4);
        font-weight: bold; 
        font-size: 3rem; 
    }
</style>

<div class="container mt-4 mb-5" style="max-width: 1100px;">
    
    <div class="mb-4">
        <a href="/tournament/<%= tour.slug %>" class="back-btn-glass">&larr; BACK TO TOURNAMENT</a>
    </div>

    <h2 class="text-center mb-5 group-main-title"><%= group.name %></h2>

    <div class="glass-panel">
        <table class="glass-table">
            <thead>
                <tr>
                    <th style="width: 250px; padding: 15px 10px; text-align: left;">PLAYER</th>
                    <th style="width: 60px; text-align: center;">PTS</th>
                    <th style="width: 60px; text-align: center;">W</th>
                    <th style="width: 60px; text-align: center;">D</th>
                    <th style="width: 60px; text-align: center;">L</th>
                    <th style="padding: 15px 10px; text-align: left; padding-left: 40px;">DECKS</th>
                </tr>
            </thead>
            <tbody>
                <% 
                players.forEach(p => { p.calcPts = (Number(p.wins) || 0) * 3 + (Number(p.draws) || 0); });
                players.sort((a, b) => b.calcPts - a.calcPts);
                
                players.forEach((p, idx) => { 
                %>
                    <tr>
                        <td style="padding: 20px 10px;">
                            <div style="display: flex; align-items: center; font-size: 16px; font-weight: bold; color: white;">
                                <div style="width: 25px; text-align: right; color: #8fa0c9; margin-right: 15px; text-shadow: 0 1px 2px rgba(0,0,0,0.8);"><%= idx + 1 %></div>
                                <div style="flex-grow: 1; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-shadow: 0 1px 3px rgba(0,0,0,0.8);"><%= p.name || 'TBA' %></div>
                            </div>
                        </td>
                        
                        <td style="text-align: center; font-size: 24px; font-weight: bold; color: #00d2ff; text-shadow: 0 0 10px rgba(0, 210, 255, 0.4);"><%= p.calcPts %></td>
                        <td style="text-align: center; font-size: 16px; color: white;"><%= p.wins || 0 %></td>
                        <td style="text-align: center; font-size: 16px; color: white;"><%= p.draws || 0 %></td>
                        <td style="text-align: center; font-size: 16px; color: white;"><%= p.losses || 0 %></td>
                        
                        <td style="padding: 20px 10px 20px 40px;">
                            <!-- КОНТЕЙНЕР ДЛЯ РАССТАНОВКИ 2x2 -->
                            <div style="display: flex; flex-direction: column; gap: 15px;">
                                
                                <!-- ВЕРХНИЙ РЯД (Дека 1 и Дека 2) -->
                                <div style="display: flex; gap: 30px;">
                                    <% for(let dIdx = 0; dIdx < 2; dIdx++) { 
                                        let deck = p.decks && p.decks[dIdx] ? p.decks[dIdx] : [];
                                    %>
                                        <div class="deck-box-glass">
                                            <% for(let cIdx = 0; cIdx < 3; cIdx++) { 
                                                let charId = deck[cIdx];
                                                let charImg = '/cardback.png';
                                                if(charId) {
                                                    for(let el in chars) {
                                                        let c = chars[el].find(x => String(x.id) === String(charId));
                                                        if(c && c.img) { charImg = c.img; break; }
                                                    }
                                                }
                                            %>
                                                <div class="char-icon-wrap">
                                                    <% if(charId) { %>
                                                        <img src="<%= charImg %>" onerror="this.src='/cardback.png'">
                                                    <% } else { %>
                                                        <img src="/cardback.png" style="opacity: 0.15; border-radius: 50%;">
                                                    <% } %>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- НИЖНИЙ РЯД (Дека 3 и Дека 4) -->
                                <div style="display: flex; gap: 30px;">
                                    <% for(let dIdx = 2; dIdx < 4; dIdx++) { 
                                        let deck = p.decks && p.decks[dIdx] ? p.decks[dIdx] : [];
                                    %>
                                        <div class="deck-box-glass">
                                            <% for(let cIdx = 0; cIdx < 3; cIdx++) { 
                                                let charId = deck[cIdx];
                                                let charImg = '/cardback.png';
                                                if(charId) {
                                                    for(let el in chars) {
                                                        let c = chars[el].find(x => String(x.id) === String(charId));
                                                        if(c && c.img) { charImg = c.img; break; }
                                                    }
                                                }
                                            %>
                                                <div class="char-icon-wrap">
                                                    <% if(charId) { %>
                                                        <img src="<%= charImg %>" onerror="this.src='/cardback.png'">
                                                    <% } else { %>
                                                        <img src="/cardback.png" style="opacity: 0.15; border-radius: 50%;">
                                                    <% } %>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>
                                
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</div>

<%- include('../partials/footer') %>
