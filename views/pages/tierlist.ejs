<%- include('../partials/header') %>

<style>
    .tierlist-wrapper { max-width: 1000px; margin: 0 auto; padding-bottom: 50px; }
    .tl-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 2px solid #2a3454; padding-bottom: 15px; }
    .tl-title { font-family: 'Cinzel', serif; color: #fff; font-size: 2.2em; margin: 0; text-shadow: 0 0 10px rgba(0, 242, 254, 0.5); }
    
    /* Яркие голубые кнопки */
    .btn-action { background: linear-gradient(135deg, #00f2fe, #4facfe); color: #000; font-weight: 800; border: none; padding: 10px 22px; border-radius: 6px; cursor: pointer; font-size: 14px; text-transform: uppercase; letter-spacing: 1px; transition: 0.2s; box-shadow: 0 4px 15px rgba(0, 242, 254, 0.4); }
    .btn-action:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0, 242, 254, 0.7); background: linear-gradient(135deg, #4facfe, #00f2fe); }

    #capture-tierlist { background: #0d111a; border: 2px solid #4facfe; border-radius: 8px; overflow: hidden; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8); }
    .tier-row { display: flex; border-bottom: 1px solid #1a2235; min-height: 80px; background: rgba(16, 22, 36, 0.6); }
    .tier-row:last-child { border-bottom: none; }
    
    .tier-label { width: 100px; min-width: 100px; display: flex; align-items: center; justify-content: center; font-family: 'Segoe UI', sans-serif; font-size: 24px; font-weight: 800; color: #fff; text-shadow: 0 2px 4px rgba(0,0,0,0.8); user-select: none; border-right: 1px solid rgba(0,0,0,0.5); }
    
    /* Яркие сочные цвета тиров */
    .tier-t0 { background: linear-gradient(135deg, #ff4757, #ff6b81); } /* Красный */
    .tier-t1 { background: linear-gradient(135deg, #ffa502, #ff7f50); } /* Оранжевый */
    .tier-t2 { background: linear-gradient(135deg, #f1c40f, #eccc68); color: #000; text-shadow: none; } /* Желтый */
    .tier-t3 { background: linear-gradient(135deg, #2ed573, #7bed9f); color: #000; text-shadow: none; } /* Зеленый */
    .tier-t4 { background: linear-gradient(135deg, #1e90ff, #70a1ff); } /* Синий */
    
    .tier-dropzone { flex: 1; display: flex; flex-wrap: wrap; gap: 8px; padding: 10px; align-content: center; min-height: 80px; }

    .player-card { position: relative; width: 125px; height: 38px; background: linear-gradient(135deg, #1c2538, #131a28); border: 1px solid #4facfe; border-radius: 4px; display: flex; align-items: center; justify-content: center; padding: 0 8px; user-select: none; transition: 0.15s ease; box-shadow: 0 4px 8px rgba(0,0,0,0.5); }
    .player-card.draggable { cursor: grab; }
    .player-card.draggable:active { cursor: grabbing; box-shadow: 0 0 15px rgba(0, 242, 254, 0.6); }
    .player-card:hover { border-color: #00f2fe; box-shadow: 0 0 10px rgba(0, 242, 254, 0.3); }

    .player-name { color: #fff; font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center; width: 100%; }
    
    /* Индикаторы стрелочек */
    .trend-icon { position: absolute; right: -4px; top: -6px; font-size: 14px; font-weight: 900; background: #0d111a; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 5px rgba(0,0,0,0.5); }
    .trend-up { color: #00ff88; text-shadow: 0 0 5px rgba(0, 255, 136, 0.5); }
    .trend-down { color: #ff0055; text-shadow: 0 0 5px rgba(255, 0, 85, 0.5); }
    .trend-none { display: none; }

    .pool-section { margin-top: 30px; background: rgba(16, 22, 36, 0.9); border: 2px dashed #4facfe; border-radius: 8px; padding: 15px; display: none; box-shadow: inset 0 0 20px rgba(0, 242, 254, 0.05); }
    .pool-title { color: #00f2fe; font-size: 14px; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 15px; text-shadow: 0 0 5px rgba(0, 242, 254, 0.3); }
    .pool-dropzone { display: flex; flex-wrap: wrap; gap: 8px; min-height: 90px; }

    .create-own-box { text-align: center; margin-top: 40px; padding-top: 30px; border-top: 1px solid #2a3454; }

    /* Поле добавления игрока для обычных пользователей */
    .add-player-box { margin-top: 20px; display: flex; gap: 10px; display: none; }
    .add-player-box input { flex: 1; padding: 12px; background: #0b0d17; color: #fff; border: 1px solid #4facfe; border-radius: 4px; font-weight: bold; outline: none; }
    .add-player-box input:focus { box-shadow: 0 0 10px rgba(0, 242, 254, 0.3); }
</style>

<div class="tierlist-wrapper">
    <div class="tl-header">
        <h1 class="tl-title" id="page-title">OFFICIAL TIERLIST</h1>
        <button class="btn-action" onclick="downloadTierlist()">📸 Save Image</button>
    </div>

    <div id="capture-tierlist">
        <% const tiers = ['t0', 't1', 't2', 't3', 't4']; %>
        <% tiers.forEach((tier, index) => { %>
        <div class="tier-row">
            <div class="tier-label tier-<%= tier %>">T<%= index %></div>
            <div class="tier-dropzone" id="<%= tier %>">
                <% tierlistData[tier].forEach(player => { %>
                    <div class="player-card">
                        <span class="player-name"><%= player.name %></span>
                        <div class="trend-icon trend-<%= player.trend %>"><%= player.trend === 'up' ? '▲' : (player.trend === 'down' ? '▼' : '') %></div>
                    </div>
                <% }) %>
            </div>
        </div>
        <% }) %>
    </div>

    <div class="pool-section" id="pool-container">
        <div class="pool-title">Unassigned Players</div>
        <div class="pool-dropzone" id="unassigned">
            <% tierlistData.unassigned.forEach(player => { %>
                <div class="player-card">
                    <span class="player-name"><%= player.name %></span>
                </div>
            <% }) %>
        </div>

        <!-- Контейнер для добавления своих игроков -->
        <div class="add-player-box" id="user-add-player-box">
            <input type="text" id="new-player-input" placeholder="Type new player name here to add them to your tierlist..." onkeypress="if(event.key === 'Enter') addPlayer()">
            <button class="btn-action" onclick="addPlayer()">+ Add</button>
        </div>
    </div>

    <div class="create-own-box" id="create-own-container">
        <p style="color: #8da4c4; margin-bottom: 15px; font-size: 16px;">Want to share your own vision of the meta?</p>
        <button class="btn-action" style="background: transparent; border: 2px solid #00f2fe; color: #00f2fe; box-shadow: 0 0 10px rgba(0,242,254,0.2);" onclick="enableBuilderMode()">✨ Create Your Own</button>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
    function enableBuilderMode() {
        document.getElementById('page-title').innerText = "MY TIERLIST";
        document.getElementById('pool-container').style.display = 'block';
        document.getElementById('user-add-player-box').style.display = 'flex'; // Показываем поле добавления
        document.getElementById('create-own-container').style.display = 'none';

        const unassignedPool = document.getElementById('unassigned');
        
        document.querySelectorAll('.player-card').forEach(card => {
            const trend = card.querySelector('.trend-icon');
            if(trend) trend.remove();
            
            card.classList.add('draggable');
            if(card.parentElement.id !== 'unassigned') {
                unassignedPool.appendChild(card);
            }
        });

        const zones = ['t0', 't1', 't2', 't3', 't4', 'unassigned'].map(id => document.getElementById(id));
        zones.forEach(zone => {
            new Sortable(zone, {
                group: 'tierlist',
                animation: 150,
                ghostClass: 'sortable-ghost',
                touchStartThreshold: 5
            });
        });
    }

    // Функция добавления игрока для обычного пользователя
    function addPlayer() {
        const input = document.getElementById('new-player-input');
        const name = input.value.trim();
        if (!name) return;

        const card = document.createElement('div');
        card.className = 'player-card draggable';
        card.innerHTML = `<span class="player-name">${name}</span>`;
        
        document.getElementById('unassigned').appendChild(card);
        input.value = '';
    }

    async function downloadTierlist() {
        const area = document.getElementById('capture-tierlist');
        const canvas = await html2canvas(area, { backgroundColor: '#0d111a', scale: 2 });
        const link = document.createElement('a');
        link.download = 'gitcg_tierlist.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
    }
</script>

<%- include('../partials/footer') %>
