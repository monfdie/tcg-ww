<%- include('../partials/header') %>

<style>
    .tierlist-wrapper { max-width: 1000px; margin: 0 auto; padding-bottom: 50px; }
    
    .tl-header { 
        display: flex; 
        justify-content: center; 
        align-items: center; 
        margin-bottom: 20px; 
        border-bottom: 2px solid #2a3454; 
        padding-bottom: 15px; 
        position: relative;
    }
    
    .tl-title { font-family: 'Cinzel', serif; color: #fff; font-size: 2.2em; margin: 0; }
    
    .btn-action { background: linear-gradient(135deg, #4facfe, #00f2fe); color: #050b14; font-weight: bold; border: none; padding: 10px 22px; border-radius: 4px; cursor: pointer; font-size: 14px; text-transform: uppercase; letter-spacing: 1px; transition: 0.2s; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
    .btn-action:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(79, 172, 254, 0.4); }

    /* Переключение версий */
    .version-controls { display: flex; align-items: center; gap: 15px; }
    .version-arrow {
        color: #e6edf8;
        font-size: 20px;
        text-decoration: none;
        transition: 0.2s;
        cursor: pointer;
        padding: 4px 12px;
        background: rgba(16, 22, 36, 0.6);
        border: 1px solid #3c4b70;
        border-radius: 6px;
        user-select: none;
    }
    .version-arrow:hover:not(.disabled) {
        background: #202a40;
        border-color: #4facfe;
        color: #4facfe;
    }
    .version-arrow.disabled { opacity: 0.2; cursor: default; }

    /* Фон тирлиста */
    #capture-tierlist { background-color: #0d111a; border: 2px solid #2a3454; border-radius: 0; overflow: hidden; }
    .tier-row { display: flex; border-bottom: 1px solid #1a2235; min-height: 80px; background-color: rgba(16, 22, 36, 0.6); }
    .tier-row:last-child { border-bottom: none; }
    
    .tier-label { width: 100px; min-width: 100px; display: flex; align-items: center; justify-content: center; font-family: 'Segoe UI', sans-serif; font-size: 24px; font-weight: 800; color: #222; user-select: none; border-right: 1px solid #0d111a; }
    
    .tier-t0 { background-color: #ff7f7f !important; background-image: none !important; }
    .tier-t1 { background-color: #ffbf7f !important; background-image: none !important; }
    .tier-t2 { background-color: #ffdf7f !important; background-image: none !important; }
    .tier-t3 { background-color: #ffff7f !important; background-image: none !important; }
    .tier-t4 { background-color: #bfff7f !important; background-image: none !important; }
    
    .tier-dropzone { flex: 1; display: flex; flex-wrap: wrap; gap: 8px; padding: 10px; align-content: center; min-height: 80px; }

    /* Карточки игроков */
    .player-card { position: relative; width: 125px; height: 38px; background: linear-gradient(135deg, #182238, #101726); border: 1px solid #3c4b70; border-radius: 4px; display: flex; align-items: center; justify-content: center; padding: 0 8px; user-select: none; transition: 0.15s ease; box-shadow: 0 4px 10px rgba(0,0,0,0.4); }
    .player-card.draggable { cursor: grab; }
    .player-card.draggable:active { cursor: grabbing; border-color: #4facfe; }
    .player-card:hover { border-color: #4facfe; background: #202a40; }

    .player-name { color: #e6edf8; font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center; width: 100%; }
    
    /* Индикаторы стрелочек и плашки NEW */
    .trend-icon { position: absolute; right: -6px; top: -6px; font-size: 11px; font-weight: bold; background: #0d111a; border: 1px solid #2e3b52; border-radius: 50%; width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; }
    .trend-up { color: #2ecc71; border-color: #2ecc71; }
    .trend-down { color: #e74c3c; border-color: #e74c3c; }
    
    .trend-new {
        position: absolute;
        right: -8px;
        top: -7px;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.5px;
        background: #002b33;
        color: #00f2fe;
        border: 1px solid #00f2fe;
        border-radius: 10px;
        padding: 1px 5px;
        box-shadow: 0 0 8px rgba(0, 242, 254, 0.4);
    }
    .trend-none { display: none; }

    .pool-section { margin-top: 30px; background: rgba(16, 22, 36, 0.6); border: 1px dashed #3c4b70; border-radius: 4px; padding: 15px; display: none; }
    .pool-title { color: #8da4c4; font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 15px; }
    .pool-dropzone { display: flex; flex-wrap: wrap; gap: 8px; min-height: 90px; }

    .create-own-box { text-align: center; margin-top: 40px; padding-top: 30px; border-top: 1px solid #2a3454; }

    .add-player-box { margin-top: 20px; display: flex; gap: 10px; display: none; }
    .add-player-box input { flex: 1; padding: 12px; background: #0b0d17; color: #fff; border: 1px solid #3c4b70; border-radius: 4px; outline: none; }
    .add-player-box input:focus { border-color: #4facfe; }
</style>

<div class="tierlist-wrapper">
    <div class="tl-header">
        
        <div class="version-controls" id="version-controls">
            <% if (prevVersion) { %>
                <a href="/tierlist?v=<%= prevVersion %>" class="version-arrow" title="Older Version">❮</a>
            <% } else { %>
                <span class="version-arrow disabled">❮</span>
            <% } %>

            <h1 class="tl-title" id="page-title">TIERLIST <span style="color:#00f2fe;">v<%= currentVersion %></span></h1>

            <% if (nextVersion) { %>
                <a href="/tierlist?v=<%= nextVersion %>" class="version-arrow" title="Newer Version">❯</a>
            <% } else { %>
                <span class="version-arrow disabled">❯</span>
            <% } %>
        </div>

        <button class="btn-action" style="position: absolute; right: 0;" onclick="downloadTierlist()">SAVE IMAGE</button>
    </div>

    <div id="capture-tierlist">
        <% const tiers = ['t0', 't1', 't2', 't3', 't4']; %>
        <% const tierLabels = ['S', 'A', 'B', 'C', 'D']; %>
        <% tiers.forEach((tier, index) => { %>
        <div class="tier-row">
            <div class="tier-label tier-<%= tier %>"><%= tierLabels[index] %></div>
            <div class="tier-dropzone" id="<%= tier %>">
                <% tierlistData[tier].forEach(player => { %>
                    <div class="player-card">
                        <span class="player-name"><%= player.name %></span>
                        <% if (player.trend === 'new') { %>
                            <div class="trend-new">NEW</div>
                        <% } else { %>
                            <div class="trend-icon trend-<%= player.trend %>"><%= player.trend === 'up' ? '▲' : (player.trend === 'down' ? '▼' : '') %></div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        </div>
        <% }) %>
    </div>

    <div class="pool-section" id="pool-container">
        <div class="pool-title">Unassigned Players</div>
        <div class="pool-dropzone" id="unassigned">
            <% tierlistData.unassigned.forEach(player => { %>
                <div class="player-card">
                    <span class="player-name"><%= player.name %></span>
                </div>
            <% }) %>
        </div>

        <div class="add-player-box" id="user-add-player-box">
            <input type="text" id="new-player-input" placeholder="Type new player name here to add them to your tierlist..." onkeypress="if(event.key === 'Enter') addPlayer()">
            <button class="btn-action" onclick="addPlayer()">+ ADD</button>
        </div>
    </div>

    <div class="create-own-box" id="create-own-container">
        <p style="color: #8da4c4; margin-bottom: 15px; font-size: 16px;">Want to share your own vision of the meta?</p>
        <button class="btn-action" style="background: transparent; border: 1px solid #4facfe; color: #4facfe; box-shadow: none;" onclick="enableBuilderMode()">CREATE YOUR OWN</button>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
    function enableBuilderMode() {
        document.getElementById('page-title').innerText = "MY TIERLIST";
        document.querySelectorAll('.version-arrow').forEach(el => el.style.display = 'none');
        
        document.getElementById('pool-container').style.display = 'block';
        document.getElementById('user-add-player-box').style.display = 'flex';
        document.getElementById('create-own-container').style.display = 'none';

        const unassignedPool = document.getElementById('unassigned');
        
        document.querySelectorAll('.player-card').forEach(card => {
            const trend = card.querySelector('.trend-icon, .trend-new');
            if(trend) trend.remove();
            
            card.classList.add('draggable');
            if(card.parentElement.id !== 'unassigned') {
                unassignedPool.appendChild(card);
            }
        });

        const zones = ['t0', 't1', 't2', 't3', 't4', 'unassigned'].map(id => document.getElementById(id));
        zones.forEach(zone => {
            new Sortable(zone, {
                group: 'tierlist',
                animation: 150,
                ghostClass: 'sortable-ghost',
                touchStartThreshold: 5
            });
        });
    }

    function addPlayer() {
        const input = document.getElementById('new-player-input');
        const name = input.value.trim();
        if (!name) return;

        const card = document.createElement('div');
        card.className = 'player-card draggable';
        card.innerHTML = `<span class="player-name">${name}</span>`;
        
        document.getElementById('unassigned').appendChild(card);
        input.value = '';
    }

    async function downloadTierlist() {
        const area = document.getElementById('capture-tierlist');
        const canvas = await html2canvas(area, { backgroundColor: '#0d111a', scale: 2 });
        const link = document.createElement('a');
        link.download = 'gitcg_tierlist.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
    }
</script>

<%- include('../partials/footer') %>
