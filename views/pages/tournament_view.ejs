<%- include('../partials/header') %>

<style>
    /* Стили для переключателя этапов и кнопок-ссылок */
    .stage-switcher { display: flex; gap: 15px; margin: 30px 0 40px 0; justify-content: center; }
    .stage-btn, .link-btn {
        background: #1b1e2b;
        border: 1px solid #3c445c;
        color: #8fa0c9;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.2s;
        text-transform: uppercase;
        font-size: 14px;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }
    .stage-btn { min-width: 150px; }
    .stage-btn.active { background: #00d2ff; color: #000; border-color: #00d2ff; }
    .stage-btn:hover:not(.active), .link-btn:hover { background: #2a2e40; color: white; text-decoration: none; }
    
    /* Сетка групп: строго 4 в ряд */
    .groups-grid { display: none; grid-template-columns: repeat(4, 1fr); gap: 20px; }
    .groups-grid.active-grid { display: grid; }
    
    .public-group-card { background: #1b1e2b; border: 1px solid #2a2e40; border-radius: 8px; padding: 20px; text-align: center; cursor: pointer; transition: 0.2s; text-decoration: none; color: white; display: block; }
    .public-group-card:hover { border-color: #00d2ff; transform: translateY(-3px); box-shadow: 0 4px 12px rgba(0, 210, 255, 0.1); color: white; text-decoration: none; }
    .public-group-title { font-weight: bold; margin-bottom: 15px; font-size: 18px; color: #00d2ff; }
    .public-group-player { font-size: 14px; margin-bottom: 5px; color: #c4d0eb; }
    
    /* Стили текста из шапки */
    .tour-info-line { font-size: 16px; color: #8fa0c9; margin-bottom: 3px; }
    .tour-info-line strong { color: white; }
    
    /* Адаптивность для меньших экранов */
    @media (max-width: 992px) { .groups-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 576px) { .groups-grid { grid-template-columns: 1fr; } }
</style>

<div class="container mt-4 mb-5">
    
    <!-- ШАПКА ТУРНИРА -->
    <div class="mb-4">
        <% if(tour.image) { %>
            <img src="/uploads/<%= tour.image %>" class="img-fluid" style="width: 100%; max-height: 450px; object-fit: cover; object-position: center; border-radius: 4px;" alt="<%= tour.title %>">
        <% } else { %>
            <img src="/logo.png" class="img-fluid" style="width: 100%; max-height: 400px; object-fit: cover; object-position: center; border-radius: 4px;" alt="Logo">
        <% } %>
    </div>

    <!-- Заголовок -->
    <h1 style="color: #00d2ff; font-weight: bold; font-size: 2.5rem; margin-bottom: 25px;"><%= tour.title %></h1>
    
    <!-- Описание (если есть) -->
    <% if (tour.description) { %>
        <p style="color: #c4d0eb; font-size: 16px; margin-bottom: 20px; line-height: 1.6;"><%= tour.description %></p>
    <% } %>

    <!-- Информация (Даты, призы и т.д.) -->
    <div class="mb-4">
        <div class="tour-info-line"><strong>Date:</strong> <%= tour.date || 'TBA' %></div>
        <div class="tour-info-line"><strong>Prize Pool:</strong> <%= tour.prize || 'TBA' %></div>
        <div class="tour-info-line"><strong>Region:</strong> <%= tour.region || 'Any' %></div>
        <div class="tour-info-line"><strong>Format:</strong> <%= tour.format || 'TBA' %></div>
    </div>

    <!-- Ссылки в виде кнопок -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <% if(tour.regLink) { %><a href="<%= tour.regLink %>" class="link-btn" target="_blank">Register</a><% } %>
        <% if(tour.rulesLink) { %><a href="<%= tour.rulesLink %>" class="link-btn" target="_blank">Rules (RU)</a><% } %>
        <% if(tour.rulesEnLink) { %><a href="<%= tour.rulesEnLink %>" class="link-btn" target="_blank">Rules (EN)</a><% } %>
        <% if(tour.discordLink) { %><a href="<%= tour.discordLink %>" class="link-btn" target="_blank">Discord</a><% } %>
        <% if(tour.telegramLink) { %><a href="<%= tour.telegramLink %>" class="link-btn" target="_blank">Telegram</a><% } %>
        <% if(tour.bracketLink) { %><a href="<%= tour.bracketLink %>" class="link-btn" target="_blank">Bracket</a><% } %>
    </div>

    <hr style="border-color: #3c445c; margin-bottom: 30px;">
    <!-- КОНЕЦ ШАПКИ -->

    <!-- СЕТКА ГРУПП -->
    <% if (tour.groups && tour.groups.length > 0) { %>
        <div class="stage-switcher">
            <button class="stage-btn active" onclick="showPublicStage(1)" id="p-tab-1">Group Stage 1</button>
            <button class="stage-btn" onclick="showPublicStage(2)" id="p-tab-2">Group Stage 2</button>
            <button class="stage-btn" onclick="alert('Play-offs coming soon!')">Play-offs</button>
        </div>

        <div id="p-stage-1" class="groups-grid active-grid">
            <% tour.groups.filter(g => g.stage === 1).forEach(group => { %>
                <a href="/tournament/<%= tour.slug %>/group/<%= group._id %>" class="public-group-card">
                    <div class="public-group-title"><%= group.name %></div>
                    <% group.players.forEach(p => { %>
                        <div class="public-group-player"><%= p.name || 'TBA' %></div>
                    <% }) %>
                </a>
            <% }) %>
        </div>

        <div id="p-stage-2" class="groups-grid">
            <% tour.groups.filter(g => g.stage === 2).forEach(group => { %>
                <a href="/tournament/<%= tour.slug %>/group/<%= group._id %>" class="public-group-card">
                    <div class="public-group-title"><%= group.name %></div>
                    <% group.players.forEach(p => { %>
                        <div class="public-group-player"><%= p.name || 'TBA' %></div>
                    <% }) %>
                </a>
            <% }) %>
        </div>

        <script>
            function showPublicStage(stage) {
                document.getElementById('p-tab-1').classList.toggle('active', stage === 1);
                document.getElementById('p-tab-2').classList.toggle('active', stage === 2);
                document.getElementById('p-stage-1').classList.toggle('active-grid', stage === 1);
                document.getElementById('p-stage-2').classList.toggle('active-grid', stage === 2);
            }
        </script>
    <% } else { %>
        <div class="text-center text-muted mt-5 mb-5" style="font-size: 16px;">No groups have been added to this tournament yet.</div>
    <% } %>

</div>

<%- include('../partials/footer') %>
