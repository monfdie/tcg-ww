<%- include('../partials/header') %>

<style>
    /* Панель кнопок этапов */
    .stage-switcher { 
        display: flex; 
        gap: 12px; 
        margin: 20px 0 25px 0; 
        justify-content: center; 
        flex-wrap: wrap; 
    }
    
    /* Кнопки ссылок (Register, Rules, Discord...) */
    .link-btn {
        background: rgba(20, 30, 50, 0.6);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-top: 1px solid rgba(255, 255, 255, 0.3);
        color: #e0f2ff;
        padding: 8px 18px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        text-transform: uppercase;
        font-size: 13px;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }
    .link-btn:hover { 
        background: rgba(255, 255, 255, 0.1); 
        border-color: #00d2ff; 
        color: #ffffff; 
        text-decoration: none; 
    }

    /* Спокойные матовые Крио-кнопки переключения этапов (без подсветки) */
    .stage-btn {
        background: rgba(25, 45, 70, 0.45);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(100, 205, 245, 0.25);
        color: #d6f2ff;
        padding: 9px 20px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: 0.5px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-width: 140px;
        box-shadow: none;
    }

    .stage-btn:hover:not(.active) {
        background: rgba(40, 75, 115, 0.6);
        border-color: rgba(100, 205, 245, 0.5);
        color: #ffffff;
        box-shadow: none;
    }

    /* Активная матовая кнопка без свечения */
    .stage-btn.active {
        background: #4abde8;
        color: #082236;
        border: 1px solid #4abde8;
        font-weight: 800;
        box-shadow: none;
        text-shadow: none;
    }

    /* Маленькие кнопки подэтапов внутри статистики */
    .sub-switch-btn {
        padding: 6px 16px !important;
        font-size: 12px !important;
        min-width: 100px !important;
        border-radius: 6px !important;
    }
    
    /* Сетка групп (Stage 1 и 2) */
    .groups-grid { display: none; grid-template-columns: repeat(4, 1fr); gap: 20px; }
    .groups-grid.active-grid { display: grid; }
    
    /* Сетка плей-офф */
    .playoffs-grid { display: none; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
    .playoffs-grid.active-grid { display: grid; }

    /* Карточки групп и игроков */
    .public-group-card { 
        background: rgba(16, 25, 45, 0.65); 
        backdrop-filter: blur(12px); 
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1); 
        border-top: 1px solid rgba(255, 255, 255, 0.3); 
        border-left: 1px solid rgba(255, 255, 255, 0.3); 
        border-radius: 12px; 
        padding: 20px; 
        text-align: center; 
        cursor: pointer; 
        transition: all 0.3s ease; 
        text-decoration: none; 
        color: white; 
        display: block; 
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4), inset 0 0 20px rgba(255, 255, 255, 0.02);
    }
    .public-group-card:hover { 
        border-color: rgba(0, 210, 255, 0.6); 
        transform: translateY(-5px); 
        box-shadow: 0 12px 40px rgba(0, 163, 255, 0.25), inset 0 0 20px rgba(255, 255, 255, 0.05); 
        color: white; 
        text-decoration: none; 
    }

    .playoff-player-card {
        background: rgba(16, 25, 45, 0.65); 
        backdrop-filter: blur(12px); 
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.15); 
        border-top: 1px solid rgba(255, 255, 255, 0.35); 
        border-left: 1px solid rgba(255, 255, 255, 0.35); 
        border-radius: 12px; 
        padding: 20px 15px; 
        text-align: center; 
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
    }
    
    .public-group-title { 
        background: linear-gradient(180deg, #ffffff 0%, #aee3ff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0px 4px 15px rgba(0, 198, 255, 0.4);
        font-weight: bold; 
        margin-bottom: 20px; 
        font-size: 20px; 
    }

    .players-list-wrapper { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; }
    .public-group-player { font-size: 17px; color: #ffffff; text-shadow: 0 1px 2px rgba(0,0,0,0.8); font-weight: 500; }
    
    /* 5 рядов дек для плей-офф с аккуратными рамочками */
    .playoff-decks-container { display: flex; flex-direction: column; gap: 8px; align-items: center; justify-content: center; }
    .playoff-deck-box { 
        display: flex; 
        gap: 8px; 
        justify-content: center; 
        align-items: center; 
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 25px;
        padding: 4px 10px;
        box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.2);
    }
    .playoff-char-wrap { width: 40px; height: 40px; border-radius: 50%; background: transparent; flex-shrink: 0; }
    .playoff-char-wrap img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; box-shadow: 0 3px 8px rgba(0,0,0,0.5); }

    /* Панель статистики */
    .stats-section { display: none; }
    .stats-type-content { display: none; }
    .stats-type-content.active-type { display: block; }
    
    .stats-stage-content { display: none; }
    .stats-stage-content.active-stage { display: block; }
    
    .stats-glass-panel {
        max-width: 780px;
        margin: 0 auto;
        background: rgba(18, 29, 50, 0.65);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(174, 227, 255, 0.2);
        border-top: 1px solid rgba(255, 255, 255, 0.35);
        border-left: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 12px;
        box-shadow: 0 12px 35px 0 rgba(0, 0, 0, 0.4), inset 0 0 18px rgba(174, 227, 255, 0.04);
        padding: 15px 25px;
    }

    .stats-table { width: 100%; border-collapse: collapse; margin: 0 auto; }
    .stats-table th { 
        border-bottom: 2px solid rgba(174, 227, 255, 0.2); 
        color: #aee3ff; 
        font-size: 13px; 
        font-weight: bold; 
        text-shadow: 0 1px 2px rgba(0,0,0,0.8); 
        padding: 12px 10px; 
        text-transform: uppercase; 
        letter-spacing: 1px;
    }
    .stats-table td { border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding: 12px 10px; vertical-align: middle; }
    .stats-table tr:last-child td { border-bottom: none; }

    .stats-rank { font-size: 20px; font-weight: bold; text-shadow: 0 2px 5px rgba(0,0,0,0.8); }
    .rank-1 { color: #ffcc00; }
    .rank-2 { color: #d1d5db; }
    .rank-3 { color: #cd7f32; }
    .rank-default { color: #8fa0c9; font-size: 16px; }

    .stats-char-single { width: 54px; height: 54px; border-radius: 50%; object-fit: cover; box-shadow: 0 4px 10px rgba(0,0,0,0.5); }
    .stats-char-item { width: 50px; height: 50px; border-radius: 50%; object-fit: cover; box-shadow: 0 4px 10px rgba(0,0,0,0.5); }
    
    .stats-count { font-size: 18px; font-weight: bold; color: #ffffff; text-shadow: 0 0 10px rgba(0, 210, 255, 0.4); }
    .stats-count-label { font-size: 12px; color: #aee3ff; margin-left: 4px; font-weight: normal; text-transform: uppercase; }

    .tour-info-line { font-size: 18px; color: #aee3ff; margin-bottom: 8px; text-shadow: 0 1px 3px rgba(0,0,0,0.8); }
    .tour-info-line strong { color: #ffffff; }
    
    .tour-main-title {
        background: linear-gradient(180deg, #ffffff 0%, #80d4ff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0px 2px 10px rgba(0, 163, 255, 0.5);
        font-weight: bold; 
        font-size: 2.8rem; 
        margin-bottom: 20px;
        margin-top: 15px;
        letter-spacing: 1px;
    }

    .tournament-page { max-width: 1240px; padding-bottom: 48px; }
    .tournament-hero { display: grid; grid-template-columns: minmax(260px, 38%) 1fr; min-height: 330px; overflow: hidden; border: 1px solid rgba(143, 183, 224, .24); border-radius: 22px; background: linear-gradient(125deg, #172944, #101827 70%); box-shadow: 0 24px 70px rgba(2, 7, 18, .38); }
    .tournament-hero-art { min-height: 100%; position: relative; overflow: hidden; background: radial-gradient(circle, #284b71, #101827); }
    .tournament-hero-art img { display: block; width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; }
    .tournament-hero-art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent 65%, #172944); }
    .tournament-hero-content { padding: clamp(24px, 3vw, 42px); display: flex; flex-direction: column; justify-content: center; }
    .tournament-eyebrow, .tournament-section-kicker { color: #84d9ee; font-size: 11px; font-weight: 800; letter-spacing: .16em; }
    .tournament-status-dot { display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: #67dbc3; box-shadow: 0 0 12px #67dbc3; }
    .tournament-page .tour-main-title { margin: 12px 0 8px; color: #f5f9ff; background: none; -webkit-text-fill-color: currentColor; text-shadow: none; font-size: clamp(28px, 3vw, 45px); line-height: 1.08; letter-spacing: -.025em; }
    .tournament-description { margin: 0 0 20px; color: #b9cce0; line-height: 1.5; max-width: 65ch; }
    .tournament-facts { display: flex; flex-wrap: wrap; gap: 18px 28px; padding: 16px 0; border-top: 1px solid rgba(174, 227, 255, .14); border-bottom: 1px solid rgba(174, 227, 255, .14); }
    .tournament-facts div { display: flex; flex-direction: column; gap: 3px; min-width: 80px; }
    .tournament-facts span { color: #7897b5; font-size: 10px; font-weight: 800; letter-spacing: .13em; }
    .tournament-facts strong { color: #f0f7ff; font-size: 14px; font-weight: 650; }
    .tournament-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
    .tournament-page .link-btn { min-width: 0; padding: 9px 14px; margin: 0; border: 1px solid rgba(143, 183, 224, .25); border-radius: 9px; background: rgba(255, 255, 255, .035); box-shadow: none; color: #d5e7f9; font-size: 11px; letter-spacing: .04em; }
    .tournament-page .link-btn:hover { background: rgba(118, 212, 245, .12); border-color: #76d4f5; }
    .tournament-page .global-ban-panel { margin: 18px 0 28px; padding: 24px; border: 1px solid rgba(143, 183, 224, .23); border-radius: 18px; background: linear-gradient(135deg, #17273e, #121b2b); box-shadow: 0 18px 45px rgba(2, 7, 18, .24); }
    .global-ban-intro { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; }
    .global-ban-intro h2, .global-ban-dialog h2 { color: #f5f9ff; font-size: 23px; font-weight: 750; margin: 3px 0 5px; }
    .global-ban-intro p { color: #a9c0d8; font-size: 13px; line-height: 1.5; margin: 0; }
    .global-ban-status { color: #9de9cf; border: 1px solid rgba(157, 233, 207, .35); background: rgba(157, 233, 207, .08); border-radius: 30px; padding: 5px 10px; white-space: nowrap; font-size: 11px; font-weight: 700; }
    .global-ban-slots { display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0 18px; }
    .global-ban-slot { width: 64px; height: 64px; display: grid; place-items: center; padding: 6px; border: 1px solid rgba(143, 183, 224, .28); border-radius: 15px; background: linear-gradient(145deg, rgba(43, 64, 91, .65), rgba(11, 22, 39, .9)); box-shadow: inset 0 1px rgba(255,255,255,.07), 0 6px 16px rgba(2,7,18,.18); }
    .global-ban-slot:has(img) { border-color: rgba(233, 132, 136, .55); background: linear-gradient(145deg, rgba(233, 132, 136, .16), rgba(20, 34, 56, .9)); }
    .global-ban-slot img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 2px solid #e98488; box-shadow: 0 0 0 2px rgba(233, 132, 136, .14); }
    .global-ban-slot-empty { width: 45px; height: 45px; display: grid; place-items: center; border: 1px dashed rgba(143,183,224,.35); border-radius: 50%; color: #7899b8; font-size: 23px; line-height: 1; }
    .challonge-panel { margin: 24px 0; padding: 18px; border: 1px solid rgba(143,183,224,.2); border-radius: 15px; background: #142238; }
    .challonge-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
    .challonge-panel-head h2 { margin: 0; }
    .challonge-panel iframe { display: block; width: 100%; height: 620px; border: 0; border-radius: 9px; background: #0d192b; }
    .global-ban-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 9px; }
    .global-ban-actions #global-ban-message { margin-left: auto; color: #8fa9c3; font-size: 12px; }
    .tournament-page .global-ban-primary, .global-ban-dialog .global-ban-primary { background: #7dd9ee; color: #092031; border-color: #7dd9ee; font-weight: 800; }
    .tournament-page .global-ban-primary:hover, .global-ban-dialog .global-ban-primary:hover { background: #b3f0ff; color: #092031; }
    .tournament-page .stage-switcher { justify-content: flex-start; margin: 24px 0 20px; padding: 5px; border: 1px solid rgba(143,183,224,.2); border-radius: 12px; width: fit-content; background: rgba(11,20,34,.65); }
    .tournament-page .stage-btn { min-width: 0; border: 0; border-radius: 8px; padding: 9px 16px; background: transparent; box-shadow: none; color: #9db5ce; }
    .tournament-page .stage-btn.active { background: #74cfe8; color: #092031; }
    .tournament-page .public-group-card, .tournament-page .playoff-player-card, .tournament-page .stats-glass-panel { border: 1px solid rgba(143,183,224,.2); border-radius: 15px; background: #142238; box-shadow: 0 10px 30px rgba(2,7,18,.22); backdrop-filter: none; }
    .tournament-page .public-group-card:hover { transform: translateY(-3px); border-color: #74cfe8; box-shadow: 0 16px 34px rgba(2,7,18,.3); }
    .tournament-page .public-group-title { background: none; -webkit-text-fill-color: #eef7ff; text-shadow: none; }
    .global-ban-modal[hidden] { display: none !important; }
    .global-ban-modal { position: fixed; inset: 0; z-index: 3000; display: grid; place-items: center; padding: 20px; background: rgba(2, 7, 18, .76); backdrop-filter: blur(8px); }
    .global-ban-dialog { width: min(720px, 100%); max-height: min(760px, 92dvh); display: flex; flex-direction: column; overflow: hidden; border: 1px solid rgba(143,183,224,.4); border-radius: 18px; background: #142238; box-shadow: 0 30px 100px rgba(0,0,0,.55); }
    .global-ban-dialog-head, .global-ban-dialog-tools, .global-ban-dialog-foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 22px; }
    .global-ban-dialog-head { border-bottom: 1px solid rgba(143,183,224,.16); }
    .global-ban-dialog h2 { margin-bottom: 0; }
    .global-ban-close { background: none; border: 0; color: #bdd1e5; font-size: 28px; line-height: 1; padding: 0 5px; }
    .global-ban-dialog-tools { padding-top: 14px; padding-bottom: 10px; color: #9de9cf; font-weight: 700; font-size: 12px; }
    .global-ban-dialog .global-ban-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); gap: 8px; min-height: 180px; max-height: none; overflow-y: auto; padding: 4px 22px 18px; margin: 0; }
    .global-ban-dialog .global-ban-option { min-width: 0; padding: 7px; background: #1b2d46; border-color: rgba(143,183,224,.15); border-radius: 9px; }
    .global-ban-dialog .global-ban-option:hover { border-color: #74cfe8; }
    .global-ban-dialog .global-ban-option:has(input:checked) { background: #354052; border-color: #e98488; }
    .global-ban-dialog .global-ban-option img { width: 100%; height: auto; aspect-ratio: 1; }
    .global-ban-dialog-foot { border-top: 1px solid rgba(143,183,224,.16); color: #a8bfd7; font-size: 12px; }
    .global-ban-dialog-foot .link-btn { flex: none; margin: 0; }
    body.modern-site .tournament-page .global-ban-primary, body.modern-site .global-ban-dialog .global-ban-primary { background: #7dd9ee !important; border-color: #7dd9ee !important; color: #092031 !important; font-weight: 800; }
    body.modern-site .tournament-page .global-ban-primary:hover, body.modern-site .global-ban-dialog .global-ban-primary:hover { background: #b3f0ff !important; border-color: #b3f0ff !important; }
    body.modern-site .global-ban-dialog .global-ban-close { background: transparent !important; border: 0 !important; padding: 0 5px; color: #bdd1e5 !important; font-size: 28px; }
    body.modern-site .tournament-page .stage-btn.active { background: #74cfe8 !important; border-color: #74cfe8 !important; color: #092031 !important; }

    @media (max-width: 992px) { .groups-grid { grid-template-columns: repeat(2, 1fr); } .tournament-hero { grid-template-columns: 34% 1fr; } }
    @media (max-width: 700px) { .tournament-hero { display: block; } .tournament-hero-art { height: 190px; } .tournament-hero-art img { position: static; } .tournament-hero-art::after { background: linear-gradient(0deg, #172944, transparent 60%); } .tournament-hero-content { padding: 22px; } .global-ban-intro { flex-direction: column; gap: 10px; } .global-ban-actions #global-ban-message { width: 100%; margin: 4px 0 0; } }
    @media (max-width: 576px) { .groups-grid { grid-template-columns: 1fr; } .tournament-page { padding-left: 12px; padding-right: 12px; } .tournament-page .global-ban-panel { padding: 18px; } .tournament-page .stage-switcher { width: 100%; flex-wrap: wrap; } .global-ban-modal { padding: 8px; } .global-ban-dialog { max-height: 94dvh; } .global-ban-dialog-head, .global-ban-dialog-tools, .global-ban-dialog-foot { padding: 13px; } .global-ban-dialog .global-ban-grid { padding: 4px 13px 13px; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); } }
</style>

<% 
function getCharData(id) {
    if (!id) return { img: '/cardback.png', name: 'Unknown' };
    for (let el in chars) {
        let c = chars[el].find(x => String(x.id) === String(id));
        if (c) return { img: c.img || '/cardback.png', name: c.name || id };
    }
    return { img: '/cardback.png', name: id };
}
%>

<div class="container tournament-page mt-4 mb-5">
    <header class="tournament-hero">
        <div class="tournament-hero-art">
            <img src="<%= tour.image ? (tour.image.startsWith('http') ? tour.image : '/uploads/' + tour.image) : '/logo.png' %>" alt="" onerror="this.src='/logo.png'">
        </div>
        <div class="tournament-hero-content">
            <div class="tournament-eyebrow"><span class="tournament-status-dot"></span><%= tour.isLive ? 'LIVE TOURNAMENT' : 'TOURNAMENT ARCHIVE' %></div>
            <h1 class="tour-main-title"><%= tour.title %></h1>
            <% if (tour.description) { %><p class="tournament-description"><%= tour.description %></p><% } %>
            <div class="tournament-facts">
                <div><span>DATE</span><strong><%= tour.date || 'TBA' %></strong></div>
                <div><span>PRIZE</span><strong><%= tour.prize || 'TBA' %></strong></div>
                <div><span>REGION</span><strong><%= tour.region || 'Any' %></strong></div>
                <div><span>FORMAT</span><strong><%= tour.format || 'TBA' %></strong></div>
            </div>
            <nav class="tournament-links" aria-label="Tournament links">
                <% if(tour.regLink) { %><a href="<%= tour.regLink %>" class="link-btn" target="_blank" rel="noopener noreferrer">Register ↗</a><% } %>
                <% if(tour.rulesLink) { %><a href="<%= tour.rulesLink %>" class="link-btn" target="_blank" rel="noopener noreferrer">Rules RU ↗</a><% } %>
                <% if(tour.rulesEnLink) { %><a href="<%= tour.rulesEnLink %>" class="link-btn" target="_blank" rel="noopener noreferrer">Rules EN ↗</a><% } %>
                <% if(tour.discordLink) { %><a href="<%= tour.discordLink %>" class="link-btn" target="_blank" rel="noopener noreferrer">Discord ↗</a><% } %>
                <% if(tour.telegramLink) { %><a href="<%= tour.telegramLink %>" class="link-btn" target="_blank" rel="noopener noreferrer">Telegram ↗</a><% } %>
                <% if(tour.bracketLink) { %><a href="<%= tour.bracketLink %>" class="link-btn" target="_blank" rel="noopener noreferrer">Bracket ↗</a><% } %>
            </nav>
        </div>
    </header>

    <% if (tour.globalBansEnabled) { %>
    <section class="global-ban-panel" aria-labelledby="global-ban-heading">
        <div class="global-ban-intro">
            <div><span class="tournament-section-kicker">TOURNAMENT RULE</span><h2 id="global-ban-heading">Global bans</h2>
                <p>Choose <%= tour.globalBanCount %> characters. Your bans join your opponent's bans in each Fast Cup NewGen draft.</p></div>
            <span class="global-ban-status"><%= tour.globalBansLocked ? 'Choices locked' : 'Choices open' %></span>
        </div>
        <% if (locals.user) { %>
            <div class="global-ban-slots" id="global-ban-slots">
                <% for (let i = 0; i < tour.globalBanCount; i++) { const chosen = getCharData(myGlobalBans?.characterIds[i]); %>
                    <div class="global-ban-slot">
                        <% if (myGlobalBans?.characterIds[i]) { %><img src="<%= chosen.img %>" alt="<%= chosen.name %>" title="<%= chosen.name %>"><% } else { %><span class="global-ban-slot-empty" aria-label="Empty ban slot">+</span><% } %>
                    </div>
                <% } %>
            </div>
            <div class="global-ban-actions">
                <% if (tour.isLive && !tour.globalBansLocked) { %><button type="button" class="link-btn global-ban-primary" onclick="openGlobalBanPicker()"><%= myGlobalBans ? 'Edit my bans' : 'Choose my bans' %></button><% } %>
                <% if (tour.isLive) { %><a class="link-btn" href="/create?mode=global_ban_sys&amp;tournament=<%= encodeURIComponent(tour.slug) %>">Create draft ↗</a><% } %>
                <span id="global-ban-message" role="status"><%= myGlobalBans ? 'Bans confirmed' : (tour.globalBansLocked ? 'No bans submitted' : 'Waiting for your choice') %></span>
            </div>
        <% } else { %><a href="/auth/discord" class="link-btn global-ban-primary">Sign in to choose bans</a><% } %>
    </section>
    <% if (tour.isLive && !tour.globalBansLocked && locals.user) { %>
    <div class="global-ban-modal" id="global-ban-picker" role="dialog" aria-modal="true" aria-labelledby="global-ban-picker-title" hidden>
        <div class="global-ban-dialog">
            <div class="global-ban-dialog-head"><div><span class="tournament-section-kicker">YOUR TOURNAMENT CHOICE</span><h2 id="global-ban-picker-title">Choose global bans</h2></div><button type="button" class="global-ban-close" onclick="closeGlobalBanPicker()" aria-label="Close">×</button></div>
            <div class="global-ban-dialog-tools"><span id="global-ban-count">0 / <%= tour.globalBanCount %> selected</span></div>
            <div class="global-ban-grid" id="global-ban-player-grid">
                <% Object.values(chars).flat().sort((a,b) => a.name.localeCompare(b.name)).forEach(c => { %>
                    <label class="global-ban-option" title="<%= c.name %>">
                        <input type="checkbox" value="<%= c.id %>" aria-label="<%= c.name %>" <%= myGlobalBans?.characterIds.includes(c.id) ? 'checked' : '' %> onchange="updateGlobalBanCount(this)">
                        <img src="<%= c.img || '/cardback.png' %>" alt="" loading="lazy">
                    </label>
                <% }) %>
            </div>
            <div class="global-ban-dialog-foot"><span id="global-ban-dialog-message" role="status">Choose <%= tour.globalBanCount %> different characters.</span><button type="button" class="link-btn global-ban-primary" onclick="saveGlobalBans()">Confirm bans</button></div>
        </div>
    </div>
    <% } %>
    <% } %>

    <% if (challongeEmbedUrl) { %>
    <section class="challonge-panel" aria-labelledby="challonge-heading">
        <div class="challonge-panel-head"><h2 id="challonge-heading">Bracket</h2><a class="link-btn" href="<%= tour.bracketLink %>" target="_blank" rel="noopener noreferrer">Open on Challonge ↗</a></div>
        <iframe src="<%= challongeEmbedUrl %>" title="<%= tour.title %> bracket on Challonge" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </section>
    <% } %>

    <!-- ПЕРЕКЛЮЧАТЕЛЬ ЭТАПОВ -->
    <% if (tour.groups && tour.groups.length > 0) { %>
        <div class="stage-switcher">
            <button class="stage-btn active" onclick="showPublicStage('1')" id="p-tab-1">Group Stage 1</button>
            <button class="stage-btn" onclick="showPublicStage('2')" id="p-tab-2">Group Stage 2</button>
            <button class="stage-btn" onclick="showPublicStage('3')" id="p-tab-3">Play-offs</button>
            <button class="stage-btn" onclick="showPublicStage('stats')" id="p-tab-stats">Statistics</button>
        </div>

        <!-- STAGE 1 -->
        <div id="p-stage-1" class="groups-grid active-grid">
            <% tour.groups.filter(g => g.stage === 1).forEach(group => { %>
                <a href="/tournament/<%= tour.slug %>/group/<%= group._id %>" class="public-group-card">
                    <div class="public-group-title"><%= group.name %></div>
                    <div class="players-list-wrapper">
                        <% group.players.forEach(p => { %>
                            <div class="public-group-player"><%= p.name || 'TBA' %></div>
                        <% }) %>
                    </div>
                </a>
            <% }) %>
        </div>

        <!-- STAGE 2 -->
        <div id="p-stage-2" class="groups-grid">
            <% tour.groups.filter(g => g.stage === 2).forEach(group => { %>
                <a href="/tournament/<%= tour.slug %>/group/<%= group._id %>" class="public-group-card">
                    <div class="public-group-title"><%= group.name %></div>
                    <div class="players-list-wrapper">
                        <% group.players.forEach(p => { %>
                            <div class="public-group-player"><%= p.name || 'TBA' %></div>
                        <% }) %>
                    </div>
                </a>
            <% }) %>
        </div>

        <!-- PLAY-OFFS (STAGE 3) -->
        <div id="p-stage-3" class="playoffs-grid">
            <% 
            const playoffGroup = tour.groups.find(g => g.stage === 3);
            const playoffPlayers = playoffGroup ? playoffGroup.players : [];
            %>
            <% if (playoffPlayers && playoffPlayers.length > 0) { %>
                <% playoffPlayers.forEach(p => { %>
                    <div class="playoff-player-card">
                        <div class="public-group-title" style="margin-bottom: 15px; font-size: 18px;"><%= p.name || 'Player' %></div>
                        <div class="playoff-decks-container">
                            <% for(let dIdx = 0; dIdx < 5; dIdx++) { 
                                let deck = p.decks && p.decks[dIdx] ? p.decks[dIdx] : [];
                            %>
                                <div class="playoff-deck-box">
                                    <% for(let cIdx = 0; cIdx < 3; cIdx++) { 
                                        let charId = deck[cIdx];
                                        let charData = getCharData(charId);
                                    %>
                                        <div class="playoff-char-wrap" title="<%= charData.name %>">
                                            <% if(charId) { %>
                                                <img src="<%= charData.img %>" onerror="this.src='/cardback.png'">
                                            <% } else { %>
                                                <img src="/cardback.png" style="opacity: 0.15;">
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="text-center col-12 py-5" style="color: #aee3ff; font-size: 16px; grid-column: 1 / -1;">No players added to Play-offs yet.</div>
            <% } %>
        </div>

        <!-- РАЗДЕЛ СТАТИСТИКИ -->
        <div id="p-stage-stats" class="stats-section">
            
            <!-- Главный переключатель статистики: DECKS vs CHARACTERS -->
            <div class="stage-switcher" style="margin-top: 0; margin-bottom: 15px;">
                <button class="stage-btn active" onclick="switchStatsType('decks')" id="st-btn-decks">Decks Stats</button>
                <button class="stage-btn" onclick="switchStatsType('chars')" id="st-btn-chars">Characters Stats</button>
            </div>

            <!-- Вкладка: ДЕКИ -->
            <div id="stats-type-decks" class="stats-type-content active-type">
                <div class="stage-switcher" style="margin-top: 0; margin-bottom: 20px;">
                    <button class="stage-btn active sub-switch-btn" onclick="switchDeckStage('1')" id="sd-tab-1">Stage 1</button>
                    <button class="stage-btn sub-switch-btn" onclick="switchDeckStage('2')" id="sd-tab-2">Stage 2</button>
                    <button class="stage-btn sub-switch-btn" onclick="switchDeckStage('3')" id="sd-tab-3">Play-offs</button>
                </div>

                <div class="stats-glass-panel">
                    <% [1, 2, 3].forEach(stageLevel => { %>
                        <div id="sd-content-<%= stageLevel %>" class="stats-stage-content <%= stageLevel === 1 ? 'active-stage' : '' %>">
                            <% if (deckStats && deckStats[stageLevel] && deckStats[stageLevel].length > 0) { %>
                                <table class="stats-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 50px; text-align: center;">#</th>
                                            <th style="text-align: center;">DECK COMPOSITION</th>
                                            <th style="width: 150px; text-align: center;">PLAYERS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% deckStats[stageLevel].forEach((stat, index) => { 
                                            let rankClass = index === 0 ? 'rank-1' : (index === 1 ? 'rank-2' : (index === 2 ? 'rank-3' : 'rank-default'));
                                        %>
                                            <tr>
                                                <td style="text-align: center;">
                                                    <div class="stats-rank <%= rankClass %>"><%= index + 1 %>.</div>
                                                </td>
                                                <td>
                                                    <div style="display: flex; gap: 10px; justify-content: center; align-items: center;">
                                                        <% stat.deck.forEach(charId => { 
                                                            let charData = getCharData(charId);
                                                        %>
                                                            <img src="<%= charData.img %>" class="stats-char-item" title="<%= charData.name %>" alt="Char">
                                                        <% }) %>
                                                    </div>
                                                </td>
                                                <td style="text-align: center;">
                                                    <div class="stats-count">
                                                        <%= stat.count %> <span class="stats-count-label"><%= stat.count === 1 ? 'Player' : 'Players' %></span>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            <% } else { %>
                                <div class="text-center py-4" style="color: #8fa0c9; font-size: 15px;">No deck data available for this stage.</div>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            </div>

            <!-- Вкладка: ПЕРСОНАЖИ -->
            <div id="stats-type-chars" class="stats-type-content">
                <div class="stage-switcher" style="margin-top: 0; margin-bottom: 20px;">
                    <button class="stage-btn active sub-switch-btn" onclick="switchCharStage('1')" id="sc-tab-1">Stage 1</button>
                    <button class="stage-btn sub-switch-btn" onclick="switchCharStage('2')" id="sc-tab-2">Stage 2</button>
                    <button class="stage-btn sub-switch-btn" onclick="switchCharStage('3')" id="sc-tab-3">Play-offs</button>
                </div>

                <div class="stats-glass-panel">
                    <% [1, 2, 3].forEach(stageLevel => { %>
                        <div id="sc-content-<%= stageLevel %>" class="stats-stage-content <%= stageLevel === 1 ? 'active-stage' : '' %>">
                            <% if (charStats && charStats[stageLevel] && charStats[stageLevel].length > 0) { %>
                                <table class="stats-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 50px; text-align: center;">#</th>
                                            <th style="text-align: center;">CHARACTER</th>
                                            <th style="width: 150px; text-align: center;">DECKS / PICKS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% charStats[stageLevel].forEach((stat, index) => { 
                                            let charData = getCharData(stat.charId);
                                            let rankClass = index === 0 ? 'rank-1' : (index === 1 ? 'rank-2' : (index === 2 ? 'rank-3' : 'rank-default'));
                                        %>
                                            <tr>
                                                <td style="text-align: center;">
                                                    <div class="stats-rank <%= rankClass %>"><%= index + 1 %>.</div>
                                                </td>
                                                <td style="padding: 10px 15px;">
                                                    <div style="display: grid; grid-template-columns: 54px 1fr; align-items: center; gap: 15px; max-width: 240px; margin: 0 auto;">
                                                        <img src="<%= charData.img %>" class="stats-char-single" alt="<%= charData.name %>">
                                                        <span style="font-size: 16px; font-weight: bold; color: #ffffff; text-align: left; text-shadow: 0 1px 3px rgba(0,0,0,0.8); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= charData.name %></span>
                                                    </div>
                                                </td>
                                                <td style="text-align: center;">
                                                    <div class="stats-count">
                                                        <%= stat.count %> <span class="stats-count-label"><%= stat.count === 1 ? 'Pick' : 'Picks' %></span>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            <% } else { %>
                                <div class="text-center py-4" style="color: #8fa0c9; font-size: 15px;">No character data available for this stage.</div>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            </div>

        </div>

        <script>
            function showPublicStage(stage) {
                document.getElementById('p-tab-1').classList.toggle('active', stage === '1');
                document.getElementById('p-tab-2').classList.toggle('active', stage === '2');
                document.getElementById('p-tab-3').classList.toggle('active', stage === '3');
                document.getElementById('p-tab-stats').classList.toggle('active', stage === 'stats');
                
                document.getElementById('p-stage-1').classList.toggle('active-grid', stage === '1');
                document.getElementById('p-stage-2').classList.toggle('active-grid', stage === '2');
                document.getElementById('p-stage-3').classList.toggle('active-grid', stage === '3');
                document.getElementById('p-stage-stats').style.display = (stage === 'stats') ? 'block' : 'none';
            }

            function switchStatsType(type) {
                document.getElementById('st-btn-decks').classList.toggle('active', type === 'decks');
                document.getElementById('st-btn-chars').classList.toggle('active', type === 'chars');

                document.getElementById('stats-type-decks').classList.toggle('active-type', type === 'decks');
                document.getElementById('stats-type-chars').classList.toggle('active-type', type === 'chars');
            }

            function switchDeckStage(stage) {
                [1, 2, 3].forEach(s => {
                    document.getElementById('sd-tab-' + s).classList.toggle('active', String(s) === String(stage));
                    document.getElementById('sd-content-' + s).classList.toggle('active-stage', String(s) === String(stage));
                });
            }

            function switchCharStage(stage) {
                [1, 2, 3].forEach(s => {
                    document.getElementById('sc-tab-' + s).classList.toggle('active', String(s) === String(stage));
                    document.getElementById('sc-content-' + s).classList.toggle('active-stage', String(s) === String(stage));
                });
            }

            // Автоматическое переключение на стадию из URL (?stage=2 и т.д.)
            (function() {
                const urlParams = new URLSearchParams(window.location.search);
                const stageParam = urlParams.get('stage');
                if (stageParam && ['1', '2', '3', 'stats'].includes(stageParam)) {
                    showPublicStage(stageParam);
                }
            })();
        </script>
    <% } %>

</div>

<% if (tour.globalBansEnabled && tour.isLive && !tour.globalBansLocked && locals.user) { %>
<script>
    const requiredGlobalBans = <%= tour.globalBanCount %>;
    let confirmedGlobalBans = [];
    function selectedGlobalBans() { return [...document.querySelectorAll('#global-ban-player-grid input:checked')].map(input => input.value); }
    function showGlobalBanSlots(ids) {
        const choices = new Map([...document.querySelectorAll('#global-ban-player-grid input')].map(input => [input.value, input.closest('label')]));
        const slots = document.getElementById('global-ban-slots');
        slots.replaceChildren();
        for (let index = 0; index < requiredGlobalBans; index++) {
            const slot = document.createElement('div'); slot.className = 'global-ban-slot';
            const choice = choices.get(ids[index]);
            if (choice) {
                const img = choice.querySelector('img').cloneNode();
                img.alt = choice.querySelector('input').getAttribute('aria-label');
                img.title = img.alt;
                slot.appendChild(img);
            } else {
                const empty = document.createElement('span'); empty.className = 'global-ban-slot-empty'; empty.textContent = '+'; empty.setAttribute('aria-label', 'Empty ban slot'); slot.appendChild(empty);
            }
            slots.appendChild(slot);
        }
    }
    function updateGlobalBanCount(input) {
        const selected = selectedGlobalBans();
        if (selected.length > requiredGlobalBans && input) { input.checked = false; return; }
        document.getElementById('global-ban-count').textContent = `${selected.length} / ${requiredGlobalBans} selected`;
        showGlobalBanSlots(selected);
    }
    function openGlobalBanPicker() {
        document.querySelectorAll('#global-ban-player-grid input').forEach(input => { input.checked = confirmedGlobalBans.includes(input.value); });
        updateGlobalBanCount();
        document.getElementById('global-ban-picker').hidden = false;
        document.querySelector('#global-ban-player-grid input').focus();
    }
    function closeGlobalBanPicker() {
        document.querySelectorAll('#global-ban-player-grid input').forEach(input => { input.checked = confirmedGlobalBans.includes(input.value); });
        updateGlobalBanCount();
        document.getElementById('global-ban-picker').hidden = true;
    }
    async function saveGlobalBans() {
        const characterIds = selectedGlobalBans();
        const message = document.getElementById('global-ban-dialog-message');
        if (characterIds.length !== requiredGlobalBans) { message.textContent = `Choose ${requiredGlobalBans} characters.`; return; }
        try {
            const response = await fetch(`${location.pathname}/global-bans`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ characterIds })
            });
            const result = await response.json();
            if (response.ok) {
                confirmedGlobalBans = [...characterIds];
                document.getElementById('global-ban-message').textContent = 'Bans confirmed';
                closeGlobalBanPicker();
            } else message.textContent = result.error;
        } catch { message.textContent = 'Could not save bans. Try again.'; }
    }
    confirmedGlobalBans = selectedGlobalBans();
    updateGlobalBanCount();
    document.getElementById('global-ban-picker').addEventListener('click', event => {
        if (event.target.id === 'global-ban-picker') closeGlobalBanPicker();
    });
    document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && !document.getElementById('global-ban-picker').hidden) closeGlobalBanPicker();
    });
</script>
<% } %>

<%- include('../partials/footer') %>
