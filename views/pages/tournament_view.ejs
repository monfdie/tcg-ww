<!-- ДОБАВИТЬ ЭТОТ БЛОК В views/pages/tournament_view.ejs (например, под описанием турнира) -->

<style>
    .stage-switcher { display: flex; gap: 15px; margin: 30px 0 20px 0; justify-content: center; }
    .stage-btn { background: #1b1e2b; border: 1px solid #3c445c; color: #8fa0c9; padding: 10px 20px; border-radius: 4px; font-weight: bold; cursor: pointer; transition: 0.2s; min-width: 150px; }
    .stage-btn.active { background: #00d2ff; color: #000; border-color: #00d2ff; }
    .stage-btn:hover:not(.active) { background: #2a2e40; color: white; }
    
    /* Сетка ровно на 4 группы в ряд */
    .groups-grid { display: none; grid-template-columns: repeat(4, 1fr); gap: 20px; }
    .groups-grid.active-grid { display: grid; }
    
    .public-group-card { background: #1b1e2b; border: 1px solid #3c445c; border-radius: 6px; padding: 20px; text-align: center; cursor: pointer; transition: 0.2s; text-decoration: none; color: white; display: block; }
    .public-group-card:hover { border-color: #00d2ff; transform: translateY(-3px); box-shadow: 0 4px 12px rgba(0, 210, 255, 0.1); color: white; text-decoration: none; }
    .public-group-title { font-weight: bold; margin-bottom: 15px; font-size: 18px; color: #00d2ff; }
    .public-group-player { font-size: 14px; margin-bottom: 5px; color: #c4d0eb; }
    
    /* Адаптивность для телефонов */
    @media (max-width: 992px) { .groups-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 576px) { .groups-grid { grid-template-columns: 1fr; } }
</style>

<% if (tour.groups && tour.groups.length > 0) { %>
    <div class="stage-switcher">
        <button class="stage-btn active" onclick="showPublicStage(1)" id="p-tab-1">Group Stage 1</button>
        <button class="stage-btn" onclick="showPublicStage(2)" id="p-tab-2">Group Stage 2</button>
        <button class="stage-btn" onclick="alert('Play-offs coming soon!')">Play-offs</button>
    </div>

    <div id="p-stage-1" class="groups-grid active-grid">
        <% tour.groups.filter(g => g.stage === 1).forEach(group => { %>
            <a href="/tournament/<%= tour.slug %>/group/<%= group._id %>" class="public-group-card">
                <div class="public-group-title"><%= group.name %></div>
                <% group.players.forEach(p => { %>
                    <div class="public-group-player"><%= p.name || 'TBA' %></div>
                <% }) %>
            </a>
        <% }) %>
    </div>

    <div id="p-stage-2" class="groups-grid">
        <% tour.groups.filter(g => g.stage === 2).forEach(group => { %>
            <a href="/tournament/<%= tour.slug %>/group/<%= group._id %>" class="public-group-card">
                <div class="public-group-title"><%= group.name %></div>
                <% group.players.forEach(p => { %>
                    <div class="public-group-player"><%= p.name || 'TBA' %></div>
                <% }) %>
            </a>
        <% }) %>
    </div>

    <script>
        function showPublicStage(stage) {
            document.getElementById('p-tab-1').classList.toggle('active', stage === 1);
            document.getElementById('p-tab-2').classList.toggle('active', stage === 2);
            document.getElementById('p-stage-1').classList.toggle('active-grid', stage === 1);
            document.getElementById('p-stage-2').classList.toggle('active-grid', stage === 2);
        }
    </script>
<% } %>
